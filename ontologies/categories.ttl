# imports: https://cyberterrain.org/ns/stonework#

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/stonework/categories#>
	a owl:Ontology ;
	rdfs:label "STONEWORK Categories and Roles"@en ;
	dcterms:description "Category and Role subclasses, associated vocabulary named individuals, and category-specific object properties for the STONEWORK ontology. Kept separate to allow the core ontology to load without the full vocabulary set."@en ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/stonework/categories/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

stonework:AccountType
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of a user account by its authentication or deployment context."@en ;
	skos:prefLabel "Account Type"@en ;
	.

stonework:FalsePositiveRate
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "An ordinal classification of the expected false-positive frequency of a detection rule."@en ;
	skos:prefLabel "False Positive Rate"@en ;
	.

stonework:HypothesisStatus
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of a Hypothesis's position in the confirm/refute lifecycle." ;
	skos:prefLabel "Hypothesis Status" ;
	skos:scopeNote "Applied via stonework:hasHypothesisStatus to Hypothesis individuals. Named individuals: pending (not yet tested), confirmed (actual result matched the prediction), refuted (actual result did not match the prediction)."@en ;
	.

stonework:ImpactLevel
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "An ordinal classification of the magnitude of a security impact."@en ;
	skos:prefLabel "Impact Level"@en ;
	.

stonework:ImpactType
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of the security dimension or consequence affected by an impact."@en ;
	skos:prefLabel "Impact Type"@en ;
	.

stonework:IncidentStatus
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of an incident's position in the response lifecycle."@en ;
	skos:prefLabel "Incident Status"@en ;
	.

stonework:Industry
	a owl:Class ;
	rdfs:subClassOf stonework:Sector ;
	skos:definition "A specific branch of economic activity or commercial sector (typically modeled using NAICS or similar codes)."@en ;
	skos:prefLabel "Industry" ;
	skos:scopeNote "Examples: Financial Services, Manufacturing, Retail, Pharmaceuticals."@en ;
	.

stonework:InfrastructureType
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of infrastructure by its operational role or purpose within a cyber operation." ;
	skos:prefLabel "Infrastructure Type" ;
	skos:scopeNote "Applied via stonework:categorizedBy to Infrastructure individuals. Covers both adversary-controlled infrastructure (C2, staging, phishing) and defender infrastructure (firewall, workstation). Aligns with the STIX 2.1 infrastructure-type open vocabulary."@en ;
	.

stonework:KillChainPhase
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A named phase within a kill chain or attack lifecycle framework used to categorize the stage of an offensive or defensive operation."@en ;
	skos:prefLabel "Kill Chain Phase" ;
	skos:scopeNote "Applies to both offensive frameworks (Lockheed Martin Cyber Kill Chain, MITRE ATT&CK) and defensive lifecycle models. Used to tag AttackTechniques, Procedures, or Events with their operational phase."@en ;
	.

stonework:LikelihoodLevel
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "An ordinal classification of the assessed likelihood that a security outcome will occur."@en ;
	skos:prefLabel "Likelihood Level"@en ;
	.

stonework:Markings
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "Defines a data handling marking used to restrict or label how data can be shared or handled, such as TLP markings. Referenced by object_marking_refs or granular_markings."@en ;
	skos:prefLabel "Markings"@en ;
	.

stonework:Motivation
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "The reason or driving force behind an adversary's decision to conduct an attack or operation." ;
	skos:prefLabel "Motivation" ;
	skos:scopeNote "Applied via stonework:categorizedBy to ThreatActor, Campaign, or Operation individuals. Named individuals cover the STIX 2.1 attack-motivation open vocabulary. Custom motivations may be added as additional individuals."@en ;
	.

stonework:ProductType
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of a product by its primary functional category within a system or architecture." ;
	skos:prefLabel "Product Type" ;
	skos:scopeNote "Applied via stonework:hasProductType to Product individuals. Aligns with CPE component type designations. A product may have more than one type (e.g. an embedded OS is both firmware and operating-system)."@en ;
	.

stonework:ResourceLevel
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of the organizational resources available to a threat actor."@en ;
	skos:prefLabel "Resource Level"@en ;
	.

stonework:RiskLevel
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "An ordinal classification of the assessed magnitude of a security risk."@en ;
	skos:prefLabel "Risk Level"@en ;
	.

stonework:Sector
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A broad division or category of economic activity, infrastructure, or society used for classification and targeting purposes."@en ;
	skos:prefLabel "Sector"@en ;
	skos:scopeNote "Can represent both commercial industries and critical infrastructure sectors (e.g., from CISA or NIST frameworks)."@en ;
	.

stonework:SophisticationLevel
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of a threat actor's assessed technical sophistication."@en ;
	skos:prefLabel "Sophistication Level"@en ;
	.

stonework:ThreatActorRole
	a owl:Class ;
	rdfs:subClassOf stonework:Role ;
	skos:definition "The function or part played by a threat actor within a specific operation, campaign, or criminal organization." ;
	skos:prefLabel "Threat Actor Role" ;
	skos:scopeNote "A threat actor may play different roles across operations — a nation-state actor may be a sponsor in one campaign and a director in another. Applied via stonework:playsRole. Aligns with the STIX 2.1 threat-actor-role open vocabulary."@en ;
	.

stonework:ThreatActorType
	a owl:Class ;
	rdfs:subClassOf stonework:Category ;
	skos:definition "A classification of a threat actor by their organizational form, affiliation, or primary mode of operation." ;
	skos:prefLabel "Threat Actor Type" ;
	skos:scopeNote "Applied via stonework:categorizedBy to ThreatActor individuals. A threat actor may have multiple types. Aligns with the STIX 2.1 threat-actor-type open vocabulary."@en ;
	.

stonework:accountTypeCloud
	a
		owl:NamedIndividual ,
		stonework:AccountType
		;
	skos:definition "An account managed by a cloud service or identity provider."@en ;
	skos:notation "cloud" ;
	skos:prefLabel "Cloud"@en ;
	.

stonework:accountTypeDomain
	a
		owl:NamedIndividual ,
		stonework:AccountType
		;
	skos:definition "An account managed within an enterprise identity domain."@en ;
	skos:notation "domain" ;
	skos:prefLabel "Domain"@en ;
	.

stonework:accountTypeLocal
	a
		owl:NamedIndividual ,
		stonework:AccountType
		;
	skos:definition "An account managed locally by a host or application."@en ;
	skos:notation "local" ;
	skos:prefLabel "Local"@en ;
	.

stonework:accountTypeService
	a
		owl:NamedIndividual ,
		stonework:AccountType
		;
	skos:definition "A non-human account used by a service, workload, or automated process."@en ;
	skos:notation "service" ;
	skos:prefLabel "Service"@en ;
	.

stonework:evidence
	a
		owl:NamedIndividual ,
		stonework:Category
		;
	skos:definition "Material or information offered to support or refute a claim, typically within an investigation or legal context."@en ;
	skos:prefLabel "Evidence" ;
	skos:scopeNote "This is a reusable category instance. It is *not* a class. Use stonework:categorizedBy to assert that something is evidence in a given context."@en ;
	.

stonework:falsePositiveRateHigh
	a
		owl:NamedIndividual ,
		stonework:FalsePositiveRate
		;
	skos:definition "The rule is expected to generate false positives frequently."@en ;
	skos:notation "high" ;
	skos:prefLabel "High"@en ;
	.

stonework:falsePositiveRateLow
	a
		owl:NamedIndividual ,
		stonework:FalsePositiveRate
		;
	skos:definition "The rule is expected to generate false positives infrequently."@en ;
	skos:notation "low" ;
	skos:prefLabel "Low"@en ;
	.

stonework:falsePositiveRateMedium
	a
		owl:NamedIndividual ,
		stonework:FalsePositiveRate
		;
	skos:definition "The rule is expected to generate false positives at a moderate frequency."@en ;
	skos:notation "medium" ;
	skos:prefLabel "Medium"@en ;
	.

stonework:hasAccountType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:UserAccount ;
	rdfs:range stonework:AccountType ;
	skos:definition "Relates a user account to one or more classifications describing its authentication or deployment context."@en ;
	skos:prefLabel "hasAccountType"@en ;
	.

stonework:hasFalsePositiveRate
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:DetectionRule ;
	rdfs:range stonework:FalsePositiveRate ;
	skos:definition "Relates a detection rule to an ordinal assessment of its expected false-positive frequency."@en ;
	skos:prefLabel "hasFalsePositiveRate"@en ;
	.

stonework:hasHypothesisStatus
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Hypothesis ;
	rdfs:range stonework:HypothesisStatus ;
	skos:definition "Relates a Hypothesis to its current status in the confirm/refute lifecycle."@en ;
	skos:prefLabel "hasHypothesisStatus"@en ;
	skos:scopeNote "Kept explicit (rather than inferred from which Transition fired) so a Hypothesis's status is directly queryable without replaying the Step graph it was tested in."@en ;
	.

stonework:hasImpactLevel
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Impact ;
	rdfs:range stonework:ImpactLevel ;
	skos:definition "Relates an impact assessment to its qualitative magnitude."@en ;
	skos:prefLabel "hasImpactLevel"@en ;
	.

stonework:hasImpactType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Impact ;
	rdfs:range stonework:ImpactType ;
	skos:definition "Relates an impact assessment to one or more affected security dimensions or consequence types."@en ;
	skos:prefLabel "hasImpactType"@en ;
	.

stonework:hasIncidentStatus
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Incident ;
	rdfs:range stonework:IncidentStatus ;
	skos:definition "Relates an incident to its current response-lifecycle status."@en ;
	skos:prefLabel "hasIncidentStatus"@en ;
	.

stonework:hasInfrastructureType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:InfrastructureType ;
	skos:definition "Relates an infrastructure individual to one or more classifications describing its operational role or purpose."@en ;
	skos:prefLabel "hasInfrastructureType"@en ;
	skos:scopeNote "A piece of infrastructure may serve multiple roles (e.g. both C2 and staging). Aligns with the STIX 2.1 infrastructure-type open vocabulary."@en ;
	.

stonework:hasLikelihoodLevel
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Likelihood ;
	rdfs:range stonework:LikelihoodLevel ;
	skos:definition "Relates a likelihood assessment to its qualitative ordinal level."@en ;
	skos:prefLabel "hasLikelihoodLevel"@en ;
	.

stonework:hasMalwareType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:MalwareFamily
			stonework:MalwareSample
		) ;
	] ;
	rdfs:range stonework:MalwareType ;
	skos:definition "Relates a malware sample or family to one or more functional type classifications."@en ;
	skos:prefLabel "hasMalwareType"@en ;
	skos:scopeNote "A malware sample may have multiple types (e.g. a trojan that also acts as a downloader). Aligns with the STIX 2.1 malware-type open vocabulary."@en ;
	.

stonework:hasMotivation
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:ThreatActor ;
	rdfs:range stonework:Motivation ;
	skos:definition "Relates a threat actor to one or more motivations that drive their actions and operations."@en ;
	skos:prefLabel "hasMotivation"@en ;
	skos:scopeNote "A threat actor may have multiple motivations. Corresponds to the STIX 2.1 primary_motivation and secondary_motivations properties on ThreatActor."@en ;
	.

stonework:hasProductType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Product ;
	rdfs:range stonework:ProductType ;
	skos:definition "Relates a product family to one or more product type classifications describing its functional category."@en ;
	skos:prefLabel "hasProductType"@en ;
	skos:scopeNote "A product may have multiple types. Corresponds to the CPE component type field (a, o, h) but extends it with finer-grained vocabulary."@en ;
	.

stonework:hasResourceLevel
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:ThreatActor ;
	rdfs:range stonework:ResourceLevel ;
	skos:definition "Relates a threat actor to an assessment of the organizational resources available to it."@en ;
	skos:prefLabel "hasResourceLevel"@en ;
	.

stonework:hasRiskLevel
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:Risk ;
	rdfs:range stonework:RiskLevel ;
	skos:definition "Relates a risk assessment to its qualitative ordinal level."@en ;
	skos:prefLabel "hasRiskLevel"@en ;
	.

stonework:hasSophisticationLevel
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:ThreatActor ;
	rdfs:range stonework:SophisticationLevel ;
	skos:definition "Relates a threat actor to an assessment of its technical sophistication."@en ;
	skos:prefLabel "hasSophisticationLevel"@en ;
	.

stonework:hasThreatActorType
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:categorizedBy ;
	rdfs:domain stonework:ThreatActor ;
	rdfs:range stonework:ThreatActorType ;
	skos:definition "Relates a threat actor to one or more classifications describing their organizational form or primary mode of operation."@en ;
	skos:prefLabel "hasThreatActorType"@en ;
	skos:scopeNote "A threat actor may have multiple types (e.g. nation-state actor who is also a spy). Aligns with the STIX 2.1 threat-actor-type open vocabulary."@en ;
	.

stonework:hypothesisStatusConfirmed
	a
		owl:NamedIndividual ,
		stonework:HypothesisStatus
		;
	skos:definition "The Hypothesis's predicted value matched the actual value the predicted Variable was bound to."@en ;
	skos:prefLabel "Confirmed"@en ;
	.

stonework:hypothesisStatusPending
	a
		owl:NamedIndividual ,
		stonework:HypothesisStatus
		;
	skos:definition "The Hypothesis has not yet been tested against an actual result."@en ;
	skos:prefLabel "Pending"@en ;
	.

stonework:hypothesisStatusRefuted
	a
		owl:NamedIndividual ,
		stonework:HypothesisStatus
		;
	skos:definition "The Hypothesis's predicted value did not match the actual value the predicted Variable was bound to."@en ;
	skos:prefLabel "Refuted"@en ;
	.

stonework:impactLevelCatastrophic
	a
		owl:NamedIndividual ,
		stonework:ImpactLevel
		;
	skos:definition "An impact causing extraordinary or potentially irreversible harm."@en ;
	skos:notation "catastrophic" ;
	skos:prefLabel "Catastrophic"@en ;
	.

stonework:impactLevelLimited
	a
		owl:NamedIndividual ,
		stonework:ImpactLevel
		;
	skos:definition "An impact causing localized or readily recoverable harm."@en ;
	skos:notation "limited" ;
	skos:prefLabel "Limited"@en ;
	.

stonework:impactLevelModerate
	a
		owl:NamedIndividual ,
		stonework:ImpactLevel
		;
	skos:definition "An impact causing material but manageable harm."@en ;
	skos:notation "moderate" ;
	skos:prefLabel "Moderate"@en ;
	.

stonework:impactLevelSevere
	a
		owl:NamedIndividual ,
		stonework:ImpactLevel
		;
	skos:definition "An impact causing major operational, financial, or safety harm."@en ;
	skos:notation "severe" ;
	skos:prefLabel "Severe"@en ;
	.

stonework:impactTypeAvailability
	a
		owl:NamedIndividual ,
		stonework:ImpactType
		;
	skos:definition "Impact affecting timely and reliable access to systems or information."@en ;
	skos:notation "availability" ;
	skos:prefLabel "Availability"@en ;
	.

stonework:impactTypeConfidentiality
	a
		owl:NamedIndividual ,
		stonework:ImpactType
		;
	skos:definition "Impact involving unauthorized disclosure of information."@en ;
	skos:notation "confidentiality" ;
	skos:prefLabel "Confidentiality"@en ;
	.

stonework:impactTypeFinancial
	a
		owl:NamedIndividual ,
		stonework:ImpactType
		;
	skos:definition "Impact involving direct or indirect monetary loss."@en ;
	skos:notation "financial" ;
	skos:prefLabel "Financial"@en ;
	.

stonework:impactTypeIntegrity
	a
		owl:NamedIndividual ,
		stonework:ImpactType
		;
	skos:definition "Impact involving unauthorized alteration or loss of trustworthiness."@en ;
	skos:notation "integrity" ;
	skos:prefLabel "Integrity"@en ;
	.

stonework:impactTypeReputational
	a
		owl:NamedIndividual ,
		stonework:ImpactType
		;
	skos:definition "Impact involving loss of stakeholder trust or public standing."@en ;
	skos:notation "reputational" ;
	skos:prefLabel "Reputational"@en ;
	.

stonework:impactTypeSafety
	a
		owl:NamedIndividual ,
		stonework:ImpactType
		;
	skos:definition "Impact involving potential harm to people or physical well-being."@en ;
	skos:notation "safety" ;
	skos:prefLabel "Safety"@en ;
	.

stonework:incidentStatusClosed
	a
		owl:NamedIndividual ,
		stonework:IncidentStatus
		;
	skos:definition "Response work is complete and the incident has been formally closed."@en ;
	skos:notation "closed" ;
	skos:prefLabel "Closed"@en ;
	.

stonework:incidentStatusContained
	a
		owl:NamedIndividual ,
		stonework:IncidentStatus
		;
	skos:definition "The incident's spread or immediate harmful activity has been stopped."@en ;
	skos:notation "contained" ;
	skos:prefLabel "Contained"@en ;
	.

stonework:incidentStatusInProgress
	a
		owl:NamedIndividual ,
		stonework:IncidentStatus
		;
	skos:definition "The incident is under active investigation or response."@en ;
	skos:notation "in-progress" ;
	skos:prefLabel "In Progress"@en ;
	.

stonework:incidentStatusOpen
	a
		owl:NamedIndividual ,
		stonework:IncidentStatus
		;
	skos:definition "The incident has been declared and remains unresolved."@en ;
	skos:notation "open" ;
	skos:prefLabel "Open"@en ;
	.

stonework:indicator
	a
		owl:NamedIndividual ,
		stonework:Category
		;
	skos:definition "An assertion that a specific pattern or set of Digital Artifacts is associated with malicious behavior, enabling detection, correlation, and response."@en ;
	skos:prefLabel "Indicator" ;
	skos:scopeNote "In STONEWORK, Indicators can be simple (single IOC like a hash or IP) or complex (full STIX patterns combining multiple artifacts and conditions)."@en ;
	.

stonework:infraTypeAmplification
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to amplify attack traffic, such as DNS or NTP amplification servers."@en ;
	skos:prefLabel "Amplification"@en ;
	.

stonework:infraTypeAnonymization
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to obscure the origin of operations, such as VPNs, proxies, or Tor nodes."@en ;
	skos:prefLabel "Anonymization"@en ;
	.

stonework:infraTypeBotnet
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "A network of compromised systems under adversary control, used to execute distributed attacks or other operations."@en ;
	skos:prefLabel "Botnet"@en ;
	.

stonework:infraTypeC2
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to communicate with and issue commands to compromised systems."@en ;
	skos:prefLabel "Command and Control"@en ;
	.

stonework:infraTypeExfiltration
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used as a destination or relay for stolen data."@en ;
	skos:prefLabel "Exfiltration"@en ;
	.

stonework:infraTypeFirewall
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Defensive infrastructure that filters and monitors network traffic."@en ;
	skos:prefLabel "Firewall"@en ;
	.

stonework:infraTypeHostingMalware
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to host or distribute malicious payloads."@en ;
	skos:prefLabel "Hosting Malware"@en ;
	.

stonework:infraTypeHostingTargetLists
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to store or distribute lists of targets for operations."@en ;
	skos:prefLabel "Hosting Target Lists"@en ;
	.

stonework:infraTypePhishing
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to conduct phishing campaigns, including fake login pages or malicious email servers."@en ;
	skos:prefLabel "Phishing"@en ;
	.

stonework:infraTypeReconnaissance
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used to gather information about targets prior to an operation."@en ;
	skos:prefLabel "Reconnaissance"@en ;
	.

stonework:infraTypeRoutersSwitches
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Network routing and switching equipment, often targeted or co-opted by adversaries."@en ;
	skos:prefLabel "Routers and Switches"@en ;
	.

stonework:infraTypeStaging
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "Infrastructure used as an intermediate point for storing tools, payloads, or exfiltrated data during an operation."@en ;
	skos:prefLabel "Staging"@en ;
	.

stonework:infraTypeWorkstation
	a
		owl:NamedIndividual ,
		stonework:InfrastructureType
		;
	skos:definition "An end-user computing device, typically a target or pivot point in an operation."@en ;
	skos:prefLabel "Workstation"@en ;
	.

stonework:likelihoodLevelAlmostCertain
	a
		owl:NamedIndividual ,
		stonework:LikelihoodLevel
		;
	skos:definition "The outcome is assessed as expected to occur in nearly all relevant circumstances."@en ;
	skos:notation "almost-certain" ;
	skos:prefLabel "Almost Certain"@en ;
	.

stonework:likelihoodLevelLikely
	a
		owl:NamedIndividual ,
		stonework:LikelihoodLevel
		;
	skos:definition "The outcome is assessed as more likely than not to occur."@en ;
	skos:notation "likely" ;
	skos:prefLabel "Likely"@en ;
	.

stonework:likelihoodLevelPossible
	a
		owl:NamedIndividual ,
		stonework:LikelihoodLevel
		;
	skos:definition "The outcome is assessed as plausible but not more likely than not."@en ;
	skos:notation "possible" ;
	skos:prefLabel "Possible"@en ;
	.

stonework:likelihoodLevelRare
	a
		owl:NamedIndividual ,
		stonework:LikelihoodLevel
		;
	skos:definition "The outcome is assessed as exceptional or highly unlikely."@en ;
	skos:notation "rare" ;
	skos:prefLabel "Rare"@en ;
