<https://cyberterrain.org/ns/stonework/profiles/full>
	a owl:Ontology ;
	rdfs:label "STONEWORK Full Bundled Profile"@en ;
	dcterms:description "Import-only profile loading the STONEWORK core, controlled vocabularies, and every framework mapping bundled with this repository. External source datasets such as ATT&CK and D3FEND data remain separately loadable peer graphs."@en ;
