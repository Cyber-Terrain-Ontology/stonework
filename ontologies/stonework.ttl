stonework:certSerialNumber
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Certificate ;
	rdfs:range xsd:string ;
	skos:definition "The unique serial number assigned to the certificate by the issuing CA."@en ;
	skos:prefLabel "certSerialNumber"@en ;
	.

stonework:certSubjectDN
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Certificate ;
	rdfs:range xsd:string ;
	skos:definition "The Distinguished Name of the certificate subject."@en ;
	skos:prefLabel "certSubjectDN"@en ;
	.

stonework:certValidNotAfter
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Certificate ;
	rdfs:range xsd:dateTime ;
	skos:definition "The end of the certificate's validity period."@en ;
	skos:prefLabel "certValidNotAfter"@en ;
	.

stonework:certValidNotBefore
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Certificate ;
	rdfs:range xsd:dateTime ;
	skos:definition "The start of the certificate's validity period."@en ;
	skos:prefLabel "certValidNotBefore"@en ;
	.

stonework:cidrNotation
	a owl:DatatypeProperty ;
	rdfs:domain stonework:IPBlock ;
	rdfs:range xsd:string ;
	skos:definition "The CIDR notation representing the IP address block (e.g. 192.168.0.0/16)."@en ;
	skos:prefLabel "cidrNotation"@en ;
	.

stonework:circumvents
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:AITechnique
			stonework:AttackPattern
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:AnalyticTechnique
			stonework:DefendTechnique
		) ;
	] ;
	skos:definition "Relates an AITechnique or AttackPattern to an AnalyticTechnique or DefendTechnique that it bypasses or evades."@en ;
	skos:prefLabel "circumvents" ;
	.

stonework:clusteredWith
	a owl:ObjectProperty ;
	skos:definition "Indicates two entities have been analytically grouped together based on shared characteristics or behaviour, without implying a stronger semantic relationship."@en ;
	skos:prefLabel "clusteredWith" ;
	.

stonework:collects
	a owl:ObjectProperty ;
	rdfs:domain stonework:Investigation ;
	rdfs:range stonework:DigitalArtifact ;
	skos:definition "Relates an Investigation to the digital artifacts it collects as evidence."@en ;
	skos:prefLabel "collects"@en ;
	.

stonework:commandLine
	a owl:DatatypeProperty ;
	rdfs:domain stonework:RuntimeProcess ;
	rdfs:range xsd:string ;
	skos:definition "The full command line string used to launch the process."@en ;
	skos:prefLabel "commandLine"@en ;
	.

stonework:communicatesWith
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:MalwareSample
			stonework:Tool
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Infrastructure
			stonework:URI
		) ;
