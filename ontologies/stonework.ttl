	rdfs:domain stonework:IntelligenceProduct ;
	rdfs:range xsd:string ;
	skos:definition "A brief summary of the intelligence product's key findings."@en ;
	skos:prefLabel "summary"@en ;
	.

stonework:supersededBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range stonework:Vulnerability ;
	skos:definition "Relates a vulnerability to the vulnerability record that supersedes it, e.g. when a CVE is split, merged, or formally replaced by another identifier."@en ;
	skos:prefLabel "supersededBy"@en ;
	skos:scopeNote "Corresponds to cve:replacedBy in CVE JSON 5.x, but as an object property linking to a stonework:Vulnerability individual rather than a string. The source-specific string form is preserved on cve:replacedBy."@en ;
	.

stonework:supersedes
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "Relates a product version to an older version it replaces. Transitive to support full product lifecycle reasoning."@en ;
	skos:prefLabel "supersedes"@en ;
	.

stonework:targets
	a owl:ObjectProperty ;
	skos:definition "Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type 'targets'." ;
	skos:prefLabel "targets" ;
	skos:scopeNote "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'targets' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en ;
	.

stonework:targetsPlatform
	a owl:ObjectProperty ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "A MalwareSample or Tool is engineered to run on or exploit this VersionedProduct (OS, application, firmware version). Supports exposure and blast-radius queries."@en ;
	skos:prefLabel "targetsPlatform"@en ;
	.

stonework:targetsService
	a owl:ObjectProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range stonework:NetworkService ;
	skos:definition "The NetworkService this traffic addresses."@en ;
	skos:prefLabel "targetsService"@en ;
	skos:scopeNote "⚑ Category: service *type* (HTTP, SSH, RDP, SMB, DNS) is better expressed as stonework:categorizedBy → Category named individual than as subclasses of NetworkService. NetworkService as a class is appropriate only when the instance has its own properties (port, vulnerability linkage)." ;
	.

stonework:techniqueOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Technique ;
	rdfs:isDefinedBy <https://cyberterrain.org/ns/stonework#> ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Tactic
			stonework:Technique
		) ;
	] ;
	owl:inverseOf stonework:hasTechnique ;
	skos:definition "Relates a Technique to a Tactic it supports or to a broader Technique of which it is a specialization."@en ;
	skos:prefLabel "techniqueOf"@en ;
	skos:scopeNote "This is the inverse of hasTechnique. A Technique may support multiple Tactics, and a sub-technique may identify its broader parent Technique through the same hierarchy."@en ;
	.

stonework:timestamp
	a owl:DatatypeProperty ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time at which this observation or event occurred."@en ;
	skos:prefLabel "timestamp"@en ;
	skos:scopeNote "Domain is intentionally unset for point-in-time records. Use stonework:firstSeen and stonework:lastSeen for observation windows, and stonework:startedAtTime and stonework:endedAtTime for CyberActivity execution intervals."@en ;
	.

stonework:title
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf dcterms:title ;
	rdfs:range rdfs:Literal ;
	skos:definition "A human-readable title for the described resource."@en ;
	skos:prefLabel "title"@en ;
	skos:scopeNote "Domain is intentionally unset so framework-specific titles for controls, products, publications, and intelligence products can share this canonical property. Prefer dcterms:title in newly authored data."@en ;
	.

stonework:toStep
	a owl:ObjectProperty ;
	rdfs:domain stonework:Transition ;
	rdfs:range stonework:Step ;
	skos:definition "The Step a Transition enters."@en ;
	skos:prefLabel "toStep" ;
	skos:scopeNote "A Transition whose toStep was already reached earlier in the same Behavior's Step graph expresses a loop back-edge; a self-loop (toStep equal to fromStep) is the degenerate case."@en ;
	.

stonework:transactionAmount
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range xsd:decimal ;
	skos:definition "Convenience projection of the magnitude of a single-denomination transaction's stonework:MonetaryAmount, paired with stonework:transactionCurrency."@en ;
	skos:prefLabel "transactionAmount"@en ;
	skos:scopeNote "Do not use for a currency exchange with distinct input and output amounts; use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue instead."@en ;
	.

stonework:transactionCurrency
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:Currency ;
	skos:definition "Convenience projection of the currency of a single-denomination transaction's stonework:MonetaryAmount, for consumers that need one value without traversing stonework:hasMonetaryValue."@en ;
	skos:prefLabel "transactionCurrency"@en ;
	skos:scopeNote "Do not use for a currency exchange with distinct input and output currencies; traverse stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue to their stonework:currency values instead."@en ;
	.

stonework:transactionReference
	a owl:DatatypeProperty ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range xsd:string ;
	skos:definition "A reference string carried by this transaction — a wire reference or end-to-end identifier, a payment memo, or an on-chain transaction hash."@en ;
	skos:prefLabel "transactionReference"@en ;
	.

stonework:transfersFile
	a owl:ObjectProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range stonework:File ;
	skos:definition "A File carried as payload in this NetworkTraffic flow. Covers both delivery (malware download) and exfiltration scenarios."@en ;
	skos:prefLabel "transfersFile"@en ;
	.

stonework:triggeredBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Playbook ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Event
			stonework:Incident
		) ;
	] ;
	owl:inverseOf stonework:triggersPlaybook ;
	skos:definition "Relates a Playbook to the Event or Incident that initiates its execution."@en ;
	skos:prefLabel "triggeredBy"@en ;
	.

stonework:triggersPlaybook
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Event
			stonework:Incident
		) ;
	] ;
	rdfs:range stonework:Playbook ;
	owl:inverseOf stonework:triggeredBy ;
	skos:definition "Relates an Event or Incident to a Playbook invoked in response."@en ;
	skos:prefLabel "triggersPlaybook"@en ;
	.

stonework:updateFrequency
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Feed ;
	rdfs:range xsd:string ;
	skos:definition "How often the feed is updated (e.g. hourly, daily, real-time)."@en ;
	skos:prefLabel "updateFrequency"@en ;
	.

stonework:uriValue
	a owl:DatatypeProperty ;
	rdfs:domain stonework:URI ;
	rdfs:range xsd:anyURI ;
	skos:definition "The full URI string conforming to RFC 3986."@en ;
	skos:prefLabel "uriValue"@en ;
	.

stonework:url
	a owl:DatatypeProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Feed
			stonework:OnlineReference
			stonework:Publication
		) ;
	] ;
	rdfs:range xsd:anyURI ;
	skos:definition "The URL of the online resource."@en ;
	skos:prefLabel "url"@en ;
	.

stonework:urlOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:URI ;
	skos:definition "The entity this URI serves as a locator or persistent identifier for."@en ;
	skos:prefLabel "urlOf" ;
	.

stonework:userAgentString
	a owl:DatatypeProperty ;
	rdfs:domain stonework:UserAgent ;
	rdfs:range xsd:string ;
	skos:definition "The raw HTTP User-Agent header string."@en ;
	skos:prefLabel "userAgentString"@en ;
	.

stonework:uses
	a owl:ObjectProperty ;
	skos:definition "Relates a threat actor group, campaign, malware, or tool to an offensive technique, malware, or tool it is known to employ." ;
	skos:prefLabel "uses" ;
	skos:scopeNote "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'uses' shortcut (sub-property stones:uses carries the shortcut triples emitted by the STIX 2.1 transform). STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure. In the MITRE ATT&CK bundle alone, observed 'uses' sources include Campaign, IntrusionSet, Malware, and Tool, and observed targets include AttackTechnique, Malware, and Tool — a closed domain/range would misrepresent this real data and mislead reasoner-based consumers. Query-time discrimination (e.g. selecting only IntrusionSet users of a technique) should filter on the asserted stones:stixType literal or a specific rdf:type, not assume it from this property alone."@en ;
	.

stonework:usesDetectionRule
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:DetectionPlan
			stonework:Step
		) ;
	] ;
	rdfs:range stonework:DetectionRule ;
	skos:definition "Relates a DetectionPlan or Step to a DetectionRule that it evaluates or invokes."@en ;
	skos:prefLabel "usesDetectionRule"@en ;
	skos:scopeNote "Use stonework:usesRule for the deployment-side relationship between a Sensor and a DetectionRule."@en ;
	.

stonework:usesInfrastructure
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:uses ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Malware
			stonework:Product
			stonework:CyberActivity
			stonework:Agent
		) ;
	] ;
	rdfs:range stonework:Infrastructure ;
	skos:definition "Relates malware, a product, cyber activity, or agent to infrastructure it uses."@en ;
	skos:prefLabel "usesInfrastructure"@en ;
	skos:scopeNote "Use for an operational dependency on infrastructure, such as malware using command-and-control infrastructure, a CyberActivityCluster or Campaign using hosting infrastructure, a product using a supporting service, or an Agent using infrastructure in an operation. This relationship asserts use, not ownership, compromise, or attribution."@en ;
	.

stonework:usesInstrument
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:PaymentInstrument ;
	skos:definition "The payment instrument or rail used to execute this transaction — wire, ACH, SEPA, card, cash, on-chain transfer, and so on."@en ;
	skos:prefLabel "usesInstrument"@en ;
	.

stonework:usesRule
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:uses ;
	rdfs:domain stonework:Sensor ;
	rdfs:range stonework:DetectionRule ;
	skos:definition "Relates a Sensor to the Detection Rules it applies." ;
	skos:prefLabel "usesRule" ;
	.

stonework:validFrom
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:QualifiedAssertion ;
	rdfs:range xsd:dateTime ;
	skos:definition "The start of the interval during which a qualified assertion is considered applicable."@en ;
	skos:prefLabel "validFrom"@en ;
	.

stonework:validUntil
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:QualifiedAssertion ;
	rdfs:range xsd:dateTime ;
	skos:definition "The end of the interval during which a qualified assertion is considered applicable."@en ;
	skos:prefLabel "validUntil"@en ;
	.

stonework:valuationCurrency
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:MetricObservation ;
	rdfs:range stonework:Currency ;
	skos:definition "The currency in which a normalized monetary metric value is expressed."@en ;
	skos:prefLabel "valuationCurrency"@en ;
	skos:scopeNote "Required for a stonework:MetricObservation whose stonework:metricType is stonework:metricNormalizedValue. The source amount retains its own stonework:currency; this property identifies the output unit produced by the cited exchange-rate source."@en ;
	.

stonework:variableName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Variable ;
	rdfs:range xsd:string ;
	skos:definition "A short name identifying a Variable within the scope of its declaring Behavior, allowing it to be referenced consistently across Steps and Transitions."@en ;
	skos:prefLabel "variableName" ;
	.

stonework:variantOf
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:MalwareFamily
			stonework:MalwareSample
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:MalwareFamily
			stonework:MalwareSample
		) ;
	] ;
	skos:definition "Relates a MalwareFamily or MalwareSample to another family or sample from which it is derived, modified, or evolved, indicating shared code lineage, forked development, or deliberate repackaging."@en ;
	skos:prefLabel "variantOf" ;
	.

stonework:vendorOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Agent ;
	rdfs:range stonework:Product ;
	owl:inverseOf stonework:hasVendor ;
	skos:definition "Relates an Agent to a product family it develops or maintains."@en ;
	skos:prefLabel "vendorOf"@en ;
	.

stonework:version
	a owl:DatatypeProperty ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:string ;
	skos:definition "The version string for this specific product release."@en ;
	skos:prefLabel "version"@en ;
	.

stonework:versionOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range stonework:Product ;
	owl:inverseOf stonework:hasVersion ;
	skos:definition "Links a specific versioned product instance back to its abstract product family."@en ;
	skos:prefLabel "versionOf"@en ;
	.

stonework:vulnerabilityId
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:string ;
	skos:definition "The canonical identifier assigned to this vulnerability by its originating numbering authority, e.g. 'CVE-2021-44228', 'GHSA-jfh8-c2jp-hdp9', or 'OSV-2021-1'."@en ;
	skos:prefLabel "vulnerabilityId"@en ;
	skos:scopeNote "Source-specific ID properties (e.g. cve:cveId) are declared rdfs:subPropertyOf this property, enabling cross-source queries on a single predicate. Each vulnerability record SHOULD carry exactly one identifier from its primary numbering authority."@en ;
	.

stonework:walletAddress
	a owl:DatatypeProperty ;
	rdfs:domain stonework:CryptoAddress ;
	rdfs:range xsd:string ;
	skos:definition "The on-chain address string (e.g. a Bitcoin or Ethereum address)."@en ;
	skos:prefLabel "walletAddress"@en ;
	skos:scopeNote "Resolve the address's asset through ^stonework:hasIdentifier/stonework:accountCurrency and then its ledger through stonework:blockchainNetwork on a stonework:CryptoAsset. Do not rely on the address string alone to identify the asset or network."@en ;
	.

stonework:weaknessOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Weakness ;
	rdfs:range stonework:Vulnerability ;
	owl:inverseOf stonework:hasWeakness ;
	skos:definition "Relates a weakness to the vulnerability that exploits or instantiates it."@en ;
	skos:prefLabel "weaknessOf"@en ;
	skos:scopeNote "The range is a vulnerability individual. The weakness individual (domain) is a stonework:Weakness whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en ;
	.

stonework:worksFor
	a owl:ObjectProperty ;
	rdfs:domain stonework:Person ;
	rdfs:range stonework:Organization ;
	skos:definition "Relates a Person to the Organization they work for."@en ;
	skos:prefLabel "worksFor"@en ;
	.
