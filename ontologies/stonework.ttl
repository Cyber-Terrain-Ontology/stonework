stonework:compilationTimestamp
	a owl:DatatypeProperty ;
	rdfs:domain stonework:MalwareSample ;
	rdfs:range xsd:dateTime ;
	skos:definition "The timestamp embedded in the binary indicating when the malware was compiled."@en ;
	skos:prefLabel "compilationTimestamp"@en ;
	.

stonework:compromisedIn
	a owl:ObjectProperty ;
	rdfs:domain stonework:Agent ;
	rdfs:range stonework:Incident ;
	skos:definition "The Incident during which this Agent (user, system, or organization) was compromised."@en ;
	skos:prefLabel "compromisedIn" ;
	.

stonework:conductedBy
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Campaign
			stonework:Operation
		) ;
	] ;
	rdfs:range stonework:Agent ;
	skos:definition "Relates a Campaign or Operation to an Agent that conducts it."@en ;
	skos:prefLabel "conductedBy"@en ;
	.

stonework:confidence
	a owl:DatatypeProperty ;
	rdfs:range xsd:integer ;
	skos:definition "An integer score from 0 to 100 representing confidence in the accuracy of an assertion or the expected outcome of a Hypothesis."@en ;
	skos:prefLabel "confidence" ;
	skos:scopeNote "Domain is intentionally unset because the property is shared by Hypotheses and STIX-derived intelligence objects. Matches the STIX 2.1 confidence scale for round-tripping. For source- and time-qualified confidence history, use stonework:MetricObservation with stonework:metricConfidence."@en ;
	.

stonework:consistsOf
	a owl:ObjectProperty ;
	skos:definition "Generic composition relationship. Use stonework:consistsOfCampaign or a more specific property where possible."@en ;
	skos:prefLabel "consistsOf" ;
	.

stonework:consistsOfCampaign
	a owl:ObjectProperty ;
	rdfs:domain stonework:Operation ;
	rdfs:range stonework:Campaign ;
	skos:definition "Relates an Operation to the Campaigns that compose it."@en ;
	skos:prefLabel "consistsOfCampaign"@en ;
	.

stonework:containedIn
	a owl:ObjectProperty ;
	rdfs:domain stonework:File ;
	rdfs:range stonework:Directory ;
	owl:inverseOf stonework:containsFile ;
	skos:definition "A File resides in this Directory. Inverse of stonework:containsFile; enables upward traversal of the file system tree."@en ;
	skos:prefLabel "containedIn"@en ;
	.

stonework:contains
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:AutonomousSystem
			stonework:IPBlock
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:IPAddress
			stonework:IPBlock
		) ;
	] ;
	skos:definition "Relates an AutonomousSystem or IPBlock to an IPAddress or more-specific IPBlock contained within its routed address space."@en ;
	skos:prefLabel "contains" ;
	.

stonework:containsDirectory
	a owl:ObjectProperty ;
	rdfs:domain stonework:Directory ;
	rdfs:range stonework:Directory ;
	skos:definition "Relates a Directory to subdirectories it contains."@en ;
	skos:prefLabel "containsDirectory"@en ;
	.

stonework:containsFile
	a owl:ObjectProperty ;
	rdfs:domain stonework:Directory ;
	rdfs:range stonework:File ;
	skos:definition "Relates a Directory to the Files it contains."@en ;
	skos:prefLabel "containsFile"@en ;
	.

stonework:content
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Note ;
	rdfs:range xsd:string ;
	skos:definition "The full text content of the note."@en ;
	skos:prefLabel "content"@en ;
	.

stonework:controlBaseline
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Control ;
	rdfs:range xsd:string ;
	skos:definition "The security baseline(s) in which this control is required (e.g. Low, Moderate, High for NIST 800-53)."@en ;
	skos:prefLabel "controlBaseline"@en ;
	.

stonework:controlFamily
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Control ;
	rdfs:range xsd:string ;
	skos:definition "The control family or category grouping (e.g. Access Control, Incident Response)."@en ;
	skos:prefLabel "controlFamily"@en ;
	.

stonework:controlId
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Control ;
	rdfs:range xsd:string ;
	skos:definition "The framework-specific identifier for the control (e.g. AC-2, CIS 4.1)."@en ;
	skos:prefLabel "controlId"@en ;
	.

stonework:controls
	a owl:ObjectProperty ;
	rdfs:domain stonework:UserAccount ;
	rdfs:range stonework:FinancialAccount ;
	skos:definition "A stonework:FinancialAccount that this stonework:UserAccount, a login or credential, can operate."@en ;
	skos:prefLabel "controls"@en ;
	skos:scopeNote "Distinct from stonework:accountOf, which records the holder or beneficial owner. One login often controls several financial accounts; a financial account seen in isolation, such as an IBAN in wire data, may have no associated login. An account-takeover attacker holding a victim's UserAccount controls the victim's FinancialAccount without being its accountOf."@en ;
	.

stonework:correspondsToStep
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:CyberActivity ;
	rdfs:range stonework:Step ;
	rdfs:seeAlso <http://purl.org/net/p-plan#correspondsToStep> ;
	skos:definition "Links an executing CyberActivity to the Step it is the concrete performance of."@en ;
	skos:prefLabel "correspondsToStep" ;
	skos:scopeNote "Directly mirrors p-plan:correspondsToStep (domain prov:Activity, range p-plan:Step), narrowed to stonework:CyberActivity/stonework:Step. Declared functional, matching p-plan: a single CyberActivity corresponds to at most one Step, but a Step may still be the target of many CyberActivity instances across retries or repeated executions. Fills the gap noted on stonework:Step: the property linking an executing Activity back to the Step it realizes."@en ;
	.

stonework:counters
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:AnalyticTechnique
			stonework:DefendTechnique
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:AITechnique
			stonework:AttackTechnique
		) ;
	] ;
	skos:definition "Relates an AnalyticTechnique or DefendTechnique to an AITechnique or AttackTechnique it detects, neutralizes, or mitigates."@en ;
	skos:prefLabel "counters" ;
	.

stonework:countryCode
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Country ;
	rdfs:range xsd:string ;
	skos:definition "The ISO 3166-1 alpha-2 country code (e.g. US, CN, RU)."@en ;
	skos:prefLabel "countryCode"@en ;
	.

stonework:covers
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Assessment
			stonework:Report
		) ;
	] ;
	skos:definition "Relates a Report or Assessment to the entities it describes."@en ;
	skos:prefLabel "covers"@en ;
	.

stonework:cpeUri
	a owl:DatatypeProperty ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:string ;
	skos:definition "The CPE 2.3 formatted string identifying this product version."@en ;
	skos:prefLabel "cpeUri"@en ;
	.

stonework:created
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf dcterms:created ;
	rdfs:range xsd:dateTime ;
	skos:definition "The timestamp when this individual was first created or recorded."@en ;
	skos:prefLabel "created"@en ;
	skos:scopeNote "Compatibility alias for dcterms:created. Prefer dcterms:created in newly authored data."@en ;
	.

stonework:createdBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:IntelligenceProduct ;
	rdfs:range stonework:Agent ;
	skos:definition "Relates an Intelligence Product to the Agent that created it."@en ;
	skos:prefLabel "createdBy"@en ;
	.

stonework:createsMutex
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:MalwareSample
			stonework:RuntimeProcess
		) ;
	] ;
	rdfs:range stonework:Mutex ;
	skos:definition "Relates a RuntimeProcess or MalwareSample to a Mutex it creates."@en ;
	skos:prefLabel "createsMutex"@en ;
	.

stonework:currency
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:MonetaryAmount ;
	rdfs:range stonework:Currency ;
	skos:definition "The currency that denominates a stonework:MonetaryAmount."@en ;
	skos:prefLabel "currency"@en ;
	.

stonework:cveId
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf stonework:vulnerabilityId ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:string ;
	skos:definition "The CVE identifier in the format CVE-YYYY-NNNNN."@en ;
	skos:prefLabel "cveId"@en ;
	skos:scopeNote "Retained as the STONEWORK-level CVE-specific identifier and declared as a subproperty of stonework:vulnerabilityId. Source-native CVE records use cve:cveId, which has the same canonical superproperty."@en ;
	.

stonework:cvssBaseScore
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:decimal ;
	skos:definition "The headline CVSS base score for this vulnerability, on a 0.0–10.0 scale."@en ;
	skos:prefLabel "cvssBaseScore"@en ;
	skos:scopeNote "When multiple CVSS versions are present, this SHOULD reflect the highest available version (CVSS 4.0 preferred over 3.1, 3.1 over 2.0). For full structured metric data across all CVSS versions use stonework:hasCvssMetric."@en ;
	.

stonework:cvssScore
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf stonework:cvssBaseScore ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:decimal ;
	skos:definition "The CVSS base score (0.0–10.0) for the vulnerability."@en ;
	skos:prefLabel "cvssScore"@en ;
	skos:scopeNote "Retained for compatibility with the original datatype-property vocabulary. Prefer stonework:cvssBaseScore for new data."@en ;
	.

stonework:cvssSeverity
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:string ;
	skos:definition "The qualitative CVSS severity rating corresponding to the headline base score: NONE, LOW, MEDIUM, HIGH, or CRITICAL."@en ;
	skos:prefLabel "cvssSeverity"@en ;
	.

stonework:cvssVector
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:string ;
	skos:definition "The CVSS vector string encoding the metric values used to compute the headline base score, e.g. 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H'."@en ;
	skos:prefLabel "cvssVector"@en ;
	.

stonework:cweAbstractionLevel
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Weakness ;
	rdfs:range xsd:string ;
	skos:definition "The CWE abstraction level: Pillar, Class, Base, or Variant."@en ;
	skos:prefLabel "cweAbstractionLevel"@en ;
	.

stonework:cweId
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Weakness ;
	rdfs:range xsd:string ;
	skos:definition "The CWE identifier in the format CWE-NNN."@en ;
	skos:prefLabel "cweId"@en ;
	.

stonework:dateAssigned
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time at which a vulnerability identifier was assigned by the relevant numbering authority."@en ;
	skos:prefLabel "dateAssigned"@en ;
	skos:scopeNote "Corresponds to cveMetadata.dateReserved in CVE JSON 5.x. cve:dateAssigned is declared owl:equivalentProperty of this property."@en ;
	.

stonework:datePublic
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time at which this vulnerability was publicly disclosed."@en ;
	skos:prefLabel "datePublic"@en ;
	skos:scopeNote "Corresponds to cveMetadata.datePublished in CVE JSON 5.x. cve:datePublic is declared owl:equivalentProperty of this property."@en ;
	.

stonework:dateUpdated
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time at which the vulnerability record was last modified in its source database."@en ;
	skos:prefLabel "dateUpdated"@en ;
	skos:scopeNote "Corresponds to cveMetadata.dateUpdated in CVE JSON 5.x. cve:dateUpdated is declared owl:equivalentProperty of this property."@en ;
	.

stonework:deliveredVia
	a owl:ObjectProperty ;
	rdfs:domain stonework:MalwareSample ;
	rdfs:range stonework:Infrastructure ;
	skos:definition "Initial delivery Infrastructure for this MalwareSample. Semantically distinct from stonework:communicatesWith, which models C2 channels post-infection."@en ;
	skos:prefLabel "deliveredVia"@en ;
	.

stonework:dependencyOf
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "Relates a product to another product that depends on it. Transitive to support supply chain reasoning across deep dependency trees."@en ;
	skos:prefLabel "dependencyOf"@en ;
	.

stonework:derivedFrom
	a owl:ObjectProperty ;
	rdfs:domain stonework:DetectionRule ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:CyberActivity
			stonework:DigitalArtifact
			stonework:Infrastructure
		) ;
	] ;
	skos:definition "The observed CyberActivity, data source, or artifact from which this DetectionRule was written or derived."@en ;
	skos:prefLabel "derivedFrom" ;
	.

stonework:describesInfrastructure
	a owl:ObjectProperty ;
	rdfs:range stonework:Infrastructure ;
	skos:definition "Links a Software Bill of Materials to the enterprise infrastructure, system, or application whose component composition it inventories." ;
	skos:prefLabel "describes infrastructure" ;
	skos:scopeNote "Domain intentionally left unset. The primary subject is stonework:SoftwareBillOfMaterials, but other provenance-bearing artifacts may describe infrastructure without being SBOMs. Multiple SBOMs may describe the same Infrastructure over time, enabling historical component inventory."@en ;
	.

stonework:detectedBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Event ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:DetectionRule
			stonework:Sensor
		) ;
	] ;
	skos:definition "Relates an Event to the Sensor or DetectionRule that identified it."@en ;
	skos:prefLabel "detectedBy"@en ;
	.

stonework:detects
	a owl:ObjectProperty ;
	skos:definition "Relates a source DetectionRule, Sensor, Indicator, or defensive technique to the threat, activity, or artifact it is capable of detecting. Corresponds to STIX relationship_type 'detects'."@en ;
	skos:prefLabel "detects" ;
	skos:scopeNote "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'detects' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en ;
	.

stonework:displayName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:EmailAddress ;
	rdfs:range xsd:string ;
	skos:definition "The display name associated with the email address."@en ;
	skos:prefLabel "displayName"@en ;
	.

stonework:domainName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Domain ;
	rdfs:range xsd:string ;
	skos:definition "The fully qualified domain name string (e.g. malicious-site.com)."@en ;
	skos:prefLabel "domainName"@en ;
	.

stonework:downloads
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:File
			stonework:MalwareSample
			stonework:Tool
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:File
			stonework:MalwareSample
			stonework:Tool
		) ;
	] ;
	skos:definition "Relates a File, MalwareSample, or Tool to another File, MalwareSample, or Tool it retrieves during execution."@en ;
	skos:prefLabel "downloads" ;
	.

stonework:drops
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain stonework:MalwareSample ;
	rdfs:range stonework:DigitalArtifact ;
	skos:definition "A DigitalArtifact written to the filesystem or memory by this MalwareSample during execution."@en ;
	skos:prefLabel "drops" ;
	.

stonework:dstPort
	a owl:DatatypeProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range xsd:unsignedShort ;
	skos:definition "The destination TCP/UDP port number."@en ;
	skos:prefLabel "dstPort"@en ;
	.

stonework:emailOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:EmailAddress ;
	rdfs:range stonework:Agent ;
	owl:inverseOf stonework:hasEmail ;
	skos:definition "The Agent that owns or is associated with this EmailAddress. Inverse of stonework:hasEmail."@en ;
	skos:prefLabel "emailOf" ;
	.

stonework:emailValue
	a owl:DatatypeProperty ;
	rdfs:domain stonework:EmailAddress ;
	rdfs:range xsd:string ;
	skos:definition "The email address string (local@domain)."@en ;
	skos:prefLabel "emailValue"@en ;
	.

stonework:employs
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:uses ;
	rdfs:domain stonework:ThreatActor ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:AttackPattern
			stonework:Malware
			stonework:Technique
			stonework:Tool
		) ;
	] ;
	skos:definition "Relates a ThreatActor to an AttackPattern, Malware, Technique, or Tool it deliberately puts into operational use."@en ;
	skos:prefLabel "employs"@en ;
	skos:scopeNote "Use for curated ThreatActor relationships where deliberate operational use is intended. As a subproperty of the open STIX-compatible stonework:uses relationship, employs assertions remain available to queries over the broader interoperability predicate."@en ;
	.

stonework:endedAtTime
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:CyberActivity ;
	rdfs:range xsd:dateTime ;
	rdfs:seeAlso prov:endedAtTime ;
	skos:definition "The date and time at which a CyberActivity ended."@en ;
	skos:prefLabel "endedAtTime" ;
	.

stonework:epssScore
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range xsd:decimal ;
	skos:definition "The EPSS (Exploit Prediction Scoring System) score (0.0–1.0), estimating the probability of exploitation in the wild within 30 days."@en ;
	skos:prefLabel "epssScore"@en ;
	skos:scopeNote "Convenience projection for a current score. Preserve dated values, source, and EPSS model version with stonework:MetricObservation and stonework:metricEpssScore."@en ;
	.

stonework:evidencedBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Sighting ;
	rdfs:range stonework:DigitalArtifact ;
	skos:definition "A Sighting is substantiated by this DigitalArtifact (memory dump, PCAP, log excerpt, sample). Connects analytical observation to forensic evidence."@en ;
	skos:prefLabel "evidencedBy"@en ;
	.

stonework:executablePath
	a owl:DatatypeProperty ;
	rdfs:domain stonework:RuntimeProcess ;
	rdfs:range xsd:string ;
	skos:definition "The filesystem path of the process executable image."@en ;
	skos:prefLabel "executablePath"@en ;
	.

stonework:executedOn
	a owl:ObjectProperty ;
	rdfs:domain stonework:RuntimeProcess ;
	rdfs:range stonework:Host ;
	owl:inverseOf stonework:runs ;
	skos:definition "Relates a RuntimeProcess to the Host it ran on."@en ;
	skos:prefLabel "executedOn"@en ;
	.

stonework:executionOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberActivity ;
	rdfs:range stonework:Behavior ;
	owl:inverseOf stonework:hasExecution ;
	skos:definition "Relates a CyberActivity to the Behavior plan whose execution it represents."@en ;
	skos:prefLabel "executionOf"@en ;
	skos:scopeNote "Links an overall execution to the Behavior it carries out. This may be a full plan — an Investigation to an InvestigationPlan, an Operation to an OperationPlan, a Process to a Playbook or ControlPlan — or, in the lightweight case, a bare method: a CyberActivity may point directly at the stonework:Technique (or stonework:AttackTechnique) it performs, with no intervening Procedure, Plan, or Step. The lightweight form is the common one for sightings and incident timelines ('actor performed T1003.001 against this host at this time'); it can be elaborated into a Step-decomposed Plan later without changing the executionOf assertion. Use stonework:correspondsToStep for the finer-grained link between an executing CyberActivity and an individual Step when a Plan is present."@en ;
	.

stonework:expirationDate
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Domain ;
	rdfs:range xsd:date ;
	skos:definition "The date the domain registration expires."@en ;
	skos:prefLabel "expirationDate"@en ;
	.

stonework:exploits
	a owl:ObjectProperty ;
	skos:definition "Shortcut triple: source Malware or ThreatActor exploits target Vulnerability. Corresponds to STIX relationship_type 'exploits'." ;
	skos:prefLabel "exploits" ;
	skos:scopeNote "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'exploits' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en ;
	.

stonework:exploitsWeakness
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:hasWeakness ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range stonework:Weakness ;
	skos:definition "Relates a vulnerability to the weakness class it instantiates or exploits. Subproperty of stonework:hasWeakness, using the directional 'exploits' semantics aligned with CVE and CWE mapping conventions."@en ;
	skos:prefLabel "exploitsWeakness"@en ;
	skos:scopeNote "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. Used by cve:exploitsWeakness (rdfs:subPropertyOf this property) when CVE data is loaded."@en ;
	.

stonework:exposesService
	a owl:ObjectProperty ;
	rdfs:domain stonework:Host ;
	rdfs:range stonework:NetworkService ;
	skos:definition "Relates a Host to the NetworkServices it provides."@en ;
	skos:prefLabel "exposesService"@en ;
	.

stonework:externalId
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf dcterms:identifier ;
	rdfs:range xsd:string ;
	skos:definition "An identifier from an external system or framework (e.g. STIX ID, MITRE ATT&CK ID, NVD CVE ID)."@en ;
	skos:prefLabel "externalId"@en ;
	skos:scopeNote "Compatibility alias for dcterms:identifier when the value originates in an external system. Prefer dcterms:identifier when source context is already explicit."@en ;
	.

stonework:fileExtension
	a owl:DatatypeProperty ;
	rdfs:domain stonework:File ;
	rdfs:range xsd:string ;
	skos:definition "The file extension without the leading dot (e.g. exe, dll, ps1)."@en ;
	skos:prefLabel "fileExtension"@en ;
	.

stonework:fileName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:File ;
	rdfs:range xsd:string ;
	skos:definition "The name of the file without path."@en ;
	skos:prefLabel "fileName"@en ;
	.

stonework:filePath
	a owl:DatatypeProperty ;
	rdfs:domain stonework:File ;
	rdfs:range xsd:string ;
	skos:definition "The full filesystem path of the file."@en ;
	skos:prefLabel "filePath"@en ;
	.

stonework:fileSize
	a owl:DatatypeProperty ;
	rdfs:domain stonework:File ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "The size of the file in bytes."@en ;
	skos:prefLabel "fileSize"@en ;
	.

stonework:firstSeen
	a owl:DatatypeProperty ;
	rdfs:range xsd:dateTime ;
	skos:definition "The timestamp when the entity was first observed."@en ;
	skos:prefLabel "firstSeen"@en ;
	skos:scopeNote "Use with stonework:lastSeen to delimit an observation window. For the execution interval of a stonework:CyberActivity, use stonework:startedAtTime and stonework:endedAtTime instead."@en ;
	.

stonework:fixedInProduct
	a owl:ObjectProperty ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "Relates a vulnerability to the product version in which it was addressed."@en ;
	skos:prefLabel "fixedInProduct"@en ;
	skos:scopeNote "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. Populated by CVE/patch ingest."@en ;
	.

stonework:fqdn
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Host ;
	rdfs:range xsd:string ;
	skos:definition "The fully qualified domain name of the host."@en ;
	skos:prefLabel "fqdn"@en ;
	.

stonework:fromStep
	a owl:ObjectProperty ;
	rdfs:domain stonework:Transition ;
	rdfs:range stonework:Step ;
	skos:definition "The Step a Transition leaves."@en ;
	skos:prefLabel "fromStep" ;
	.

stonework:fundsActivity
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:CyberActivity ;
	skos:definition "A cyber activity that this transaction finances — for example an infrastructure purchase linked to the campaign or operation it supports."@en ;
	skos:prefLabel "fundsActivity"@en ;
	skos:scopeNote "This property asserts a financing relationship. For a payment made in response to an activity without financing it, such as a victim's ransom payment made because of an incident, use stonework:respondsToActivity."@en ;
	.

stonework:generatedBy
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Log
			stonework:NetworkTraffic
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Host
			stonework:NetworkService
			stonework:Sensor
		) ;
	] ;
	skos:definition "Relates a Log or NetworkTraffic to the system that produced it."@en ;
	skos:prefLabel "generatedBy"@en ;
	.

stonework:generatedFrom
	a owl:ObjectProperty ;
	rdfs:domain stonework:Event ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Log
			stonework:NetworkTraffic
		) ;
	] ;
	skos:definition "Links an Event to the raw log or network traffic from which it was derived."@en ;
	skos:prefLabel "generatedFrom"@en ;
	.

stonework:grantedTo
	a owl:ObjectProperty ;
	rdfs:domain stonework:AccessControlList ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:UserAccount
			stonework:UserGroup
		) ;
	] ;
	skos:definition "Relates an AccessControlList to a UserAccount or UserGroup whose permissions it records."@en ;
	skos:prefLabel "grantedTo"@en ;
	.

stonework:groupName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:UserGroup ;
	rdfs:range xsd:string ;
	skos:definition "The name of the user group."@en ;
	skos:prefLabel "groupName"@en ;
	.

stonework:guardLiteralValue
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Transition ;
	rdfs:range rdfs:Literal ;
	skos:definition "The literal value that guardVariable's bound value is compared against."@en ;
	skos:prefLabel "guardLiteralValue" ;
	skos:scopeNote "Compared using the operator given by stonework:guardOperator; if guardOperator is omitted, comparison defaults to Equals. Must share a compatible, numerically-typed datatype with the guardVariable's stonework:boundToLiteral value when an ordering operator is used."@en ;
	.

stonework:guardOperator
	a owl:ObjectProperty ;
	rdfs:domain stonework:Transition ;
	rdfs:range stonework:ComparisonOperator ;
	skos:definition "The comparison operator applied between guardVariable's bound literal value and guardLiteralValue."@en ;
	skos:prefLabel "guardOperator" ;
	skos:scopeNote "Omitted = Equals, preserving equality-only guard semantics without requiring this property on every Transition."@en ;
	.

stonework:guardType
	a owl:ObjectProperty ;
	rdfs:domain stonework:Transition ;
	rdfs:range rdfs:Class ;
	skos:definition "A Transition fires only if guardVariable's stonework:boundTo value is an instance of this class."@en ;
	skos:prefLabel "guardType" ;
	skos:scopeNote "Used for guards that test whether a Variable was bound to an instance of a particular class (e.g. testing that an attempt's outcome Variable was bound to a stonework:SecurityCondition instance) rather than testing equality against a scalar."@en ;
	.

stonework:guardVariable
	a owl:ObjectProperty ;
	rdfs:domain stonework:Transition ;
	rdfs:range stonework:Variable ;
	skos:definition "The Variable whose bound value is tested to decide whether a Transition is taken."@en ;
	skos:prefLabel "guardVariable" ;
	.

stonework:hasAccount
	a owl:ObjectProperty ;
	rdfs:domain stonework:Agent ;
	rdfs:range stonework:Account ;
	owl:inverseOf stonework:accountOf ;
	skos:definition "An Account (user account or financial account) held by, or beneficially attributed to, this Agent."@en ;
	skos:prefLabel "hasAccount"@en ;
	.

stonework:hasArtifact
	a owl:ObjectProperty ;
	rdfs:domain stonework:MalwareSample ;
	rdfs:range stonework:DigitalArtifact ;
	skos:definition "Links a MalwareSample to a captured binary artifact (file, memory dump, or encoded payload) constituting the physical evidence of the sample."@en ;
	skos:prefLabel "hasArtifact"@en ;
	skos:scopeNote "Optional — a MalwareSample may be known via hashes or threat reports without the binary being available. When present, the artifact provides retrievable binary evidence. Corresponds to the STIX 2.1 sample_refs property on the malware SDO."@en ;
	.

stonework:hasBehavior
	a owl:ObjectProperty ;
	rdfs:range stonework:Behavior ;
	skos:definition "Associates a MalwareSample, AttackPattern, ThreatActor, or Campaign with an observed Behavior. Enables behavioral clustering and similarity reasoning."@en ;
	skos:prefLabel "hasBehavior"@en ;
	.

stonework:hasBomEntry
	a owl:ObjectProperty ;
	rdfs:domain stonework:SoftwareBillOfMaterials ;
	rdfs:range stonework:BomEntry ;
	skos:definition "Relates a Software Bill of Materials to one of its component entries."@en ;
	skos:prefLabel "has BOM entry" ;
	skos:scopeNote "Each BomEntry carries the component's VersionedProduct reference (via stonework:installationOf) and any component-specific metadata (PURL, license, hash, component type). Range is BomEntry rather than VersionedProduct directly because the same VersionedProduct may appear in multiple SBOMs with different component-level attributes."@en ;
	.

stonework:hasCvssMetric
	a owl:ObjectProperty ;
	rdfs:domain stonework:Vulnerability ;
	skos:definition "Relates a vulnerability to a structured CVSS metric record carrying the version, vector string, and base/temporal/environmental scores."@en ;
	skos:prefLabel "hasCvssMetric"@en ;
	skos:scopeNote "A single vulnerability may carry metrics for multiple CVSS versions (2.0, 3.1, 4.0). For a single headline score and severity, use stonework:cvssBaseScore and stonework:cvssSeverity directly on the Vulnerability. This property links to the full per-version metric objects populated by CVE ingest."@en ;
	.

stonework:hasDependency
	a owl:ObjectProperty ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range stonework:VersionedProduct ;
	owl:inverseOf stonework:dependencyOf ;
	skos:definition "Relates a product version to another product version it depends on."@en ;
	skos:prefLabel "hasDependency"@en ;
	.

stonework:hasDestinationAddress
	a owl:ObjectProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range stonework:IPAddress ;
	skos:definition "Relates NetworkTraffic to the destination IP address."@en ;
	skos:prefLabel "hasDestinationAddress"@en ;
	.

stonework:hasEmail
	a owl:ObjectProperty ;
	rdfs:domain stonework:Agent ;
	rdfs:range stonework:EmailAddress ;
	owl:inverseOf stonework:emailOf ;
	skos:definition "An EmailAddress associated with this Agent."@en ;
	skos:prefLabel "hasEmail" ;
	.

stonework:hasEvent
	a owl:ObjectProperty ;
	rdfs:domain stonework:Incident ;
	rdfs:range stonework:Event ;
	skos:definition "Relates an Incident to an Event that forms part of its recorded activity."@en ;
	skos:prefLabel "hasEvent"@en ;
	.

stonework:hasExecution
	a owl:ObjectProperty ;
	rdfs:domain stonework:Behavior ;
	rdfs:range stonework:CyberActivity ;
	skos:definition "Relates a Behavior plan to a CyberActivity that executes it."@en ;
	skos:prefLabel "hasExecution"@en ;
	.

stonework:hasHash
	a owl:ObjectProperty ;
	rdfs:range stonework:Hash ;
	skos:definition "Relates an entity to its hash entries. The range is a stonework:Hash individual representing a single hash algorithm and digest value." ;
	skos:prefLabel "hasHash" ;
	.

stonework:hasIPBlock
	a owl:ObjectProperty ;
	rdfs:domain stonework:AutonomousSystem ;
	rdfs:range stonework:IPBlock ;
	skos:definition "Relates an AutonomousSystem to an IPBlock it originates or announces."@en ;
	skos:prefLabel "hasIPBlock"@en ;
	.

stonework:hasIdentifier
	a owl:ObjectProperty ;
	rdfs:domain stonework:DigitalIdentity ;
	rdfs:range stonework:Identifier ;
	skos:definition "Links a Digital Identity to one or more atomic Identifiers that belong to it." ;
	skos:prefLabel "hasIdentifier" ;
	.

stonework:hasImpact
	a owl:ObjectProperty ;
	rdfs:domain stonework:Risk ;
	rdfs:range stonework:Impact ;
	skos:definition "Relates a Risk to its associated Impact component."@en ;
	skos:prefLabel "hasImpact"@en ;
	.

stonework:hasInput
	a owl:ObjectProperty ;
	rdfs:domain stonework:Process ;
	skos:definition "Relates a Process to its input data or artifacts."@en ;
	skos:prefLabel "hasInput"@en ;
	.

stonework:hasInputVariable
	a owl:ObjectProperty ;
	rdfs:domain stonework:Behavior ;
	rdfs:range stonework:Variable ;
	skos:definition "Declares a Variable whose value must be bound before the Behavior or Step executes."@en ;
	skos:prefLabel "hasInputVariable" ;
	.

stonework:hasInstalledProduct
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "Links an enterprise infrastructure to a versioned product known to be installed in that environment." ;
	skos:prefLabel "has installed product" ;
	skos:scopeNote "Used in the user-data graph to assert enterprise inventory directly. Combined with stonework:versionOf and stonework:affected, enables traversal from installed software to applicable CVEs. For SBOM-based ingest with full component provenance, see stonework:SoftwareBillOfMaterials and stonework:hasBomEntry."@en ;
	.

stonework:hasLikelihood
	a owl:ObjectProperty ;
	rdfs:domain stonework:Risk ;
	rdfs:range stonework:Likelihood ;
	skos:definition "Relates a Risk to its associated Likelihood component."@en ;
	skos:prefLabel "hasLikelihood"@en ;
	.

stonework:hasMember
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Group
			stonework:Organization
			stonework:ThreatActor
		) ;
	] ;
	owl:inverseOf stonework:memberOf ;
	skos:definition "Relates a Group, Organization, or ThreatActor to one of its members. Multiple members are represented by multiple triples."@en ;
	skos:prefLabel "hasMember"@en ;
	.

stonework:hasMemberActivity
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberActivityCluster ;
	rdfs:range stonework:CyberActivity ;
	owl:inverseOf stonework:memberOfActivityCluster ;
	skos:definition "Relates a CyberActivityCluster to a CyberActivity analytically grouped within it."@en ;
	skos:prefLabel "hasMemberActivity"@en ;
	.

stonework:hasMetricObservation
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberEntity ;
	rdfs:range stonework:MetricObservation ;
	owl:inverseOf stonework:metricFor ;
	skos:definition "Relates an entity to a source- and time-qualified metric observation about it."@en ;
	skos:prefLabel "hasMetricObservation"@en ;
	.

stonework:hasMonetaryValue
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:FinancialAccount
			stonework:FinancialTransaction
			stonework:Impact
		) ;
	] ;
	rdfs:range stonework:MonetaryAmount ;
	skos:definition "Relates a transaction, account, or impact to a stonework:MonetaryAmount stating a sum of money and its currency."@en ;
	skos:prefLabel "hasMonetaryValue"@en ;
	.

stonework:hasNetworkAddress
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Host
			stonework:NetworkService
		) ;
	] ;
	rdfs:range stonework:IPAddress ;
	owl:inverseOf stonework:addressOf ;
	skos:definition "Relates a Host or NetworkService to an IPAddress assigned to or used by it."@en ;
	skos:prefLabel "hasNetworkAddress"@en ;
	.

stonework:hasObservable
	a owl:ObjectProperty ;
	rdfs:domain stonework:SecurityObservation ;
	rdfs:range stonework:CyberEntity ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAhasResult> ;
	skos:definition "Links a SecurityObservation to the cyber observable objects (SCOs) captured during the observation window."@en ;
	skos:prefLabel "hasObservable"@en ;
	skos:scopeNote "The range covers any SCO type: stonework:IPAddress, stonework:Domain, stonework:File, stonework:NetworkTraffic, stonework:RuntimeProcess, stonework:UserAccount, etc. Corresponds to STIX observed-data object_refs. Inspired by SOSA sosa:hasResult."@en ;
	.

stonework:hasOnlineReference
	a owl:ObjectProperty ;
	rdfs:range stonework:OnlineReference ;
	skos:definition "Associates any object with an OnlineReference (blog post, advisory URL, disclosure, vendor bulletin). Primary arc into the OnlineReference class."@en ;
	skos:prefLabel "hasOnlineReference"@en ;
	.

stonework:hasOutput
	a owl:ObjectProperty ;
	rdfs:domain stonework:Process ;
	skos:definition "Relates a Process to the data or artifacts it produces."@en ;
	skos:prefLabel "hasOutput"@en ;
	.

stonework:hasOutputVariable
	a owl:ObjectProperty ;
	rdfs:domain stonework:Behavior ;
	rdfs:range stonework:Variable ;
	skos:definition "Declares a Variable whose value is bound only once the Behavior or Step has executed."@en ;
	skos:prefLabel "hasOutputVariable" ;
	.

stonework:hasParentProcess
	a owl:ObjectProperty ;
	rdfs:domain stonework:RuntimeProcess ;
	rdfs:range stonework:RuntimeProcess ;
	skos:definition "Relates a RuntimeProcess to the parent process that spawned it."@en ;
	skos:prefLabel "hasParentProcess"@en ;
	.

stonework:hasPhoneNumber
	a owl:ObjectProperty ;
	rdfs:domain stonework:Agent ;
	rdfs:range stonework:PhoneNumber ;
	owl:inverseOf stonework:phoneNumberOf ;
	skos:definition "A PhoneNumber associated with this Agent."@en ;
	skos:prefLabel "hasPhoneNumber"@en ;
	.

stonework:hasProductInstallation
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:ProductInstallation ;
	skos:definition "Relates an Infrastructure entity to a contextual record of a product installed on it."@en ;
	skos:prefLabel "hasProductInstallation"@en ;
	skos:scopeNote "Use stonework:hasInstalledProduct for a direct Infrastructure-to-VersionedProduct inventory assertion. Use this property with stonework:installationOf when installation-specific identity, path, licensee, or configuration details must be preserved."@en ;
	.

stonework:hasProvenance
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:IntelligenceProduct
			stonework:QualifiedAssertion
		) ;
	] ;
	rdfs:range stonework:Provenance ;
	owl:inverseOf stonework:provenanceOf ;
	skos:definition "Relates an IntelligenceProduct or QualifiedAssertion to a Provenance record documenting its origin or evidentiary basis."@en ;
	skos:prefLabel "hasProvenance"@en ;
	.

stonework:hasRisk
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:DataAsset
			stonework:Infrastructure
			stonework:Organization
		) ;
	] ;
	rdfs:range stonework:Risk ;
	skos:definition "Relates an asset or organization to an assessed Risk."@en ;
	skos:prefLabel "hasRisk"@en ;
	.

stonework:hasRoleAssignment
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberEntity ;
	rdfs:range stonework:RoleAssignment ;
	owl:inverseOf stonework:rolePlayer ;
	skos:definition "Relates an entity to a qualified assignment of a Role in a specific context."@en ;
	skos:prefLabel "hasRoleAssignment"@en ;
	.

stonework:hasSignature
	a owl:ObjectProperty ;
	rdfs:range stonework:Signature ;
	skos:definition "Associates a Campaign, ThreatActor, MalwareSample, or Infrastructure with a detection Signature. Primary arc into the Signature class."@en ;
	skos:prefLabel "hasSignature"@en ;
	.

stonework:hasSourceAddress
	a owl:ObjectProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range stonework:IPAddress ;
	skos:definition "Relates NetworkTraffic to the source IP address."@en ;
	skos:prefLabel "hasSourceAddress"@en ;
	.

stonework:hasStep
	a owl:ObjectProperty ;
	rdfs:domain stonework:Behavior ;
	rdfs:range stonework:Step ;
	skos:definition "Relates a Behavior (Procedure, Playbook, ThreatScenario, Control, or another Step) to a Step that decomposes it."@en ;
	skos:prefLabel "hasStep" ;
	skos:scopeNote "Domain is the general Behavior root rather than a specific subclass, so decomposition applies uniformly across Procedure, Playbook, ThreatScenario, and — recursively, since Step is itself a Behavior — Step."@en ;
	.

stonework:hasTechnique
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Tactic
			stonework:Technique
		) ;
	] ;
	rdfs:range stonework:Technique ;
	owl:inverseOf stonework:techniqueOf ;
	skos:definition "Relates a Tactic to a Technique that serves its goal, or a Technique to a more specific Technique it contains."@en ;
	skos:prefLabel "hasTechnique" ;
	.

stonework:hasVendor
	a owl:ObjectProperty ;
	rdfs:domain stonework:Product ;
	rdfs:range stonework:Agent ;
	owl:inverseOf stonework:vendorOf ;
	skos:definition "Relates a product family to the Agent (organization or person) that develops or maintains it."@en ;
	skos:prefLabel "hasVendor"@en ;
	.

stonework:hasVersion
	a owl:ObjectProperty ;
	rdfs:domain stonework:Product ;
	rdfs:range stonework:VersionedProduct ;
	owl:inverseOf stonework:versionOf ;
	skos:definition "Relates a product family to a specific versioned product instance."@en ;
	skos:prefLabel "hasVersion"@en ;
	.

stonework:hasWeakness
	a
		owl:ObjectProperty ,
		owl:AsymmetricProperty
		;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range stonework:Weakness ;
	skos:definition "Relates a vulnerability to the weakness class it exploits or instantiates."@en ;
	skos:prefLabel "hasWeakness" ;
	skos:scopeNote "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en ;
	.

stonework:hashAlgorithm
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Hash ;
	rdfs:range xsd:string ;
	skos:definition "The cryptographic hash algorithm used (e.g. MD5, SHA-1, SHA-256, SHA-512, SSDEEP)."@en ;
	skos:prefLabel "hashAlgorithm"@en ;
	.

stonework:hashOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Hash ;
	owl:inverseOf stonework:hasHash ;
	skos:definition "Relates a hash entry to the entity it describes. The domain is a stonework:Hash individual representing a single hash algorithm and digest value." ;
	skos:prefLabel "hashOf" ;
	.

stonework:hashValue
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Hash ;
	rdfs:range xsd:string ;
	skos:definition "The hex-encoded digest produced by the hash algorithm."@en ;
	skos:prefLabel "hashValue"@en ;
	.

stonework:headquarteredIn
	a owl:ObjectProperty ;
	rdfs:domain stonework:Organization ;
	rdfs:range stonework:Location ;
	skos:definition "Relates an Organization to its primary headquarters Location."@en ;
	skos:prefLabel "headquarteredIn"@en ;
	.

stonework:heldAt
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialAccount ;
	rdfs:range stonework:FinancialInstitution ;
	skos:definition "The financial institution that maintains this account."@en ;
	skos:prefLabel "heldAt"@en ;
	skos:scopeNote "Optional. Absent for a self-custody crypto wallet or an account whose institution is unknown; present and pointing at a virtual asset service provider for a custodial wallet."@en ;
	.

stonework:hostedBy
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:Agent ;
	skos:definition "The Agent (hosting provider, organization, or individual) that operates or administers this Infrastructure."@en ;
	skos:prefLabel "hostedBy" ;
	.

stonework:hostedOn
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:Host ;
	skos:definition "The logical Infrastructure entity runs on this physical or virtual Host. Bridges the abstract infrastructure layer to the concrete system for configuration and vulnerability queries."@en ;
	skos:prefLabel "hostedOn"@en ;
	.

stonework:hostname
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Host ;
	rdfs:range xsd:string ;
	skos:definition "The system hostname or NetBIOS name."@en ;
	skos:prefLabel "hostname"@en ;
	.

stonework:iban
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:IBAN ;
	rdfs:range xsd:string ;
	skos:definition "The IBAN string, including country prefix and check digits."@en ;
	skos:prefLabel "iban"@en ;
	.

stonework:implants
	a owl:ObjectProperty ;
	rdfs:domain stonework:MalwareSample ;
	rdfs:range stonework:MalwareSample ;
	skos:definition "A dropper or loader MalwareSample installs another MalwareSample payload. Models multi-stage delivery chains for reasoners tracking infection sequences."@en ;
	skos:prefLabel "implants"@en ;
	.

stonework:implementedBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Behavior ;
	rdfs:range stonework:Behavior ;
	owl:inverseOf stonework:implements ;
	skos:definition "Relates an abstract Behavior to a concrete, Step-decomposed Behavior that realizes it."@en ;
	skos:prefLabel "implementedBy" ;
	.

stonework:implements
	a owl:ObjectProperty ;
	rdfs:domain stonework:Behavior ;
	rdfs:range stonework:Behavior ;
	skos:definition "Relates a concrete, Step-decomposed Behavior to the more abstract Behavior it is a specific realization of."@en ;
	skos:prefLabel "implements" ;
	skos:scopeNote "General-purpose relationship covering both offense (a Procedure implements a Technique) and defense (a ControlPlan implements a Control) with one property rather than a bespoke one per pairing."@en ;
	.

stonework:implementsCountermeasure
	a owl:ObjectProperty ;
	rdfs:domain stonework:SecurityActuator ;
	rdfs:range stonework:Countermeasure ;
	owl:propertyChainAxiom (
		stonework:madeActuation
		stonework:appliesCountermeasure
	) ;
	skos:definition "Relates a SecurityActuator to a Countermeasure it is configured or capable of applying."@en ;
	skos:prefLabel "implementsCountermeasure"@en ;
	skos:scopeNote "May be asserted directly for configured capabilities. It is also inferred when the actuator made a SecurityActuation that applies the Countermeasure."@en ;
	.

stonework:implementsTechnique
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:uses ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Malware
			stonework:Product
			stonework:VersionedProduct
		) ;
	] ;
	rdfs:range stonework:Technique ;
	skos:definition "Relates malware or a product to a Technique embodied by its behavior or capabilities."@en ;
	skos:prefLabel "implementsTechnique" ;
	skos:scopeNote "Specializes the open STIX-compatible stonework:uses relationship for malware- or product-to-technique assertions. Product covers abstract product families, including Tool; VersionedProduct covers specific releases or builds. stonework:implements remains the distinct Behavior-to-Behavior realization relationship."@en ;
	.

stonework:inBlock
	a owl:ObjectProperty ;
	rdfs:domain stonework:IPAddress ;
	rdfs:range stonework:IPBlock ;
	skos:definition "Relates an IPAddress to the IPBlock whose address space contains it."@en ;
	skos:prefLabel "inBlock"@en ;
	.

stonework:indicates
	a owl:ObjectProperty ;
	rdfs:domain stonework:Indicator ;
	skos:definition "Asserts that when the source Indicator's pattern is matched, it signals the presence of the target adversary behavior, malware, campaign, or threat actor." ;
	skos:prefLabel "indicates"@en ;
	skos:scopeNote "Corresponds to STIX relationship_type 'indicates'. Domain is stonework:Indicator — unlike the source side of other STIX relationship shortcuts, this is definitional rather than open-world convention: an object is only ever an Indicator because it indicates something, per STIX's own spec role for that object type. Range is intentionally left unset: an Indicator may indicate all sorts of things (AttackPattern/AttackTechnique, Malware, Campaign, CyberActivityCluster, ThreatActor, Infrastructure, Tool, and whatever else a producer's pattern targets), and STIX does not schema-constrain the target_ref type for a given relationship_type. A single Indicator may indicate multiple targets."@en ;
	.

stonework:initiatedBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range stonework:RuntimeProcess ;
	skos:definition "The RuntimeProcess that opened this NetworkTraffic flow. Core process-to-network correlation arc for host-based forensics and lateral movement analysis."@en ;
	skos:prefLabel "initiatedBy"@en ;
	.

stonework:installationOf
	a owl:ObjectProperty ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "Relates a component context to the versioned product it references or instantiates."@en ;
	skos:prefLabel "installation of" ;
	skos:scopeNote "Used by both stonework:BomEntry (declarative — a component listed in an SBOM) and stonework:ProductInstallation (observational — a verified deployment on a specific system). Domain is intentionally left unset to avoid restricting future component-context subclasses; intended subjects are subclasses of stonework:ComponentContext."@en ;
	.

stonework:installedOn
	a owl:ObjectProperty ;
	rdfs:domain stonework:ProductInstallation ;
	rdfs:range stonework:Infrastructure ;
	owl:inverseOf stonework:hasProductInstallation ;
	skos:definition "Relates a ProductInstallation to the Infrastructure entity on which that product instance is installed."@en ;
	skos:prefLabel "installedOn"@en ;
	.

stonework:intermediaryAccount
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:FinancialAccount ;
	skos:definition "A correspondent or intermediary account through which this transaction is routed between originator and beneficiary."@en ;
	skos:prefLabel "intermediaryAccount"@en ;
	skos:scopeNote "Multi-valued and unordered in this revision; a strict correspondent-banking chain order is deferred."@en ;
	.

stonework:investigatedBy
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Campaign
			stonework:Incident
			stonework:MalwareSample
			stonework:ThreatActor
		) ;
	] ;
	rdfs:range stonework:Investigation ;
	owl:inverseOf stonework:investigates ;
	skos:definition "Relates an Incident, Campaign, MalwareSample, or ThreatActor to an Investigation examining it."@en ;
	skos:prefLabel "investigatedBy"@en ;
	.

stonework:investigates
	a owl:ObjectProperty ;
	rdfs:domain stonework:Investigation ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Campaign
			stonework:Incident
			stonework:MalwareSample
			stonework:ThreatActor
		) ;
	] ;
	owl:inverseOf stonework:investigatedBy ;
	skos:definition "Relates an Investigation to the subject being investigated."@en ;
	skos:prefLabel "investigates"@en ;
	.

stonework:involvesCampaign
	a owl:ObjectProperty ;
	rdfs:domain stonework:Incident ;
	rdfs:range stonework:Campaign ;
	skos:definition "Links an Incident to a Campaign it is part of or attributed to."@en ;
	skos:prefLabel "involvesCampaign"@en ;
	.

stonework:ipValue
	a owl:DatatypeProperty ;
	rdfs:domain stonework:IPAddress ;
	rdfs:range xsd:string ;
	skos:definition "The dotted-decimal or colon-hex string representation of the IP address."@en ;
	skos:prefLabel "ipValue"@en ;
	.

stonework:ipVersion
	a owl:DatatypeProperty ;
	rdfs:domain stonework:IPAddress ;
	rdfs:range [
		a rdfs:Datatype ;
		owl:oneOf (
			"4"^^xsd:integer
			"6"^^xsd:integer
		) ;
	] ;
