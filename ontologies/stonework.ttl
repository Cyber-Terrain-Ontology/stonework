	a owl:DatatypeProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Event
			stonework:Incident
		) ;
	] ;
	rdfs:range xsd:string ;
	skos:definition "The assessed severity of the incident or event (e.g. critical, high, medium, low, informational)."@en ;
	skos:prefLabel "severity"@en ;
