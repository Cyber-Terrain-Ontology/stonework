@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/stonework#>
	a owl:Ontology ;
	rdfs:label "STONEWORK"@en ;
	dcterms:creator "Hohimer Intelligence Strategies LLC" ;
	dcterms:description "A semantic threat ontology and research framework that serves as the ground-truth model for cyber threat intelligence in the CyberTerrain ecosystem. It provides an extensible foundation for modeling cyber threat intelligence concepts, objects, relationships, workflows, and knowledge, and aligns with established CTI framework ontologies — including STONES (STIX 2.1), ATT&CK, CAPEC, CWE, CVE, and CPE — as authoritative reference vocabularies rather than ontologies it imports and extends." ;
	dcterms:license <https://opensource.org/licenses/MIT> ;
	dcterms:title "STONEWORK — Semantic Threat Ontology and Research Framework"@en ;
	owl:versionIRI <https://cyberterrain.org/ns/stonework/0.6.1> ;
	owl:versionInfo "0.6.1" ;
	.

stonework:AIAgent
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	skos:definition "An autonomous or semi-autonomous system driven by AI/ML that can act, make decisions, or be attributed responsibility in a cyber or sociotechnical context." ;
	skos:prefLabel "AI Agent" ;
	skos:scopeNote "Covers both offensive uses (AI-assisted or autonomous threat actors) and defensive uses (AI-driven detection, response, or hunting systems). Distinct from Tool — an AIAgent has a degree of autonomous decision-making rather than being a passively invoked artifact."@en ;
	.

stonework:AITechnique
	a owl:Class ;
	rdfs:subClassOf stonework:Technique ;
	skos:definition "A specific method by which adversaries attack AI/ML systems (e.g., training data poisoning, adversarial examples, model extraction)."@en ;
	skos:prefLabel "AI Technique"@en ;
	.

stonework:AccessControlList
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A structured list of access control entries (ACEs) that governs which principals (users, groups, or system accounts) are permitted or denied specific operations on a resource."@en ;
	skos:prefLabel "Access Control List"@en ;
	skos:scopeNote "Applies across filesystems, operating system objects (registry keys, processes), network devices (firewall rules), cloud IAM policies, and APIs. In a CTI context, adversaries frequently modify ACLs to establish persistence, escalate privileges, or deny defenders access to compromised resources. Framework-specific extensions (e.g. Windows DACL/SACL structure) are modeled at the framework layer."@en ;
	.

stonework:Account
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalIdentity ;
	skos:definition "A named account held by an Agent with a provider — an authenticated-access identity, a value-holding ledger position, or both aspects together — identified by one or more Identifiers and optionally attributed to a known Agent."@en ;
	skos:prefLabel "Account"@en ;
	skos:scopeNote "Abstract parent of stonework:UserAccount (authenticated access) and stonework:FinancialAccount (value custody and movement). It exists chiefly to give stonework:hasAccount and stonework:accountOf a range spanning both without widening to every DigitalIdentity. A single real-world account often has both natures; model them as two individuals linked by stonework:controls rather than one individual of both types, since one login commonly governs several ledgers."@en ;
	.

stonework:Actuator
	a owl:Class ;
	rdfs:subClassOf stonework:PhysicalArtifact ;
	skos:definition "A physical device that effects a change in a physical process or plant — for example a valve, motor, relay, or servo — as distinct from a cyber security safeguard mechanism."@en ;
	skos:prefLabel "Actuator"@en ;
	skos:scopeNote "Use for ICS and OT field devices that act on a physical process. Distinct from stonework:SecurityActuator, which is deployed infrastructure that applies a countermeasure. A PLC or motor starter is an Actuator; an EDR agent or firewall is a SecurityActuator. An ICS device that also runs processes and participates in networks may additionally be typed as stonework:Host."@en ;
	.

stonework:Agent
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "Any entity that can act, perform actions, or be attributed responsibility in a cyber or sociotechnical context."@en ;
	skos:prefLabel "Agent" ;
	skos:scopeNote "Covers AI, human individuals, groups, organizations, and other actors (e.g. threat actors, vendors, government bodies). Used as the top-level superclass for identity-related objects in alignment with STIX Identity."@en ;
	.

stonework:Analysis
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "A systematic examination of a cyber entity, artifact, or event that produces structured findings about its nature, behavior, or properties."@en ;
	skos:prefLabel "Analysis"@en ;
	skos:scopeNote "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment answers 'how bad/likely/risky?', Analysis answers 'what is it and what does it do?' Superclass for domain-specific analyses such as MalwareAnalysis. Aligns with STIX MalwareAnalysis SDO at the subclass level."@en ;
	.

stonework:AnalyticTechnique
	a owl:Class ;
	rdfs:subClassOf stonework:Technique ;
	skos:definition "A prescribed analytical method used to process, evaluate, or reason over data to produce intelligence, detections, or assessments."@en ;
	skos:prefLabel "Analytic Technique" ;
	skos:scopeNote "Covers structured analytic techniques (e.g., analysis of competing hypotheses, kill chain analysis, diamond model analysis) and computational analytic methods (e.g., clustering, anomaly detection). Distinct from DetectionRule — an AnalyticTechnique describes the method; a DetectionRule is a deployable artifact implementing it."@en ;
	.

stonework:Assessment
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "A structured knowledge artifact capturing the evaluation, analysis, or estimation of risk, likelihood, impact, or other security-relevant attributes."@en ;
	skos:prefLabel "Assessment" ;
	skos:scopeNote "Covers risk assessments, vulnerability assessments, and impact analyses. Assessment is an Information artifact — the output of an evaluative process — not the process itself. The process producing an Assessment may be modeled as a stonework:Process or stonework:Investigation."@en ;
	.

stonework:AttackPattern
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	skos:definition "A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&CK techniques."@en ;
	skos:prefLabel "Attack Pattern"@en ;
	skos:scopeNote "The abstract concept spanning framework-specific shapes that are not structurally identical: CAPEC's shape (capec:AttackPattern) is a taxonomy entry with severity/likelihood/prerequisite fields; MITRE ATT&CK's shape (stonework:AttackTechnique) is an operationalized technique with sub-techniques, procedures, mitigations, and detections. Both are AttackPatterns; stonework:relatedAttackPattern links instances across shapes that describe the same underlying technique."@en ;
	.

stonework:AttackTechnique
	a owl:Class ;
	rdfs:subClassOf
		stonework:AttackPattern ,
		stonework:CyberTechnique
		;
	skos:definition "A prescribed offensive method used by an adversary to achieve a specific tactical objective within a target environment."@en ;
	skos:prefLabel "Attack Technique"@en ;
	skos:scopeNote "Aligns with MITRE ATT&CK techniques and D3FEND OffensiveTechnique. The MITRE ATT&CK-shaped realization of stonework:AttackPattern — operationalized for execution, as distinct from CAPEC's more abstract taxonomy-entry shape (capec:AttackPattern, also a stonework:AttackPattern). Framework-specific subclasses (e.g. attack:Technique) provide the concrete individuals. A specific, concrete realization of this technique is modeled as a stonework:Procedure, linked back via stonework:implementedBy."@en ;
	.

stonework:AutonomousSystem
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	skos:definition "Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number." ;
	skos:prefLabel "Autonomous System"@en ;
	.

stonework:BankAccountNumber
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "A domestic bank account number as issued under a national scheme, without IBAN normalization."@en ;
	skos:prefLabel "Bank Account Number"@en ;
	skos:scopeNote "The value is stonework:accountNumber. The routing context (US ABA routing number, UK sort code) is recorded on the holding stonework:FinancialInstitution via stonework:abaRoutingNumber or an equivalent, not on this identifier."@en ;
	.

stonework:Behavior
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A pattern of actions or methods characteristic of an entity, particularly adversaries."@en ;
	skos:prefLabel "Behavior" ;
	skos:scopeNote "Groups TTP-related classes: Tactic, Technique (and subclasses), and Procedure. In BFO terms, Behaviors are GenericallyDependentContinuants — specifications or patterns describing how actions are carried out. The execution of a Technique is a CyberActivity; the Technique itself is a Behavior. Aligns with IAO PlanSpecification."@en ;
	.

stonework:BomEntry
	a owl:Class ;
	rdfs:subClassOf stonework:ComponentContext ;
	rdfs:comment "BomEntry is the STONEWORK representation of a CycloneDX component element or SPDX package entry. It links a VersionedProduct into the context of a particular SBOM document via stonework:installationOf, and may carry component-specific metadata (PURL, license, hash, component type) that does not belong on the VersionedProduct itself."@en ;
	skos:definition "A single component entry within a Software Bill of Materials, asserting that a specific VersionedProduct is included in the artifact or system described by the SBOM."@en ;
	skos:prefLabel "BOM Entry" ;
	skos:scopeNote "An SBOM import creates one BomEntry per declared component. The BomEntry IRI is scoped to the SBOM (e.g. <sbom-iri/entry/<component-ref>>). Multiple BomEntry instances across different SBOMs may reference the same VersionedProduct via stonework:installationOf."@en ;
	.

stonework:Campaign
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	skos:definition "A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to ThreatActors and may form part of a broader CyberActivityCluster." ;
	skos:prefLabel "Campaign"@en ;
	skos:scopeNote "A Campaign is organized around an objective and time period, while a CyberActivityCluster is organized by analytic correlation. A Campaign that is one episode within a broader activity cluster is linked to it with stonework:memberOfActivityCluster. The same body of activity may be typed as both classes when both descriptions apply."@en ;
	.

stonework:Category
	a owl:Class ;
	rdfs:subClassOf
		skos:Concept ,
		stonework:CyberEntity ,
		[
			a owl:Restriction ;
			owl:onProperty skos:inScheme ;
			owl:hasValue stonework:categoryScheme ;
		]
		;
	skos:definition "A classification or tagging concept used to group or qualify other individuals in a particular context."@en ;
	skos:prefLabel "Category"@en ;
	skos:scopeNote "Categories are reified so they can be referenced, versioned, or scoped. They are not rigid types."@en ;
	.

stonework:Certificate
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A structured digital document binding a public key to an identity, issued and signed by a certificate authority. Used for authentication, encryption, and trust establishment in networked systems."@en ;
	skos:prefLabel "Certificate"@en ;
	skos:scopeNote "Primarily represents X.509 certificates. May be used to cluster infrastructure sharing the same certificate or to link observed TLS/SSL artifacts to their issuing authority. Referenced by stonework:sharesCertificate on Infrastructure. Represent certificate fingerprints through stonework:hasHash and a stonework:Hash individual rather than algorithm-specific fingerprint literals."@en ;
	.

stonework:City
	a owl:Class ;
	rdfs:subClassOf stonework:Location ;
	skos:definition "A significant urban settlement, municipality, or metropolitan area." ;
	skos:prefLabel "City" ;
	.

stonework:ComparisonOperator
	a owl:Class ;
	skos:definition "A controlled vocabulary of operators used to compare a Variable's bound value against a threshold in a Transition guard."@en ;
	skos:prefLabel "Comparison Operator" ;
	skos:scopeNote "Individuals are stonework:Equals, stonework:NotEquals, stonework:LessThan, stonework:LessThanOrEqual, stonework:GreaterThan, and stonework:GreaterThanOrEqual. Referenced by stonework:guardOperator; omitting an operator on a guard defaults to Equals semantics."@en ;
	.

stonework:ComponentContext
	a owl:Class ;
	skos:definition "An abstract class representing a context-specific reference to a VersionedProduct: the same product version appears differently depending on whether it is declared in a bill of materials or observed as a running installation on a specific system."@en ;
	skos:prefLabel "Component Context" ;
	skos:scopeNote "Subclassed by stonework:BomEntry (declarative — listed in an SBOM document) and stonework:ProductInstallation (observational — verified deployment via SWID tag or scan). Unifies these two evidence bases under a single superclass so that stonework:installationOf can span both without domain restrictions forcing incorrect inferences."@en ;
	.

stonework:Control
	a owl:Class ;
	rdfs:subClassOf
		stonework:Behavior ,
		stonework:Countermeasure
		;
	rdfs:comment 'Instances of stonework:Control may represent individual controls, control enhancements, or sub‑controls. Framework‑specific identifiers (e.g., "AC‑2", "CIS 4.1") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Control text SHOULD be referenced via citations rather than reproduced verbatim.' ;
	skos:definition "A prescribed security or privacy safeguard that specifies an action, capability, or condition intended to reduce risk, enforce policy, or achieve a defined protection objective within an information system or organization." ;
	skos:prefLabel "Control" ;
	skos:scopeNote "This class provides a semantic representation of security and privacy controls from frameworks such as NIST SP 800‑53 and the CIS Controls. It supports mapping to external control identifiers and families without embedding copyrighted control text." ;
	.

stonework:ControlPlan
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	skos:definition "A concrete, Step-decomposed sequence of actions that implements a Control in a specific operational context."@en ;
	skos:prefLabel "Control Plan" ;
	skos:scopeNote "Mirrors the Technique/Procedure split on the defensive side: stonework:Control is the abstract prescribed safeguard (a catalog entry, e.g. NIST AC-2 or a CIS control); ControlPlan is its concrete implementation as a Step sequence, linked back via stonework:implements. A ControlPlan is typically invoked from within a Playbook or DetectionPlan by a Step that stonework:implements it."@en ;
	.

stonework:Countermeasure
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "Any control, mitigation, or safeguard applied to protect against, reduce, or respond to security risks."@en ;
	skos:prefLabel "Countermeasure" ;
	skos:scopeNote "Includes Controls, Mitigations, CoursesOfAction, and DetectionRules. The two primary branches are preventive/reactive measures (Mitigation, CourseOfAction, Control) and detection logic (DetectionRule, Signature). A Countermeasure describes the safeguard or procedure; the deployed mechanism that can apply it is a stonework:SecurityActuator, and a particular application is a stonework:SecurityActuation."@en ;
	.

stonework:Country
	a owl:Class ;
	rdfs:subClassOf stonework:Location ;
	skos:definition "A sovereign state or top-level administrative entity recognized internationally." ;
	skos:prefLabel "Country" ;
	.

stonework:CourseOfAction
	a owl:Class ;
	rdfs:subClassOf stonework:Mitigation ;
	skos:definition "A specific, contextualized recommended action or set of steps to prevent or respond to a threat, attack, or incident."@en ;
	skos:prefLabel "Course of Action"@en ;
	skos:scopeNote "More prescriptive and situational than a general Mitigation — a CourseOfAction packages guidance for a specific threat context. Corresponds to the STIX 2.1 CourseOfAction SDO. General reusable controls (e.g. ATT&CK mitigations) are modeled as Mitigation; specific incident response actions are CourseOfAction."@en ;
	.

stonework:CryptoAddress
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "An on-chain address that identifies a destination for value on a distributed ledger."@en ;
	skos:prefLabel "Crypto Address"@en ;
	skos:scopeNote "The address string is stonework:walletAddress. Attach a CryptoAddress to the wallet it identifies, a stonework:FinancialAccount, with stonework:hasIdentifier; the address's asset and network are then traversable through ^stonework:hasIdentifier/stonework:accountCurrency and stonework:blockchainNetwork. Sibling of stonework:EmailAddress and stonework:MACAddress."@en ;
	.

stonework:CryptoAsset
	a owl:Class ;
	rdfs:subClassOf stonework:Currency ;
	skos:altLabel "virtual asset"@en ;
	skos:definition "A cryptocurrency, stablecoin, or other token that serves as a unit of value on a distributed ledger."@en ;
	skos:prefLabel "Crypto Asset"@en ;
	skos:scopeNote "Instances are the assets themselves (e.g. Bitcoin, Ether, a specific ERC-20 token) — not wallets, addresses, or holdings. A wallet is modeled as a stonework:FinancialAccount and its address as a stonework:CryptoAddress; an amount of a crypto asset is a stonework:MonetaryAmount whose stonework:currency is the CryptoAsset. The same nominal token issued on multiple ledgers is modeled as distinct individuals distinguished by stonework:blockchainNetwork. 'Virtual asset' is the FATF term; a service that custodies or exchanges them is a virtual asset service provider (stonework:FinancialInstitution categorized accordingly)."@en ;
	.

stonework:Currency
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A unit in which monetary value is denominated — a fiat currency or a crypto asset."@en ;
	skos:prefLabel "Currency"@en ;
	skos:scopeNote "The range of stonework:currency on stonework:MonetaryAmount. Fiat units are supplied as a closed controlled vocabulary in stonework:fiatCurrencyScheme (ISO 4217). Crypto units are stonework:CryptoAsset individuals, created as needed rather than pre-enumerated. Currency itself carries no instances directly."@en ;
	.

stonework:CyberActivity
	a owl:Class ;
	skos:definition "A specific occurrence or performance of actions by one or more agents over time within a cyber or sociotechnical context."@en ;
	skos:prefLabel "Cyber Activity" ;
	skos:scopeNote "One of two root classes in STONEWORK alongside CyberEntity. Superclass for Campaigns, CyberActivityClusters, Incidents, Operations, Events, and Processes. Aligns with BFO Occurrent and BFO Process."@en ;
	.

stonework:CyberActivityCluster
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	skos:definition "An analytically identified aggregate of cyber activities grouped because available evidence suggests a common source, mechanism, or operational thread."@en ;
	skos:prefLabel "Cyber Activity Cluster"@en ;
	skos:scopeNote "A CyberActivityCluster is unified by analytic correlation rather than the objective and time period of a Campaign, the unified command or intent of an Operation, the execution sequence of a Process, or the inquiry purpose of an Investigation. It does not require a known objective, responsible Agent, precise boundaries, or a conclusion that the activity is adversarial. It denotes the body of activity believed to be related, not the intelligence artifact recording that judgment; use stonework:Grouping, stonework:Report, or stonework:Assessment for the artifact. Only CyberActivity instances are members through stonework:memberOfActivityCluster and stonework:hasMemberActivity; relate tools, malware, infrastructure, and responsible participants through their specific relationships. The STIX adapter maps its narrower intrusion-set source class to CyberActivityCluster."@en ;
	.

stonework:CyberEntity
	a owl:Class ;
	skos:definition "Any concept, object, or resource that exists or operates within a cyber or sociotechnical domain."@en ;
	skos:prefLabel "Cyber Entity" ;
	skos:scopeNote "One of two root classes in STONEWORK. Groups all persistent entities — Agents, Infrastructure, DigitalArtifacts, PhysicalArtifacts, Behaviors, IntelligenceProducts, SecurityConditions, RiskFactors, Countermeasures, and related classes. Aligns with BFO Continuant. The sibling root class CyberActivity covers happenings (Campaigns, Incidents, Operations, etc.)."@en ;
	.

stonework:CyberTechnique
	a owl:Class ;
	rdfs:subClassOf stonework:Technique ;
	skos:definition "A technique performed within or against cyberspace, encompassing both offensive and defensive cyber operations." ;
	skos:prefLabel "Cyber Technique" ;
	skos:scopeNote "Mirrors D3FEND's CyberTechnique class. Subclassed by stonework:AttackTechnique (offensive) and stonework:DefendTechnique (defensive), enabling a single property chain to span both ATT&CK and D3FEND individuals." ;
	.

stonework:DataAsset
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A defender-owned collection of data or information with organizational value, such as databases, intellectual property, credentials stores, or PII collections."@en ;
	skos:prefLabel "Data Asset" ;
	skos:scopeNote "Represents data as a targetable resource distinct from the systems that store or process it. Used to model what adversaries seek to access, exfiltrate, or destroy rather than the infrastructure they exploit to reach it."@en ;
	.

stonework:DefendTechnique
	a owl:Class ;
	rdfs:subClassOf stonework:CyberTechnique ;
	skos:definition "A prescribed defensive method used to detect, prevent, or respond to adversary behavior within a target environment." ;
	skos:prefLabel "Defend Technique" ;
	skos:scopeNote "Aligns with MITRE D3FEND DefensiveTechnique. Framework-specific subclasses (e.g. d3fend:DefensiveTechnique) extend this class when D3FEND data is loaded." ;
	.

stonework:DefensiveTactic
	a owl:Class ;
	rdfs:subClassOf stonework:Tactic ;
	skos:definition "A high-level defensive objective that groups related countermeasure techniques by the protection goal they serve." ;
	skos:prefLabel "Defensive Tactic" ;
	skos:scopeNote "Aligns with MITRE D3FEND defensive tactics (e.g. Harden, Detect, Isolate, Evict, Restore). Individuals are typically drawn from D3FEND or similar defensive frameworks via the framework mapping layer."@en ;
	.

stonework:DetectionPlan
	a owl:Class ;
	rdfs:subClassOf stonework:InvestigationPlan ;
	skos:definition "A Step-decomposed sequence of actions for determining whether observed activity constitutes a security-relevant violation, as distinct from the offensive or defensive action plans that respond to one."@en ;
	skos:prefLabel "Detection Plan" ;
	skos:scopeNote "A specialization of stonework:InvestigationPlan narrowly scoped to violation triage: orchestrating DetectionRule/Signature evaluation and analytic logic to identify whether a violation occurred, typically triggering a defensive Playbook or ControlPlan via a guarded Transition once one is confirmed. Where a Playbook is an action plan carried out by an interested party — offensive (an adversary's operational playbook) or defensive (an incident responder's playbook) — a DetectionPlan plays a neutral, evaluative role, watching for the kind of changes an InvestigationPlan more broadly investigates."@en ;
	.

stonework:DetectionRule
	a owl:Class ;
	rdfs:subClassOf stonework:Countermeasure ;
	skos:definition "A structured, machine-readable rule designed to detect malicious or suspicious activity, techniques, or indicators. It may be signature-based, behavioral, correlation-based, or analytic."@en ;
	skos:prefLabel "Detection Rule" ;
	skos:scopeNote "Encompasses pattern-matching signatures (YARA, Snort, Suricata), behavioral rules (Sigma), SIEM correlation logic, and analytic detections. Signature is a subclass for content-centric, indicator-matching rules."@en ;
	.

stonework:DigitalArtifact
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "Any discrete digital object or content entity that can be observed, transmitted, stored, or acted upon in a cyber environment."@en ;
	skos:prefLabel "Digital Artifact" ;
	skos:scopeNote "Includes files, hashes, malware samples, network traffic captures, and other content-bearing items. Aligns with D3FEND DigitalArtifact concepts. Sibling of stonework:PhysicalArtifact."@en ;
	.

stonework:DigitalIdentity
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	skos:definition "A digital representation or persona of an Agent, inferred from one or more identifiers (email, phone, account, etc.). It may or may not be attributed to a known real-world Agent." ;
	skos:prefLabel "Digital Identity" ;
	skos:scopeNote "Useful when you observe identifiers without confirmed attribution. Can aggregate multiple Identifiers and later be linked to a real-worldAgent."@en ;
	.

stonework:Directory
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:prefLabel "Directory" ;
	.

stonework:Domain
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	skos:definition "Represents a network domain name. Can reference the IP addresses it resolves to." ;
	skos:prefLabel "Domain"@en ;
	.

stonework:EmailAddress
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "Represents a single email address, optionally associating it with a display name and a user account." ;
	skos:prefLabel "Email Address"@en ;
	.

stonework:EmailMessage
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A discrete email communication, including headers, body content, and optional attachments, transmitted over an email protocol."@en ;
	skos:prefLabel "Email Message"@en ;
	skos:scopeNote "Distinct from stonework:EmailAddress, which represents the sender/recipient identifier. An EmailMessage is the content artifact itself. Used to represent phishing lures, spear-phishing emails, or other email-borne threat delivery mechanisms. Corresponds to STIX EmailMessage SCO."@en ;
	.

stonework:Equals
	a
		owl:NamedIndividual ,
		stonework:ComparisonOperator
		;
	skos:definition "The guardVariable's bound value equals guardLiteralValue."@en ;
	skos:notation "eq" ;
	skos:prefLabel "Equals"@en ;
	.

stonework:Event
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	skos:definition "An atomic, observable occurrence in a system, network, or environment that has potential security relevance but has not yet been assessed or declared as an Incident."@en ;
	skos:prefLabel "Event"@en ;
	skos:scopeNote "Represents the pre-triage state — a raw log entry, alert, or sensor observation. Distinguished from Incident by the absence of human or automated assessment declaring it significant and adverse. Useful for SIEM, log-based, and threat hunting use cases."@en ;
	.

stonework:Feed
	a owl:Class ;
	rdfs:subClassOf stonework:Provenance ;
	skos:definition "A structured data source that provides indicators, intelligence, or enrichment data on a regular or continuous basis." ;
	skos:prefLabel "Feed" ;
	skos:scopeNote "Examples: URLHaus, AlienVault OTX, Abuse.ch, commercial threat feeds, etc."@en ;
	.

stonework:File
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A discrete unit of data stored on a filesystem, identified by name, path, and cryptographic hash. Includes executable binaries, scripts, documents, archives, and other file types relevant to cyber threat analysis."@en ;
	skos:prefLabel "File"@en ;
	skos:scopeNote "Linked to hash values via stonework:hasHash. A MalwareSample may be associated with its File representation. Framework-specific extensions (PE headers, NTFS streams, archive contents) are modeled at the framework layer."@en ;
	.

stonework:FinancialAccount
	a owl:Class ;
	rdfs:subClassOf stonework:Account ;
	skos:definition "An account that can hold a balance of, or transfer, economic value — fiat currency, cryptocurrency, or monetary-equivalent stored value such as gift-card credit, gaming currency, or loyalty points redeemable for goods."@en ;
	skos:prefLabel "Financial Account"@en ;
	skos:scopeNote "Defined by function, not by the holder: an account at a regulated bank, brokerage, or exchange and a stored-value balance at a non-financial merchant are both FinancialAccounts. Whether it is held at a regulated institution is recorded with the optional stonework:heldAt link, not by the class. Account kind (checking, custodial wallet, prepaid card, exchange account) is asserted with stonework:categorizedBy a stonework:FinancialAccountType. Identifiers such as an IBAN, domestic account number, or crypto address attach with stonework:hasIdentifier. Use stonework:accountCurrency for each currency or crypto asset the account holds or is denominated in; it is intentionally multi-valued. Balance over time is a stonework:MetricObservation. A crypto wallet is a FinancialAccount; its on-chain address is a stonework:CryptoAddress."@en ;
	.

stonework:FinancialInstitution
	a owl:Class ;
	rdfs:subClassOf stonework:Organization ;
	skos:definition "An organization whose business is holding, moving, exchanging, or safeguarding financial assets on behalf of others — a bank, credit union, broker-dealer, payment processor, money services business, or virtual asset service provider."@en ;
	skos:prefLabel "Financial Institution"@en ;
	skos:scopeNote "The natural bearer of institution identifiers (stonework:bic, stonework:abaRoutingNumber) that should not broaden bare stonework:Organization, and the range of stonework:heldAt. Institution kind is asserted with stonework:categorizedBy a stonework:FinancialInstitutionType. The Legal Entity Identifier is a general organization identifier (stonework:lei), not institution-specific."@en ;
	.

stonework:FinancialTransaction
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	skos:definition "A movement of economic value from one financial account to another, occurring over a definite period and optionally attributed to the agents responsible for initiating it."@en ;
	skos:prefLabel "Financial Transaction"@en ;
	skos:scopeNote "An occurrent: it starts and settles at a time (stonework:startedAtTime and stonework:endedAtTime), is attributed with stonework:attributedTo, and can be sighted, investigated, and grouped into a stonework:CyberActivityCluster. Originator and beneficiary are given by stonework:originatorAccount and stonework:beneficiaryAccount; correspondent hops by stonework:intermediaryAccount. The transferred value is a stonework:MonetaryAmount via stonework:hasMonetaryValue. Use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue when the debited input and credited output differ, as in a currency exchange. Flat stonework:transactionAmount and stonework:transactionCurrency are convenience projections only for a single-denomination transfer. A blockchain transaction is a FinancialTransaction whose accounts are crypto wallets. Divergent source records of one economic event are handled through stonework:hasProvenance and stonework:Sighting rather than a distinct record class. Use stonework:hasBehavior to link a transaction, or a cluster of them, to a stonework:IllicitFinanceTechnique it exhibits. Use stonework:fundsActivity only when the transaction finances an activity; use stonework:respondsToActivity when a transaction occurs in response to an activity, such as a victim's ransom payment."@en ;
	.

stonework:GranularMarking
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A marking application that assigns a data-handling marking to selected fields or portions of another cyber entity."@en ;
	skos:prefLabel "Granular Marking"@en ;
	skos:scopeNote "Represents the structural application of a marking, including its selectors and referenced marking definition. It is distinct from a stonework:Markings category value, which expresses the handling designation itself."@en ;
	.

stonework:GreaterThan
	a
		owl:NamedIndividual ,
		stonework:ComparisonOperator
		;
	skos:definition "The guardVariable's bound value is greater than guardLiteralValue."@en ;
	skos:notation "gt" ;
	skos:prefLabel "Greater Than"@en ;
	.

stonework:GreaterThanOrEqual
	a
		owl:NamedIndividual ,
		stonework:ComparisonOperator
		;
	skos:definition "The guardVariable's bound value is greater than or equal to guardLiteralValue."@en ;
	skos:notation "ge" ;
	skos:prefLabel "Greater Than Or Equal"@en ;
	.

stonework:Group
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	skos:definition "Any collection of Persons, Organizations, or other Groups that share a common purpose or identity but do not necessarily have formal legal structure."@en ;
	skos:prefLabel "Group" ;
	skos:scopeNote "Used for informal collectives, communities, ad-hoc teams, criminal syndicates, or loose alliances. More general than Organization. Can contain other Groups or Organizations."@en ;
	.

stonework:Grouping
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "A structured intelligence product that asserts shared context among a set of referenced cyber threat intelligence entities."@en ;
	skos:prefLabel "Grouping"@en ;
	skos:scopeNote "Use when related objects need to be collected without the narrative and publication semantics of a Report. Corresponds to the STIX 2.1 Grouping SDO."@en ;
	.

stonework:Hash
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "A single cryptographic hash entry associating a hashing algorithm with its hex-encoded digest value. Used to represent entries in the STIX hashes dictionary." ;
	skos:prefLabel "Hash"@en ;
	.

stonework:Host
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	skos:definition "A computing system, device, or endpoint (physical, virtual, container, or cloud instance) that can run processes, host files, and participate in networks."@en ;
	skos:prefLabel "Host"@en ;
	.

stonework:HumanSource
	a owl:Class ;
	rdfs:subClassOf stonework:Provenance ;
	skos:definition "A person who provides information, intelligence, or a report (as opposed to automated feeds or technical artifacts)." ;
	skos:prefLabel "Human Source" ;
	skos:scopeNote "Often used in HUMINT or OSINT contexts. Reliability scoring is commonly applied to human sources."@en ;
	.

stonework:Hypothesis
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "A structured, falsifiable prediction about the value a Variable will resolve to once the Behavior or Step declaring that Variable executes."@en ;
	skos:prefLabel "Hypothesis" ;
	skos:scopeNote "Formalizes the anticipated side of the Variable lifecycle described in stonework:Variable's scopeNote: a Hypothesis names, in advance, the value an output Variable is predicted to be bound to. Linked to the Variable it predicts via stonework:predictsVariable, and to the prediction itself via stonework:predictedType (a class, the common case — mirrors stonework:guardType), stonework:predictedValue (a specific individual), or stonework:predictedLiteral (a scalar) — mirroring stonework:boundTo/stonework:boundToLiteral on the actual-result side. A Transition's guard properties, which test a Variable's actual bound value, implicitly test agreement with whichever Hypothesis predicted that Variable — confirming it if they match, refuting it otherwise. May attach at any level of a Step/Plan decomposition, since stonework:Step is itself a stonework:Behavior."@en ;
	.

stonework:IBAN
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "An International Bank Account Number (ISO 13616): the cross-jurisdiction normalized identifier for a bank account."@en ;
	skos:prefLabel "IBAN"@en ;
	skos:scopeNote "The value is stonework:iban. A single stonework:FinancialAccount may carry both an IBAN and one or more domestic identifiers (stonework:BankAccountNumber) via stonework:hasIdentifier; the IBAN is the normalized form that reconciles differing national account-number formats."@en ;
	.

stonework:IPAddress
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	skos:definition "Represents a single IP address (IPv4 or IPv6)."@en ;
	skos:prefLabel "IP Address"@en ;
	.

stonework:IPBlock
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	skos:definition "A Classless Inter-Domain Routing (CIDR) block used to represent an IP network range."@en ;
	skos:prefLabel "IP Block"@en ;
	.

stonework:Identifier
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A first-class representation of a security-relevant identifier value, such as an email address, cryptographic hash, MAC address, phone number, URI, or user-agent string."@en ;
	skos:prefLabel "Identifier" ;
	skos:scopeNote "Identifier does not provide the RDF identity of every CyberEntity and does not imply that every CyberEntity has an Identifier. Named RDF resources are identified by their IRIs; identifiers originating in external systems are recorded with dcterms:identifier or stonework:externalId. Use the most specific available subclass, such as EmailAddress, Hash, MACAddress, PhoneNumber, URI, or UserAgent. Instantiate Identifier directly only when the identifier type is unknown or no suitable subclass exists."@en ;
	.

stonework:IllicitFinanceTechnique
	a owl:Class ;
	rdfs:subClassOf stonework:Technique ;
	skos:definition "A prescribed method for disguising the origin, ownership, or destination of illicitly obtained funds, or for moving value while evading financial controls."@en ;
	skos:prefLabel "Illicit Finance Technique"@en ;
	skos:scopeNote "Covers money-laundering typologies and the adjacent methods of terrorist financing, sanctions evasion, and financial fraud. A neutral structural slot: STONEWORK defines the class but not its individuals. A starter set of FATF-derived typology individuals is supplied by the optional frameworks/fatf.ttl module; other bodies' typology sets can populate the same class. Link an exhibiting stonework:FinancialTransaction or stonework:CyberActivityCluster with stonework:hasBehavior. Because the class sits under stonework:Technique, a concrete laundering chain can later be modeled as a stonework:Procedure that stonework:implements a typology, with no rework."@en ;
	.

stonework:Impact
	a owl:Class ;
	rdfs:subClassOf stonework:RiskFactor ;
	rdfs:comment "Instances of stonework:Impact SHOULD specify the affected asset or mission, the type of consequence, and the severity level. Impact SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
	skos:definition "The magnitude of harm, loss, or adverse effects that would result if a threat were realized and a compromise occurred, expressed in terms of mission, business, operational, or technical consequences." ;
	skos:prefLabel "Impact" ;
	skos:scopeNote "Impact represents the severity of consequences associated with a compromise. It may include effects on confidentiality, integrity, availability, safety, mission success, financial loss, or reputational damage. Impact values may be qualitative or quantitative." ;
	.

stonework:Incident
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	skos:definition "A significant adverse event or series of related events that has caused, or has the potential to cause, harm to an organization’s operations, assets, or people."@en ;
	skos:prefLabel "Incident" ;
	skos:scopeNote "Distinguished from stonework:Event (a raw, unassessed occurrence) by the presence of human or automated triage declaring significance and adversity. An Incident may aggregate multiple Events, involve one or more Campaigns, and trigger Investigation and Playbook execution."@en ;
	.

stonework:Indicator
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "An intelligence assertion that a pattern — atomic, expression-based, or behavioral — when matched in an observed environment, indicates the presence of threat activity attributable to a specific adversary behavior, malware, or campaign."@en ;
	skos:prefLabel "Indicator"@en ;
	skos:scopeNote "The central concept in operational CTI. The term is used by the community in three overlapping senses, all of which stonework:Indicator covers: (1) IOC sense — an atomic observable (IP address, domain, file hash, URL) that has been assessed as malicious or suspicious and tagged for detection; in STONEWORK the underlying observable is the SCO (stonework:IPAddress, stonework:Domain, stonework:Hash), and the Indicator wraps it with the assertion, confidence, and validity window. (2) Pattern sense — a STIX patterning expression over one or more SCOs (e.g., [ipv4-addr:value = ‘198.51.100.0/24’]). (3) Behavioral sense — a multi-step or TTPs-based pattern asserting that an observed sequence of behaviors indicates a technique or campaign. Distinct from stonework:DetectionRule: an Indicator is the intelligence claim (‘look for this’); a DetectionRule is the operational artifact that implements the check (‘here is the Sigma/Snort/YARA rule that looks for it’). Indicators are produced by threat intelligence analysts and consumed by detection pipelines; DetectionRules are deployed in SIEMs, EDRs, and network sensors. Corresponds to STIX 2.1 Indicator SDO. Use stonework:indicates to link an Indicator to the AttackPattern, Malware, Campaign, or ThreatActor it asserts."@en ;
	.

stonework:Infrastructure
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "Represents systems, software services, or any group of resources used to conduct cyber operations. Infrastructure is used by threat actors and intrusion sets both offensively and defensively." ;
	skos:prefLabel "Infrastructure"@en ;
	.

stonework:IntelligenceProduct
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A structured artifact produced by an intelligence or analytical process, intended to convey findings, assessments, observations, or sourcing context to support decision-making."@en ;
	skos:prefLabel "Intelligence Product"@en ;
	skos:scopeNote "The intelligence product hierarchy covers the outputs of the intelligence lifecycle: Reports, Assessments, Sightings, Notes, and Provenance records. Distinguished from stonework:DigitalArtifact (raw observable technical data) and stonework:Behavior (plan specifications and TTP patterns). Intelligence products are the result of human or automated analytical work applied to raw data — they carry judgment, context, and traceability that raw artifacts do not."@en ;
	.

stonework:Investigation
	a owl:Class ;
	rdfs:subClassOf stonework:Process ;
	skos:definition "A systematic Process of inquiry, evidence collection, analysis, hypothesis testing, and conclusion to understand, attribute, or resolve security incidents, threats, anomalies, or other matters of interest." ;
	skos:prefLabel "Investigation" ;
	skos:scopeNote "Includes digital forensics, threat hunting, root cause analysis, and incident investigations. Links to Sightings, Evidence (via categorizedBy), Sensors, and produces Findings or updated Assessments."@en ;
	.

stonework:InvestigationPlan
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:comment "An InvestigationPlan is a plan specification; executing one produces an instance of stonework:Investigation."@en ;
	skos:definition "A Step-decomposed sequence of actions for systematically examining a cyber entity, artifact, or event to determine its nature, extent, or significance."@en ;
	skos:prefLabel "Investigation Plan" ;
	skos:scopeNote "The general assessment-plan counterpart to stonework:Playbook on the production side: where a Playbook's execution changes state in the world, an InvestigationPlan's execution (a stonework:Investigation) produces judgment about something that already exists or happened — typically a stonework:Analysis or stonework:Assessment. stonework:DetectionPlan is a specialized subclass, narrowly scoped to determining whether observed activity constitutes a security-relevant violation; broader analytical work (forensic analysis, malware analysis, vulnerability assessment) is modeled directly as InvestigationPlan."@en ;
	.

stonework:LaunderingStage
	a owl:Class ;
	rdfs:subClassOf stonework:Tactic ;
	skos:definition "One of the classic phases of a money-laundering scheme — placement, layering, or integration — grouping the techniques that serve that phase's objective."@en ;
	skos:prefLabel "Laundering Stage"@en ;
	skos:scopeNote "The illicit-finance counterpart of stonework:OffensiveTactic: a high-level objective that groups stonework:IllicitFinanceTechnique individuals via stonework:hasTechnique. A neutral structural slot; the three canonical individuals are supplied by frameworks/fatf.ttl."@en ;
	.

stonework:LessThan
	a
		owl:NamedIndividual ,
		stonework:ComparisonOperator
		;
	skos:definition "The guardVariable's bound value is less than guardLiteralValue."@en ;
	skos:notation "lt" ;
	skos:prefLabel "Less Than"@en ;
	.

stonework:LessThanOrEqual
	a
		owl:NamedIndividual ,
		stonework:ComparisonOperator
		;
	skos:definition "The guardVariable's bound value is less than or equal to guardLiteralValue."@en ;
	skos:notation "le" ;
	skos:prefLabel "Less Than Or Equal"@en ;
	.

stonework:Likelihood
	a owl:Class ;
	rdfs:subClassOf stonework:RiskFactor ;
	rdfs:comment "Instances of stonework:Likelihood may incorporate assumptions, uncertainty, adversary behavior, historical frequency, or environmental conditions. Likelihood SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
	skos:definition "The estimated probability, plausibility, or frequency with which a threat could be realized and lead to a compromise under specified conditions." ;
	skos:prefLabel "Likelihood" ;
	skos:scopeNote "Likelihood reflects the chance that a compromise will occur, considering adversary capability, intent, opportunity, preconditions, and environmental factors. Likelihood values may be qualitative, ordinal, or quantitative." ;
	.

stonework:Location
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "Represents a geographic location. May be as specific as a latitude/longitude coordinate or as broad as a continent. At least one of region, country, or latitude/longitude must be provided." ;
	skos:prefLabel "Location"@en ;
	skos:scopeNote "STONEWORK Location is a STIX-style geographic designator, not a BFO Site of occupancy. The BFO adapter maps it to an information content entity that denotes a place."@en ;
	.

stonework:Log
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A structured or semi-structured record of events, actions, or state changes generated by a system, application, or network component over time."@en ;
	skos:prefLabel "Log"@en ;
	skos:scopeNote "Logs are primary data sources for detection, investigation, and threat hunting. Examples include system event logs, authentication logs, DNS query logs, firewall logs, and application logs. Distinct from NetworkTraffic (which captures raw packet data) and from Event (which represents a parsed, security-relevant occurrence derived from log data)."@en ;
	.

stonework:MACAddress
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "A media access control address that identifies a network interface at the data-link layer."@en ;
	skos:prefLabel "MAC Address"@en ;
	skos:scopeNote "Covers 48-bit and 64-bit MAC address representations, including values carried by the STIX 2.1 MAC Address SCO."@en ;
	.

stonework:Malware
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A software object intended to perform malicious functions within, or on behalf of, a threat actor. Encompasses both abstract family-level concepts and concrete specimen-level artifacts."@en ;
	skos:prefLabel "Malware"@en ;
	skos:scopeNote "Parent class for stonework:MalwareFamily (STIX is_family=true) and stonework:MalwareSample (STIX is_family=false). Corresponds to the STIX 2.1 malware SDO. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware). Use stonework:hasArtifact to link a sample to its captured binary."@en ;
	.

stonework:MalwareAnalysis
	a owl:Class ;
	rdfs:subClassOf stonework:Analysis ;
	skos:definition "A structured record of findings from static or dynamic analysis performed on a malware specimen or family, including the tool used, analysis configuration, and verdict."@en ;
	skos:prefLabel "Malware Analysis"@en ;
	skos:scopeNote "Captures the output of a single analysis run: antivirus scan, sandbox execution, reverse-engineering session, etc. Key properties include the analysis product and version, the result verdict (malicious/suspicious/benign/unknown), and references to SCOs observed during analysis. Corresponds to STIX 2.1 MalwareAnalysis SDO."@en ;
	.

stonework:MalwareFamily
	a owl:Class ;
	rdfs:subClassOf
		stonework:Malware ,
		stonework:Product
		;
	skos:definition "An abstract malware concept representing a named strain, lineage, or campaign of malicious software sharing common behavioral patterns, code ancestry, or infrastructure. Corresponds to STIX 2.1 malware SDO with is_family=true."@en ;
	skos:prefLabel "Malware Family"@en ;
	skos:scopeNote "Examples: Cobalt Strike, Mimikatz, WannaCry, BlackCat. A MalwareFamily does not have a specific hash or binary but may be linked to MalwareSample instances via the inverse of stonework:memberOfFamily. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware, stonework:Backdoor)."@en ;
	.

stonework:MalwareSample
	a owl:Class ;
	rdfs:subClassOf
		stonework:Malware ,
		stonework:VersionedProduct
		;
	skos:definition "A discrete, observable instance of malicious code — a specific binary, script, or executable artifact that can be identified by cryptographic hash, file characteristics, or behavioral signature."@en ;
	skos:prefLabel "Malware Sample"@en ;
	skos:scopeNote "Represents a concrete sample rather than an abstract family concept. A single MalwareFamily may have thousands of associated samples across versions, packers, and dropper variants. Samples are linked to their family via stonework:memberOfFamily and to their file representation via stonework:hasHash or a direct stonework:File association. Properties such as stonework:drops, stonework:downloads, and stonework:communicatesWith describe the behavior of this specific sample, not the family in general."@en ;
	.

stonework:MetricObservation
	a owl:Class ;
	rdfs:subClassOf stonework:QualifiedAssertion ;
	skos:definition "A qualified, time-stamped metric value about a cyber entity, carrying its metric type, source provenance, and optional calculation-model version."@en ;
	skos:prefLabel "Metric Observation"@en ;
	skos:scopeNote "Use for values that change over time or differ by source, including EPSS probability, KEV membership, confidence, likelihood, risk scores, and normalized monetary valuations. A stonework:metricNormalizedValue observation records its output currency with stonework:valuationCurrency. Direct datatype properties remain convenience projections for consumers that need a single current value."@en ;
	.

stonework:MetricType
	a owl:Class ;
	rdfs:subClassOf
		stonework:Category ,
		[
			a owl:Restriction ;
			owl:onProperty skos:inScheme ;
			owl:hasValue stonework:metricTypeScheme ;
		]
		;
	skos:definition "A controlled classification identifying the meaning and scale of a qualified metric observation."@en ;
	skos:prefLabel "Metric Type"@en ;
	.

stonework:Mitigation
	a owl:Class ;
	rdfs:subClassOf stonework:Countermeasure ;
	rdfs:seeAlso <https://csrc.nist.gov/glossary/term/mitigation> ;
	skos:definition "A deliberate action or control intended to reduce the likelihood, impact, or severity of a risk, threat, vulnerability, or adverse event."@en ;
	skos:prefLabel "Mitigation" ;
	skos:scopeNote "Mitigations are proactive or reactive measures applied to address weaknesses or threats. Examples include: applying a security patch, enabling MFA, deploying a firewall rule, isolating a compromised host, or training users. A Mitigation may be a reusable control (ATT&CK sense) or a specific situational action. CourseOfAction is a subclass for contextualized, packaged response actions."@en ;
	.

stonework:MobileDevice
	a owl:Class ;
	rdfs:subClassOf stonework:Host ;
	skos:definition "A portable computing device with wireless connectivity, typically used for communication, data processing, and accessing networks (e.g., smartphones, tablets, or laptops with cellular capability)."@en ;
	skos:prefLabel "Mobile Device" ;
	skos:scopeNote "In a cyber threat context, Mobile Devices are often treated as both endpoints (Infrastructure) and vectors for attacks (e.g., mobile malware, phishing, lost/stolen device risks). They may host UserAccounts, run Mobile Applications, and connect via cellular, Wi-Fi, or Bluetooth."@en ;
	.

stonework:MonetaryAmount
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A quantity of money: a decimal magnitude paired with the currency that denominates it."@en ;
	skos:prefLabel "Monetary Amount"@en ;
	skos:scopeNote "Reified so magnitude and currency always travel together, mirroring how stonework:Hash pairs algorithm and digest. Attached to a transaction, account, impact, or demand with stonework:hasMonetaryValue or a monetary-value role subproperty. The magnitude is stonework:amount and the unit is stonework:currency. A currency-normalized valuation of the same amount, for example its USD equivalent at a stated time and rate source, is a stonework:MetricObservation on this amount with stonework:valuationCurrency identifying the output currency."@en ;
	.

stonework:Mutex
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A named mutual exclusion object (mutex or semaphore) used by a process to prevent concurrent access to a shared resource. Commonly used as a malware indicator — malware families often create uniquely named mutexes to avoid re-infecting a host."@en ;
	skos:prefLabel "Mutex"@en ;
	skos:scopeNote "Mutex names serve as host-based indicators of compromise. A specific mutex name found on a system can be attributed to a known malware family. Corresponds to the STIX 2.1 Mutex SCO."@en ;
	.

stonework:NetworkService
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	skos:definition "A network-accessible service or endpoint provided by infrastructure, such as HTTP, DNS, or SSH servers."@en ;
	skos:prefLabel "Network Service" ;
	.

stonework:NetworkTraffic
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A captured or observed network traffic flow between source and destination endpoints, including protocol, ports, payload characteristics, and timing."@en ;
	skos:prefLabel "Network Traffic"@en ;
	skos:scopeNote "Distinct from stonework:Log (which captures parsed event records) and stonework:Event (a security-relevant occurrence). NetworkTraffic is the raw flow artifact. May carry indicators such as user-agent strings, URI patterns, or certificate fingerprints observable in transit."@en ;
	.

stonework:NotEquals
	a
		owl:NamedIndividual ,
		stonework:ComparisonOperator
		;
	skos:definition "The guardVariable's bound value does not equal guardLiteralValue."@en ;
	skos:notation "ne" ;
	skos:prefLabel "Not Equals"@en ;
	.

stonework:Note
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "A free-text annotation attached to one or more individuals to provide additional context, analyst commentary, caveats, or confidence assessments."@en ;
	skos:prefLabel "Note" ;
	skos:scopeNote "Notes are analyst-authored rather than machine-generated. They may express uncertainty, sourcing context, or interpretive observations that do not fit structured properties. Corresponds to STIX 2.1 Note SDO."@en ;
	.

stonework:OffensiveTactic
	a owl:Class ;
	rdfs:subClassOf stonework:Tactic ;
	skos:definition "A high-level adversary objective that groups related attack techniques by the goal they serve during an intrusion or operation." ;
	skos:prefLabel "Offensive Tactic" ;
	skos:scopeNote "Aligns with MITRE ATT&CK tactics (e.g. Initial Access, Execution, Lateral Movement) and D3FEND OffensiveTactic. Individuals are typically drawn from ATT&CK or similar offensive frameworks via the STONES or framework mapping layers."@en ;
	.

stonework:OnlineReference
	a owl:Class ;
	rdfs:subClassOf stonework:Provenance ;
	skos:definition "A reference to an external online resource (URL, article, post, etc.) used for provenance." ;
	skos:prefLabel "Online Reference" ;
	.

stonework:Operation
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	skos:definition "A coordinated set of activities conducted by one or more agents toward a defined objective, typically spanning multiple campaigns, incidents, or phases and characterized by unified command, intent, or resourcing."@en ;
	skos:prefLabel "Operation" ;
	skos:scopeNote "Operations are broader in scope than Campaigns — a single Operation may encompass multiple Campaigns executed over an extended period. Applies to both offensive operations (e.g. state-sponsored cyber operations) and defensive operations (e.g. incident response operations, threat hunting operations)."@en ;
	.

stonework:OperationPlan
	a owl:Class ;
	rdfs:subClassOf stonework:Playbook ;
	skos:definition "A Playbook specifically representing an adversary's operational plan — the offensive counterpart within the Playbook hierarchy."@en ;
	skos:prefLabel "Operation Plan" ;
	skos:scopeNote "Named to avoid colliding with the already-established stonework:AttackPattern and stonework:AttackTechnique, and to align with stonework:Operation, whose definition ('a coordinated set of activities... unified command, intent, or resourcing') describes the executed counterpart of an OperationPlan. Generic stonework:Playbook remains available for the undifferentiated or defensive case."@en ;
	.

stonework:Opinion
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "An analyst's epistemological stance on the correctness or credibility of information asserted in another intelligence object."@en ;
	skos:prefLabel "Opinion"@en ;
	skos:scopeNote "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment evaluates risk or impact, Opinion evaluates the reliability or accuracy of existing intelligence — e.g., 'I disagree with this threat score' or 'I believe this indicator attribution is incorrect'. Corresponds to STIX 2.1 Opinion SDO. The opinion value (strongly-agree to strongly-disagree) and explanation are captured via stones: properties."@en ;
	.

stonework:Organization
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	rdfs:seeAlso prov:Organization ;
	skos:definition "A formal or semi-formal structured entity such as a company, government agency, non-profit, military unit, or consortium with defined boundaries and usually legal identity."@en ;
	skos:prefLabel "Organization" ;
	skos:scopeNote "Corresponds to STIX Identity with identity_class = 'organization'. Includes corporations, government bodies, NGOs, universities, etc. Distinguished from Group by having more persistent structure, roles, and often legal standing."@en ;
	.

stonework:Person
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	rdfs:seeAlso prov:Person ;
	skos:definition "A single human individual."@en ;
	skos:prefLabel "Person" ;
	skos:scopeNote "Represents real named people (e.g. employees, threat actors, researchers). Does not include legal entities or groups. Corresponds to STIX Identity with identity_class = 'individual'."@en ;
	.

stonework:PhoneNumber
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "A telephone number used to contact or identify an Agent. Used for attribution, OSINT pivoting, and identity clustering."@en ;
	skos:prefLabel "Phone Number"@en ;
	.

stonework:PhysicalArtifact
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A discrete material object relevant to cyber operations — a device, appliance, plant component, or other physical artifact that can be observed, located, or acted upon."@en ;
	skos:prefLabel "Physical Artifact"@en ;
	skos:scopeNote "Sibling of stonework:DigitalArtifact. Covers ICS and OT assets such as PLCs, RTUs, safety systems, and HMIs, as well as other tangible devices in a cyber-physical environment. An ICS device that runs processes and participates in networks may also be typed as stonework:Host. Distinct from stonework:Infrastructure, which groups resources used to conduct cyber operations."@en ;
	.

stonework:Playbook
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:comment "A Playbook is a plan specification; executing one produces instances of stonework:Process. Playbooks are often versioned and tested before use."@en ;
	rdfs:seeAlso prov:Plan ;
	skos:definition "A documented, structured Behavior that defines a sequenced set of steps, decisions, and actions to be executed in response to a specific type of event, incident, or operational need."@en ;
	skos:prefLabel "Playbook" ;
	skos:scopeNote "A Playbook may be offensive (an adversary's operational playbook — see stonework:OperationPlan) or defensive (an incident response, threat hunting, or recovery playbook) — both are action plans carried out by an interested party, as distinct from stonework:DetectionPlan, which plays a neutral, evaluative role. A Playbook decomposes into Steps via stonework:hasStep; its actual execution is recorded as a stonework:Process."@en ;
	.

stonework:Procedure
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:comment "Procedures are instances or patterns of execution that realize a technique. They may include command lines, API calls, malware behaviors, or operator playbook steps. Procedures are distinct from techniques, which describe generalized methods." ;
	skos:definition "A concrete, observable sequence of actions, commands, or behaviors that implements a technique in a specific operational context." ;
	skos:prefLabel "Procedure" ;
	skos:scopeNote "One realization path for a single Technique — the specific commands, scripts, tools, or configuration that carry it out (e.g. the comsvcs.dll MiniDump way of doing OS Credential Dumping: LSASS Memory). Technique-scoped and typically linear. A Procedure may be only a prose description — the common case when ingesting MITRE ATT&CK procedure examples — or decomposed into stonework:Step individuals via stonework:hasStep for sub-step depth. Links to the Technique it operationalizes via stonework:implements or its specialization stonework:procedureFor. Distinct from stonework:Playbook / stonework:OperationPlan / stonework:ControlPlan, which are objective-scoped plans that orchestrate several Procedures or Techniques with branching, retry, and control flow; a Plan's Step commonly stonework:implements a Procedure." ;
	.

stonework:Process
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	rdfs:seeAlso
		prov:Activity ,
		<https://www.opmw.org/model/p-plan/>
		;
	skos:definition "An identifiable activity or sequence of activities performed over time by one or more agents to achieve an operational, security, or business objective. It transforms inputs (artifacts, data, configurations) into outputs and may be governed by plans, controls, or policies." ;
	skos:prefLabel "Process"@en ;
	skos:scopeNote "This class operates at the enterprise/operational level and is distinct from low-level runtime Process objects (e.g., STIX SCO Process). It is the execution-side counterpart to Behavior-side plan specifications such as Playbook, ControlPlan, and ThreatScenario — e.g. executing a Playbook produces a Process instance."@en ;
	.

stonework:Product
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	rdfs:comment "Instances of stonework:Product represent product families or lines (e.g. 'Apache Log4j', 'Windows 10'). Specific releases are modeled as stonework:VersionedProduct individuals related via stonework:versionOf. CPE entries with wildcard version components map to stonework:Product; entries with concrete versions map to stonework:VersionedProduct."@en ;
	owl:disjointWith stonework:VersionedProduct ;
	skos:definition "An abstract software, hardware, or firmware product line identified by vendor and product name, independent of any specific version or release. Represents the collection of all versioned releases built under that product identity."@en ;
	skos:prefLabel "Product" ;
	skos:scopeNote "stonework:Product does not carry version, update, edition, or other release-specific attributes. Those belong on stonework:VersionedProduct. The two classes are disjoint."@en ;
	.

stonework:ProductInstallation
	a owl:Class ;
	rdfs:subClassOf stonework:ComponentContext ;
	rdfs:comment "Represents the most granular product identity level: not what software exists, but where and how it is installed. Multiple ProductInstallation individuals may reference the same VersionedProduct."@en ;
	skos:definition "A specific installed instance of a VersionedProduct on a particular system or environment, as identified by a SWID tag or equivalent installation record."@en ;
	skos:prefLabel "Product Installation" ;
	skos:scopeNote "stonework:ProductInstallation is the intended target for SWID tag data. The installing system, path, licensee, and configuration details belong here rather than on stonework:VersionedProduct."@en ;
	.

stonework:Provenance
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "Structured source references used to record the origin and trustworthiness of data and relationships."@en ;
	skos:prefLabel "Provenance"@en ;
	skos:scopeNote "Includes Feeds, Publications, and URL References."@en ;
	.

stonework:Publication
	a owl:Class ;
	rdfs:subClassOf stonework:Provenance ;
	skos:definition "A structured intelligence artifact such as a blog post, advisory, report, or news article." ;
	skos:prefLabel "Publication" ;
	.

stonework:QualifiedAssertion
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A first-class record of an assertion or relationship that may carry provenance, time, and other context not represented by an unqualified binary property or scalar value."@en ;
	skos:prefLabel "Qualified Assertion"@en ;
	skos:scopeNote "Use assertionSubject, assertionObject, and assertionRelationType for generic directed relationships; subclasses may provide more specific structure. Use direct properties as query-friendly projections when their loss of source, time, or relationship context is acceptable. Provenance is optional in the baseline interoperability profile and required by the strict SHACL overlay."@en ;
	.

stonework:Region
	a owl:Class ;
	rdfs:subClassOf stonework:Location ;
	skos:definition "A sub-national territorial division such as a state, province, region, or governorate." ;
	skos:prefLabel "Region" ;
	.

stonework:Registry
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "Describes elements within the Windows configuration Registry system." ;
	skos:prefLabel "Registry" ;
	.

stonework:RegistryKey
	a owl:Class ;
	rdfs:subClassOf stonework:Registry ;
	skos:definition "A named key in a Windows Registry hierarchy that may contain subordinate keys and registry values."@en ;
	skos:prefLabel "Registry Key"@en ;
	.

stonework:RegistryValue
	a owl:Class ;
	rdfs:subClassOf stonework:Registry ;
	skos:definition "A named or default value stored beneath a Windows Registry key, including its value type and literal data."@en ;
	skos:prefLabel "Registry Value"@en ;
	.

stonework:Report
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "A collection of threat intelligence focused on one or more topics, such as a description of a threat actor, malware, or attack technique." ;
	skos:prefLabel "Report" ;
	.

stonework:Risk
	a owl:Class ;
	rdfs:subClassOf stonework:RiskFactor ;
	rdfs:comment "Instances of stonework:Risk may reference the threat being considered, the assets affected, the expected impact of compromise, and the likelihood of occurrence. Risk values may be qualitative or quantitative, and SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
	skos:definition "A measure of the potential for loss or adverse effects arising from the realization of a threat, expressed as a function of the impact of compromise and the likelihood that the compromise will occur." ;
	skos:prefLabel "Risk" ;
	skos:scopeNote "This class represents the assessed or estimated level of exposure to harm for a specific asset, mission, or organization. Risk is typically derived from the combination of impact and likelihood, and may incorporate assumptions, uncertainty, and contextual factors." ;
	.

stonework:RiskFactor
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A calculated or assessed component used to quantify or characterize security risk, including the potential for harm and the probability of its occurrence."@en ;
	skos:prefLabel "Risk Factor" ;
	skos:scopeNote "Includes Risk (overall assessed exposure), Impact (magnitude of harm if realized), and Likelihood (probability of occurrence). These are analytical outputs derived from threat and vulnerability data, distinct from the conditions (SecurityCondition) that give rise to them and the countermeasures (Countermeasure) that address them."@en ;
	.

stonework:Role
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A function, capacity, or part played by an entity in a specific context, relationship, or operation." ;
	skos:prefLabel "Role" ;
	skos:scopeNote "Roles are typically more stable and relational than Categories. An entity can play multiple Roles. Aligns with patterns in BFO, CCO, and D3FEND (e.g., functional roles of infrastructure or actors)."@en ;
	.

stonework:RoleAssignment
	a owl:Class ;
	rdfs:subClassOf stonework:QualifiedAssertion ;
	skos:definition "A qualified record assigning a Role to an entity within a particular campaign, operation, organization, or other context."@en ;
	skos:prefLabel "Role Assignment"@en ;
	skos:scopeNote "Create separate assignments when the same entity plays different roles in different contexts or time intervals. The assignment can infer the context-free stonework:playsRole projection through the declared property chain."@en ;
	.

stonework:RuntimeProcess
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	skos:definition "A running or terminated process instance on a host, identified by PID, executable path, command line, parent process, and associated user account."@en ;
	skos:prefLabel "Runtime Process"@en ;
	skos:scopeNote "Represents low-level OS process objects observed during execution — distinct from stonework:Process (enterprise-level workflows). Mutex objects created by a process are linked as stonework:Mutex individuals. Corresponds to STIX 2.1 Process SCO."@en ;
	.

stonework:SecurityActuation
	a owl:Class ;
	rdfs:subClassOf stonework:CyberActivity ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAActuation> ;
	skos:definition "A specific cyber activity in which a deployed security mechanism changes the security state of one or more cyber entities."@en ;
	skos:prefLabel "Security Actuation"@en ;
	skos:scopeNote "Use stonework:madeByActuator for the deployed mechanism, stonework:appliesCountermeasure for the safeguard or procedure being carried out, and stonework:actsOn for each affected entity. Unlike a Countermeasure specification, a SecurityActuation is an occurrence and may carry execution times and produced results. Inspired by SOSA sosa:Actuation without formally importing SOSA."@en ;
	.

stonework:SecurityActuator
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAActuator> ;
	skos:definition "A deployed system, service, appliance, or software agent capable of changing the security state of a cyber environment by applying a countermeasure."@en ;
	skos:prefLabel "Security Actuator"@en ;
	skos:scopeNote "A SecurityActuator is the mechanism that applies a safeguard, not the safeguard specification itself. Firewalls, EDR agents, access-control services, and patch-management systems are typical examples. A mechanism such as an IPS or EDR agent may be both a stonework:Sensor and a SecurityActuator. Distinct from stonework:Actuator, which is a physical process or plant actuator. Inspired by SOSA sosa:Actuator without formally importing SOSA."@en ;
	.

stonework:SecurityCondition
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	skos:definition "A state, circumstance, or disposition relevant to the security posture of a system, asset, or mission — existing independently of any measurement or assessment."@en ;
	skos:prefLabel "Security Condition" ;
	skos:scopeNote "Includes Threats, Vulnerabilities, and Weaknesses. Risk, Impact, and Likelihood are assessed/calculated concepts and are modeled under stonework:RiskFactor."@en ;
	.

stonework:SecurityObservation
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAObservation> ;
	skos:definition "A time-bounded record produced by a security sensor or automated tool capturing one or more cyber observables witnessed in a monitored environment, together with frequency metadata."@en ;
	skos:prefLabel "Security Observation"@en ;
	skos:scopeNote "Machine-produced intelligence: a sensor is not an analyst, but its output feeds the intelligence pipeline in the same way that SIGINT feeds human analysis. Key metadata: the time window the phenomenon was witnessed (first/last observed), how many times it was observed (number_observed), and which cyber observables were captured (hasObservable). Use stonework:madeBySensor to link to the producing stonework:Sensor. Distinct from stonework:Sighting, which records that a known CTI object (indicator, malware, threat actor) was seen; SecurityObservation is the raw sensor-layer record prior to attribution or indicator matching. Corresponds to STIX 2.1 observed-data SDO. Inspired by SOSA sosa:Observation — compatible in concept but does not formally import the SOSA ontology."@en ;
	.

stonework:Sensor
	a owl:Class ;
	rdfs:subClassOf stonework:Infrastructure ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSASensor> ;
	skos:definition "A deployed system, appliance, agent, or network tap that collects data about digital artifacts, network activity, or adversary behavior for detection and investigation purposes."@en ;
	skos:prefLabel "Sensor" ;
	skos:scopeNote "Applies DetectionRules via stonework:usesRule. May be a software agent, physical appliance, virtual instance, or network sensor. Examples: IDS/IPS, SIEM collector, endpoint agent, network tap, honeypot, vulnerability scanner. An AI-driven sensor that crosses into autonomous decision-making may be additionally typed as stonework:AIAgent. Aligns with D3FEND Sensor. Inspired by SOSA sosa:Sensor — compatible in concept but does not formally import the SOSA ontology. Produces stonework:SecurityObservation instances via stonework:madeBySensor."@en ;
	.

stonework:Sighting
	a owl:Class ;
	rdfs:subClassOf stonework:IntelligenceProduct ;
	skos:definition "Records that a object such as an indicator, malware, tool, or threat actor was seen. Wraps observation metadata around a reference to the sighted object."@en ;
	skos:prefLabel "Sighting" ;
	.

stonework:Signature
	a owl:Class ;
	rdfs:subClassOf stonework:DetectionRule ;
	skos:definition "A content-centric detection rule that matches malicious activity by a specific pattern — a byte sequence, string, hash, regular expression, or network packet structure."@en ;
	skos:prefLabel "Signature"@en ;
	skos:scopeNote "Includes YARA rules, Snort/Suricata rules, and AV signatures. Distinguished from broader DetectionRule subclasses (behavioral, correlation, analytic) by its tight binding to a specific known-bad indicator or artifact pattern."@en ;
	.

stonework:SoftwareBillOfMaterials
	a owl:Class ;
	rdfs:comment "An SBOM asserts that specific VersionedProduct instances are components of a containing artifact. Component entries are represented as stonework:BomEntry instances linked via stonework:hasBomEntry."@en ;
	skos:definition "A formal, machine-readable inventory of VersionedProduct components that constitute a software artifact or system, expressed in a standard format such as CycloneDX or SPDX."@en ;
	skos:prefLabel "Software Bill of Materials" ;
	skos:scopeNote "SoftwareBillOfMaterials is a native STONEWORK class — not a subclass of any STIX domain object, as STIX 2.1 has no SBOM concept. Instances correspond to SBOM documents; format provenance (CycloneDX 1.6, SPDX 2.3, etc.) is expressed via stonework:bomFormat."@en ;
	.

stonework:Step
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:seeAlso <http://purl.org/net/p-plan#Step> ;
	skos:definition "A single, individually addressable unit of action within a Behavior that models a multi-step process, such as a Procedure, Playbook, ThreatScenario, or Control."@en ;
	skos:prefLabel "Step" ;
	skos:scopeNote "A Step is itself a Behavior — a plan specification for a sub-action, not its execution — consistent with p-plan:Step subclassing prov:Plan rather than prov:Activity. Because Step is a Behavior, a Step MAY itself decompose into further Steps via stonework:hasStep, supporting nested sub-procedures (e.g. a Kill Chain phase decomposing into candidate technique attempts) without a separate composite class. The activity that executes a Step is a stonework:CyberActivity; it links back to the Step it realizes via stonework:correspondsToStep."@en ;
	.

stonework:Tactic
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:comment "Instances of stonework:Tactic SHOULD correspond to high‑level adversary goals. Techniques are typically modeled as children or members of a tactic." ;
	skos:definition "A high‑level objective or strategic goal that groups related techniques by the purpose they serve during an operation." ;
	skos:prefLabel "Tactic" ;
	skos:scopeNote "Superclass for OffensiveTactic and DefensiveTactic. Tactics represent the strategic intent behind behavior — gaining initial access, exfiltrating data, or hardening a system. They serve as conceptual categories for techniques." ;
	.

stonework:Technique
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:comment "Mirrors D3FEND's Technique class and reflects the PROV-O Plan philosophy: a technique is a plan that describes how an action should be carried out, distinct from the activity that executes it. Subclassed by stonework:CyberTechnique for cyber-specific methods." ;
	skos:definition "A reusable, prescribed method for achieving an objective, which may be instantiated as a concrete execution by an actor or system." ;
	skos:prefLabel "Technique" ;
	skos:scopeNote "A method specification, not a plan: a Technique describes an approach ('access credential material in LSASS process memory') without prescribing an ordered, branched sequence of steps. Concrete step structure appears one level down, in a stonework:Procedure that realizes the Technique, or in a stonework:Playbook / stonework:OperationPlan that orchestrates several. An execution links to the Technique it performs directly with stonework:executionOf — no Procedure, Plan, or Step is required for the lightweight case. Technique is intentionally not a subclass of stones:AttackPattern: attack patterns such as CAPEC are abstract taxonomy entries, while Techniques are operationalized methods closer to execution. See stonework:CyberTechnique, stonework:AttackTechnique, stonework:DefendTechnique, and docs/technique-modeling.md." ;
	.

stonework:Threat
	a owl:Class ;
	rdfs:subClassOf stonework:SecurityCondition ;
	rdfs:comment "Instances of stonework:Threat may describe adversary capabilities, strategic objectives, targeting patterns, or environmental conditions that increase the likelihood of harmful action. Threats may be linked to threat actors, campaigns, malware, TTPs, weaknesses, or assets, but are conceptually distinct from the actions or events that realize them." ;
	skos:definition "A potential or actual source of harm arising from an adversary's capability, intent, and opportunity to exploit weaknesses or create adverse effects within a system, organization, or mission." ;
	skos:prefLabel "Threat" ;
	skos:scopeNote "This class represents the abstract notion of a cyber threat, independent of specific threat actors, campaigns, or events. It provides a semantic foundation for modeling adversary capabilities, intentions, targeting, and conditions that give rise to harmful outcomes." ;
	.

stonework:ThreatActor
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	rdfs:seeAlso prov:Agent ;
	skos:definition "An entity that has the capability and intent to conduct harmful activities within a cyber or sociotechnical context." ;
	skos:prefLabel "Threat Actor"@en ;
	skos:scopeNote "Parent class for stonework:ThreatActorIndividual (a single human) and stonework:ThreatActorGroup (a collective or organization). Threat actors are distinct from the threats they pose; they are the entities that carry out actions that realize threats. They may be linked to observed behaviors, techniques, targeting patterns, and strategic objectives."@en ;
	.

stonework:ThreatActorGroup
	a owl:Class ;
	rdfs:subClassOf stonework:ThreatActor ;
	skos:definition "A collective, organization, or coordinated set of individuals operating with common intent to conduct adversarial cyber activities."@en ;
	skos:prefLabel "Threat Actor Group"@en ;
	skos:scopeNote "Covers nation-state units, cybercriminal organizations, hacktivist collectives, and other named adversary groups. Industry names such as APT20 or APT29 are often used for both a tracked body of activity and the presumed group behind it. Model the activity as a separate stonework:CyberActivityCluster and link it to the ThreatActorGroup with stonework:attributedTo when supported. MITRE ATT&CK serializes tracked Groups as STIX intrusion-set objects; that source representation alone does not establish that the activity cluster and responsible group are the same entity. Distinguished from stonework:ThreatActorIndividual, which represents a single human actor."@en ;
	.

stonework:ThreatActorIndividual
	a owl:Class ;
	rdfs:subClassOf stonework:ThreatActor ;
	skos:definition "A single, identifiable human actor with the capability and intent to conduct adversarial cyber activities."@en ;
	skos:prefLabel "Threat Actor Individual"@en ;
	skos:scopeNote "Covers individual hackers, insiders, contractors, and other identified persons. Relevant for law enforcement and prosecution contexts where attribution to a specific individual — rather than a group — is required. Distinguished from stonework:ThreatActorGroup, which represents a collective or organization."@en ;
	.

stonework:ThreatScenario
	a owl:Class ;
	rdfs:subClassOf stonework:Behavior ;
	rdfs:seeAlso prov:Plan ;
	skos:definition "A plan specification describing how a threat could materialize against specific assets or missions — incorporating adversary intent, capability, opportunity, preconditions, attack path, and expected consequences."@en ;
	skos:prefLabel "Threat Scenario"@en ;
	skos:scopeNote "A ThreatScenario is prescriptive and forward-looking: it specifies a potential sequence of adversary behaviors and environmental conditions rather than recording observed events. Used to guide defensive planning, risk assessment, and Playbook development. Distinct from stonework:Incident (an observed occurrence) and stonework:Threat (an abstract source of harm). Aligns with prov:Plan and P-Plan scenario specifications."@en ;
	.

stonework:Tool
	a owl:Class ;
	rdfs:subClassOf stonework:Product ;
	skos:definition "Legitimate software that can be used offensively by threat actors or defensively by security practitioners. Distinguishable from malware by being designed for benign or dual-use purposes rather than being inherently malicious."@en ;
	skos:prefLabel "Tool"@en ;
	skos:scopeNote "Includes commercial penetration testing tools, remote administration utilities, and living-off-the-land binaries (LOLBins) repurposed by adversaries, as well as defender-operated tools such as scanners, EDR agents, and forensic utilities. Corresponds to STIX 2.1 Tool SDO."@en ;
	.

stonework:Transition
	a owl:Class ;
	skos:definition "A directed edge between two Steps within the same parent Behavior's Step graph, representing progression from one Step to the next."@en ;
	skos:prefLabel "Transition" ;
	skos:scopeNote "Unconditioned, a Transition expresses plain sequence — an alternative to stonework:precededByStep for the same purpose, used when a Step has more than one possible successor and the edges themselves need to be individually referenceable. When a Transition's stonework:toStep targets a Step already reached earlier in the same graph, it expresses a loop back-edge; looping is not a separate construct. Conditional branching is expressed with the guard properties stonework:guardVariable (the Variable tested), stonework:guardType (a class the bound value must be an instance of) or stonework:guardLiteralValue (a scalar it must equal), and stonework:guardOperator (the comparison; omitting it defaults to equality). The Transition fires when its guard holds against the from-Step's bound Variable."@en ;
	.

stonework:URI
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "Represents a Uniform Resource Identifier conforming to RFC 3986."@en ;
	skos:prefLabel "URI"@en ;
	.

stonework:UserAccount
	a owl:Class ;
	rdfs:subClassOf stonework:Account ;
	skos:definition "An authenticated-access identity on a system or service — a local OS account, cloud or directory account, application account, or social media account — through which a principal logs in and acts."@en ;
	skos:prefLabel "User Account"@en ;
	skos:scopeNote "The access/authentication sibling of stonework:FinancialAccount under stonework:Account. Where a login governs a value-holding ledger (online banking, an exchange account, a marketplace wallet), model the ledger as a separate stonework:FinancialAccount and link the two with stonework:controls — one login commonly controls several accounts."@en ;
	.

stonework:UserAgent
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	skos:definition "A string identifier transmitted by a client application in HTTP requests declaring the software, version, and platform making the request. Used for fingerprinting clients, identifying malware C2 beaconing patterns, and clustering infrastructure by shared tooling."@en ;
	skos:prefLabel "User Agent"@en ;
	skos:scopeNote "User-agent strings are observable in network traffic, proxy logs, and web server logs. Distinctive or spoofed user-agent values are commonly used as indicators in threat intelligence. Distinct from stonework:UserAccount (an identity credential) — a UserAgent describes software behavior, not a user identity."@en ;
	.

stonework:UserGroup
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalIdentity ;
	skos:definition "Represents a user group on a system or service, including local OS groups, cloud groups, and social media groups."@en ;
	skos:prefLabel "User Group" ;
	.

stonework:Variable
	a owl:Class ;
	rdfs:subClassOf stonework:CyberEntity ;
	rdfs:seeAlso <http://purl.org/net/p-plan#Variable> ;
	skos:definition "A named placeholder for a value declared by a Behavior or Step, bound to an actual value only once the corresponding execution occurs."@en ;
	skos:prefLabel "Variable" ;
	skos:scopeNote "Declared via stonework:hasInputVariable or stonework:hasOutputVariable. An input Variable is typically bound before its Step executes, from an already-known fact (e.g. a Vulnerability's CVSS score); an output Variable is bound only after its Step executes, from a result the execution produced (e.g. a Technique attempt's outcome). Bound via stonework:boundTo (an individual) or stonework:boundToLiteral (a scalar). The bound value is what stonework:Transition guard properties test, and — in a future deviation-detection layer — what an actual result is compared against what the Step declared as expected."@en ;
	.

stonework:VersionedProduct
	a owl:Class ;
	rdfs:comment "Instances of stonework:VersionedProduct may include operating systems, applications, libraries, devices, or embedded components at a specific release. Versioning, vendor attribution, and edition details SHOULD be represented using explicit properties rather than encoded strings."@en ;
	skos:definition "A specific versioned release or build of a Product, identified by a CPE name or equivalent product identifier. Represents the unit of software actually deployed and potentially affected by vulnerabilities."@en ;
	skos:prefLabel "VersionedProduct" ;
	skos:scopeNote "Each CPE 2.3 entry with a concrete version component maps to a stonework:VersionedProduct individual. Wildcard-version CPEs map to stonework:Product. Related to its abstract product line via stonework:versionOf."@en ;
	.

stonework:Vulnerability
	a owl:Class ;
	rdfs:subClassOf stonework:SecurityCondition ;
	skos:definition "A flaw or weakness in software, hardware, firmware, or system architecture that can be exploited by a threat actor to compromise confidentiality, integrity, or availability."@en ;
	skos:prefLabel "Vulnerability" ;
	skos:scopeNote "Represents specific exploitable instances (e.g., CVE-identified vulnerabilities) rather than weakness classes — those are modeled as stonework:Weakness. A Vulnerability is linked to its root Weakness via stonework:hasWeakness, to affected products via stonework:affected, to its fix via stonework:fixedInProduct, and to exploiting malware or actors via stonework:exploits. Aligns with D3FEND Vulnerability and NVD CVE."@en ;
	.

stonework:VulnerabilityAssessment
	a owl:Class ;
	rdfs:subClassOf stonework:Assessment ;
	skos:definition "A structured evaluation of a specific vulnerability's applicability and risk in a particular product or deployment context."@en ;
	skos:prefLabel "Vulnerability Assessment"@en ;
	skos:scopeNote "Captures VEX-style assessments: whether a product is affected, not affected, fixed, or under investigation, together with the justification and any remediation statement. Distinct from stonework:Vulnerability (which describes the flaw itself) — a VulnerabilityAssessment is an opinion about that flaw in a specific context."@en ;
	.

stonework:Weakness
	a owl:Class ;
	rdfs:subClassOf stonework:SecurityCondition ;
	rdfs:comment 'Instances of stonework:Weakness may represent base weaknesses, variant weaknesses, or compound weaknesses. CWE identifiers (e.g., "CWE‑79") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Descriptions and extended details SHOULD be referenced via citations rather than reproduced verbatim.' ;
	skos:definition "A type of flaw, fault, or design condition in software, hardware, or system architecture that can enable vulnerabilities, reduce security assurance, or increase the likelihood of exploitable behavior." ;
	skos:prefLabel "Weakness" ;
	skos:scopeNote "This class provides a semantic representation of weakness types defined in the Common Weakness Enumeration (CWE). It supports hierarchical relationships, abstraction levels, and mappings to related attack patterns, vulnerabilities, and security controls." ;
	.

stonework:abaRoutingNumber
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:FinancialInstitution ;
	rdfs:range xsd:string ;
	skos:definition "The US ABA routing transit number of this institution. National branch or bank codes from other schemes, for example a UK sort code, may be recorded with the same property pending scheme-specific refinement."@en ;
	skos:prefLabel "abaRoutingNumber"@en ;
	.

stonework:accessesFile
	a owl:ObjectProperty ;
	rdfs:domain stonework:RuntimeProcess ;
	rdfs:range stonework:File ;
	skos:definition "Relates a RuntimeProcess to Files it reads, writes, or executes."@en ;
	skos:prefLabel "accessesFile"@en ;
	.

stonework:accessesRegistry
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:MalwareSample
			stonework:RuntimeProcess
		) ;
	] ;
	rdfs:range stonework:Registry ;
	skos:definition "Relates a RuntimeProcess or MalwareSample to Registry keys it reads or modifies."@en ;
	skos:prefLabel "accessesRegistry"@en ;
	.

stonework:accountCurrency
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialAccount ;
	rdfs:range stonework:Currency ;
	skos:definition "A currency or crypto asset that this financial account holds or is denominated in."@en ;
	skos:prefLabel "accountCurrency"@en ;
	skos:scopeNote "Intentionally multi-valued: an account, including a hosted exchange account or multi-asset wallet, may hold or support more than one currency."@en ;
	.

stonework:accountName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:UserAccount ;
	rdfs:range xsd:string ;
	skos:definition "The username or account identifier on the target system or service."@en ;
	skos:prefLabel "accountName"@en ;
	.

stonework:accountNumber
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:BankAccountNumber ;
	rdfs:range xsd:string ;
	skos:definition "The domestic account number string."@en ;
	skos:prefLabel "accountNumber"@en ;
	.

stonework:accountOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Account ;
	rdfs:range stonework:Agent ;
	owl:inverseOf stonework:hasAccount ;
	skos:definition "The Agent that holds this Account, or to whom it is beneficially attributed. Inverse of stonework:hasAccount."@en ;
	skos:prefLabel "accountOf" ;
	skos:scopeNote "For a UserAccount this is the account holder; for a FinancialAccount it is the accountholder or beneficial owner, which may differ from whoever operates it (an account-takeover attacker operating a victim's FinancialAccount is modeled with stonework:controls from the attacker-held UserAccount, leaving accountOf pointing at the victim)."@en ;
	.

stonework:actsOn
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberActivity ;
	rdfs:range stonework:CyberEntity ;
	rdfs:seeAlso prov:used ;
	skos:definition "Links a CyberActivity to the CyberEntity it acted upon — the asset, artifact, or resource the activity operated against."@en ;
	skos:prefLabel "actsOn" ;
	skos:scopeNote "Mirrors prov:used (an Activity used an Entity). Typical range instances are stonework:Host, stonework:RuntimeProcess, or other stonework:DigitalArtifact/stonework:Infrastructure individuals — e.g. the specific lsass.exe stonework:RuntimeProcess a credential-dumping attempt acted on. Distinct from stonework:targets: targets is a direct, open-domain/range lift of the STIX 2.1 relationship_type 'targets' shortcut, describing higher-level strategic targeting (a Sector, a Location, an Agent) by a Campaign/MalwareSample/ThreatActor. actsOn is purpose-built for the concrete technical asset one execution-trace Activity acted upon — the same distinction develop draws between stonework:mitigates (open, STIX-lifted) and stonework:mitigatesAttackPattern (purpose-built, controlled domain/range)."@en ;
	.

stonework:addressOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:IPAddress ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Host
			stonework:NetworkService
		) ;
	] ;
	skos:definition "Relates an IPAddress to the Host or NetworkService for which it serves as a network address."@en ;
	skos:prefLabel "addressOf"@en ;
	.

stonework:addresses
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Playbook
			stonework:ThreatScenario
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:AttackTechnique
			stonework:MalwareFamily
			stonework:ThreatActor
		) ;
	] ;
	skos:definition "Relates a Playbook or ThreatScenario to an AttackTechnique, MalwareFamily, or ThreatActor it is designed to address."@en ;
	skos:prefLabel "addresses"@en ;
	.

stonework:addressesAttack
	a owl:ObjectProperty ;
	rdfs:domain stonework:CourseOfAction ;
	rdfs:range stonework:AttackPattern ;
	skos:definition "A CourseOfAction prescribes a defensive response to this AttackPattern."@en ;
	skos:prefLabel "addressesAttack"@en ;
	.

stonework:affected
	a owl:ObjectProperty ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range stonework:VersionedProduct ;
	skos:definition "Relates a vulnerability to a product version known to be affected by it." ;
	skos:prefLabel "affected" ;
	skos:scopeNote "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded." ;
	.

stonework:affectsAsset
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Campaign
			stonework:Impact
			stonework:Incident
			stonework:Risk
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:DataAsset
			stonework:Infrastructure
		) ;
	] ;
	skos:definition "Relates an Incident, Campaign, Risk, or Impact to the assets it threatens or impacts."@en ;
	skos:prefLabel "affectsAsset"@en ;
	.

stonework:affiliatedWith
	a owl:ObjectProperty ;
	rdfs:range stonework:Agent ;
	skos:definition "Associates an entity with a related Agent through organizational membership, alliance, sponsorship, or informal association."@en ;
	skos:prefLabel "affiliatedWith" ;
	.

stonework:amount
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:MonetaryAmount ;
	rdfs:range xsd:decimal ;
	skos:definition "The magnitude of a stonework:MonetaryAmount, in the units of its stonework:currency. Negative values represent debit or overdrawn balances; transaction amounts are non-negative by convention, with direction carried by originator and beneficiary roles."@en ;
	skos:prefLabel "amount"@en ;
	.

stonework:analysisOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Analysis ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:CyberActivity
			stonework:CyberEntity
		) ;
	] ;
	skos:definition "Relates an Analysis to the CyberEntity or CyberActivity that it examines."@en ;
	skos:prefLabel "analysisOf"@en ;
	.

stonework:appliesControl
	a owl:ObjectProperty ;
	rdfs:domain stonework:CourseOfAction ;
	rdfs:range stonework:Control ;
	skos:definition "A CourseOfAction specifies this Control as part of its recommended defensive posture. Primary arc into the Control class."@en ;
	skos:prefLabel "appliesControl"@en ;
	.

stonework:appliesCountermeasure
	a owl:ObjectProperty ;
	rdfs:domain stonework:SecurityActuation ;
	rdfs:range stonework:Countermeasure ;
	skos:definition "Relates a SecurityActuation to the Countermeasure, rule, control, or mitigation carried out during that activity."@en ;
	skos:prefLabel "appliesCountermeasure"@en ;
	.

stonework:appliesTo
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Control
			stonework:DetectionRule
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:DataAsset
			stonework:Host
			stonework:Infrastructure
			stonework:VersionedProduct
		) ;
	] ;
	skos:definition "Relates a Control or DetectionRule to the systems or assets it applies to."@en ;
	skos:prefLabel "appliesTo"@en ;
	.

stonework:asName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:AutonomousSystem ;
	rdfs:range xsd:string ;
	skos:definition "The registered name or handle of the autonomous system."@en ;
	skos:prefLabel "asName"@en ;
	.

stonework:asNumber
	a owl:DatatypeProperty ;
	rdfs:domain stonework:AutonomousSystem ;
	rdfs:range xsd:unsignedInt ;
	skos:definition "The Autonomous System Number (ASN) assigned by IANA."@en ;
	skos:prefLabel "asNumber"@en ;
	.

stonework:assertionObject
	a owl:ObjectProperty ;
	rdfs:domain stonework:QualifiedAssertion ;
	skos:definition "Identifies the resource in the object or target position of a qualified assertion."@en ;
	skos:prefLabel "assertion object"@en ;
	skos:scopeNote "Range is intentionally unset because framework relationships may target either a CyberEntity, a CyberActivity, or another externally defined resource."@en ;
	.

stonework:assertionRelationType
	a owl:DatatypeProperty ;
	rdfs:domain stonework:QualifiedAssertion ;
	rdfs:range xsd:string ;
	skos:definition "The source vocabulary's wire-level name for the relation expressed by a qualified assertion."@en ;
	skos:prefLabel "assertion relation type"@en ;
	skos:scopeNote "Preserves open relationship vocabularies such as STIX relationship_type strings. A separately materialized object property may provide a query-friendly projection of the same assertion."@en ;
	.

stonework:assertionSubject
	a owl:ObjectProperty ;
	rdfs:domain stonework:QualifiedAssertion ;
	skos:definition "Identifies the resource in the subject or source position of a qualified assertion."@en ;
	skos:prefLabel "assertion subject"@en ;
	skos:scopeNote "Range is intentionally unset because framework relationships may originate from either a CyberEntity, a CyberActivity, or another externally defined resource."@en ;
	.

stonework:assessmentOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Assessment ;
	skos:definition "Relates an Assessment to the entity being assessed."@en ;
	skos:prefLabel "assessmentOf"@en ;
	.

stonework:assignedRole
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:RoleAssignment ;
	rdfs:range stonework:Role ;
	skos:definition "The Role assigned by a qualified RoleAssignment."@en ;
	skos:prefLabel "assignedRole"@en ;
	.

stonework:associatedWith
	a owl:ObjectProperty ;
	skos:definition "Generic association between two entities. Use a more specific property where one exists."@en ;
	skos:prefLabel "associatedWith" ;
	.

stonework:attributedTo
	a owl:ObjectProperty ;
	skos:definition "Links a CyberActivity to the Agent responsible for, or associated with, performing it." ;
	skos:prefLabel "attributedTo" ;
	skos:scopeNote "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'attributed-to' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. In practice the object is typically a stonework:Agent — most often a stonework:ThreatActor in the adversarial case, matching STIX's own convention for 'attributed-to' — but stonework:CyberActivity is a general occurrence class covering defensive and neutral activities too (Investigations, a ControlPlan's Process), so the performer need not be adversarial."@en ;
	.

stonework:attributedToAgent
	a owl:ObjectProperty ;
	rdfs:domain stonework:DigitalIdentity ;
	rdfs:range stonework:Agent ;
	skos:definition "Links a digital identity to the real-world Agent it is believed to belong to." ;
	skos:prefLabel "attributedToAgent" ;
	.

stonework:authoredBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Provenance ;
	rdfs:range stonework:Agent ;
	skos:definition "The Agent who authored or produced this provenance record, source document, or intelligence artifact."@en ;
	skos:prefLabel "authoredBy"@en ;
	.

stonework:beneficiaryAccount
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:FinancialAccount ;
	skos:definition "The account credited by this transaction — the destination of the transferred value."@en ;
	skos:prefLabel "beneficiaryAccount"@en ;
	.

stonework:beneficiaryMonetaryValue
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:hasMonetaryValue ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:MonetaryAmount ;
	skos:definition "The monetary amount credited to the beneficiary account as this transaction's output."@en ;
	skos:prefLabel "beneficiaryMonetaryValue"@en ;
	skos:scopeNote "Use with stonework:originatorMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty."@en ;
	.

stonework:bic
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:FinancialInstitution ;
	rdfs:range xsd:string ;
	skos:definition "The Business Identifier Code (SWIFT/BIC, ISO 9362) of this institution."@en ;
	skos:prefLabel "bic"@en ;
	.

stonework:blockchainNetwork
	a owl:DatatypeProperty ;
	rdfs:domain stonework:CryptoAsset ;
	rdfs:range xsd:string ;
	skos:definition "The distributed ledger a crypto asset is native to or issued on (e.g. Bitcoin, Ethereum, Tron, Monero). The same nominal token issued on more than one ledger is modeled as distinct CryptoAsset individuals."@en ;
	skos:prefLabel "blockchainNetwork"@en ;
	.

stonework:bomFormat
	a owl:DatatypeProperty ;
	rdfs:range xsd:string ;
	skos:definition "The exchange format and version in which a Bill of Materials was originally serialized (e.g. 'CycloneDX 1.6', 'SPDX 2.3')." ;
	skos:prefLabel "BOM format" ;
	skos:scopeNote "Domain intentionally left unset. Serves as provenance metadata on stonework:SoftwareBillOfMaterials instances, distinguishing the source format from the STONEWORK representation." ;
	.

stonework:boundTo
	a owl:ObjectProperty ;
	rdfs:domain stonework:Variable ;
	rdfs:range owl:Thing ;
	skos:definition "Binds a Variable, at execution time, to the individual it actually resolved to — e.g. the specific SecurityCondition instance a successful attempt produced."@en ;
	skos:prefLabel "boundTo" ;
	skos:scopeNote "Used when the bound value is an instance of a class rather than a scalar; see stonework:boundToLiteral for scalar bindings. Tested by stonework:guardType on a Transition."@en ;
	.

stonework:boundToLiteral
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Variable ;
	rdfs:range rdfs:Literal ;
	skos:definition "Binds a Variable, at execution time or at plan instantiation, to a scalar result value such as a boolean, count, or numeric score."@en ;
	skos:prefLabel "boundToLiteral" ;
	skos:scopeNote "Tested by stonework:guardLiteralValue and stonework:guardOperator on a Transition. When the guard uses an ordering operator (LessThan, GreaterThanOrEqual, etc.), this value MUST carry a numeric datatype (xsd:decimal, xsd:double, or xsd:integer) — untyped or string literals do not compare numerically under SPARQL."@en ;
	.

stonework:byteCount
	a owl:DatatypeProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "The total number of bytes transmitted in the traffic flow."@en ;
	skos:prefLabel "byteCount"@en ;
	.

stonework:categorizedBy
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:range stonework:Category ;
	skos:definition "Links any individual to one or more contextual categories." ;
	skos:prefLabel "categorizedBy" ;
	skos:scopeNote "This is the primary mechanism for flexible, context-sensitive classification (e.g., Evidence, HighValue, Suspect, etc.). Multiple categories per individual are allowed."@en ;
	.

stonework:categoryScheme
	a skos:ConceptScheme ;
	dcterms:title "STONEWORK Category Scheme"@en ;
	skos:definition "The umbrella concept scheme containing all STONEWORK classification and tagging values modeled as instances of stonework:Category subclasses."@en ;
	skos:prefLabel "STONEWORK Category Scheme"@en ;
	skos:scopeNote "More specific schemes organize individual controlled vocabularies. Category instances remain members of this umbrella scheme through the restriction on stonework:Category."@en ;
	.

stonework:certIssuerDN
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Certificate ;
