stonework:sharesRegistrant
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	skos:definition "Links Infrastructure entities sharing a common domain registrant record, supporting operator attribution clustering."@en ;
	skos:prefLabel "sharesRegistrant" ;
