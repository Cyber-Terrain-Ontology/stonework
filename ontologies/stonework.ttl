stonework:madeByActuator
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:SecurityActuation ;
	rdfs:range stonework:SecurityActuator ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAmadeByActuator> ;
