stonework:precededByStep
	a owl:ObjectProperty ;
	rdfs:domain stonework:Step ;
	rdfs:range stonework:Step ;
	skos:definition "Relates a Step to another Step that must occur before it within the same parent Behavior."@en ;
	skos:prefLabel "precededByStep" ;
	skos:scopeNote "Deliberately distinct from stonework:precedes, whose domain and range are IntelligenceProduct (report-version succession) — an unrelated relationship. precededByStep expresses a graph that may contain cycles: an edge targeting an already-reached Step is a loop, not an error. Use stonework:Transition instead when the edge itself needs a guard condition or other structure attached."@en ;
	.

stonework:precedes
	a owl:ObjectProperty ;
	rdfs:domain stonework:IntelligenceProduct ;
	rdfs:range stonework:IntelligenceProduct ;
	skos:definition "Temporal succession of Information (v1 precedes v2 of a report)"@en ;
	skos:prefLabel "precedes" ;
	.

stonework:predictedLiteral
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Hypothesis ;
	rdfs:range rdfs:Literal ;
	skos:definition "The scalar value a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed."@en ;
	skos:prefLabel "predictedLiteral" ;
	skos:scopeNote "Mirrors stonework:boundToLiteral on the actual-result side; see stonework:predictedValue for predictions of an individual rather than a scalar."@en ;
	.

stonework:predictedType
	a owl:ObjectProperty ;
	rdfs:domain stonework:Hypothesis ;
	rdfs:range rdfs:Class ;
	skos:definition "The class a Hypothesis predicts its stonework:predictsVariable will be bound to an instance of, once executed."@en ;
	skos:prefLabel "predictedType" ;
	skos:scopeNote "Mirrors stonework:guardType on Transition. Exists because a Hypothesis is typically formed before the Variable's eventual value has been constructed — at prediction time there is usually no individual yet to name via stonework:predictedValue, only an expected class of outcome (e.g. 'this attempt will produce some stonework:SecurityCondition')."@en ;
	.

stonework:predictedValue
	a owl:ObjectProperty ;
	rdfs:domain stonework:Hypothesis ;
	rdfs:range owl:Thing ;
	skos:definition "The individual a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed."@en ;
	skos:prefLabel "predictedValue" ;
	skos:scopeNote "Mirrors stonework:boundTo on the actual-result side; usable only when a specific pre-existing individual is predicted. See stonework:predictedType for the more common case of predicting a class of outcome rather than a specific not-yet-constructed individual, and stonework:predictedLiteral for predictions of a scalar."@en ;
	.

stonework:predictsVariable
	a owl:ObjectProperty ;
	rdfs:domain stonework:Hypothesis ;
	rdfs:range stonework:Variable ;
	skos:definition "The Variable whose eventual binding a Hypothesis is a prediction about."@en ;
	skos:prefLabel "predictsVariable" ;
	skos:scopeNote "Because stonework:hasInputVariable/stonework:hasOutputVariable are declared on stonework:Behavior, and stonework:Step is itself a Behavior, a Hypothesis may predict a Variable declared at any level of a Step/Plan decomposition — a top-level Plan's overall outcome or a single Step's individual result — without a separate property per level."@en ;
	.

stonework:procedureFor
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:implements ;
	rdfs:domain stonework:Procedure ;
	rdfs:range stonework:Technique ;
	skos:definition "Relates a Procedure to the Technique it implements; a specialized form of stonework:implements for procedure-to-technique links."@en ;
	skos:prefLabel "procedureFor"@en ;
	.

stonework:produces
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberActivity ;
	rdfs:range stonework:CyberEntity ;
	skos:definition "Links an executing CyberActivity to a CyberEntity it constructed or generated in the course of executing."@en ;
	skos:prefLabel "produces" ;
	skos:scopeNote "General-purpose construction/generation link — e.g. the CyberActivity realizing a Step is what actually constructs the value a Variable ends up stonework:boundTo, or a complex output artifact (a dataset, a report) that value refers to."@en ;
	.

stonework:producesReport
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Investigation
			stonework:Process
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Assessment
			stonework:Report
		) ;
	] ;
	skos:definition "Relates a Process or Investigation to the intelligence product it generates."@en ;
	skos:prefLabel "producesReport"@en ;
	.

stonework:productName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Product ;
	rdfs:range xsd:string ;
	skos:definition "The canonical product name."@en ;
	skos:prefLabel "productName"@en ;
	.

stonework:protects
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:AccessControlList
			stonework:Countermeasure
		) ;
	] ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:DataAsset
			stonework:DigitalArtifact
		) ;
	] ;
	skos:definition "Relates a Countermeasure or ACL to the resource it protects."@en ;
	skos:prefLabel "protects"@en ;
	.

stonework:provenanceOf
	a owl:ObjectProperty ;
	rdfs:domain stonework:Provenance ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:IntelligenceProduct
			stonework:QualifiedAssertion
		) ;
	] ;
	skos:definition "Relates a Provenance record to the IntelligenceProduct or QualifiedAssertion whose origin or evidentiary basis it documents."@en ;
	skos:prefLabel "provenanceOf"@en ;
	.

stonework:publishedDate
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf dcterms:issued ;
	rdfs:range xsd:date ;
	skos:definition "The date the item was first publicly published or disclosed."@en ;
	skos:prefLabel "publishedDate"@en ;
	skos:scopeNote "Compatibility alias for dcterms:issued. Prefer dcterms:issued in newly authored data."@en ;
	.

stonework:purl
	a owl:DatatypeProperty ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:anyURI ;
	skos:definition "The Package URL (PURL) identifying this software package version."@en ;
	skos:prefLabel "purl"@en ;
	.

stonework:rawEntry
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Log ;
	rdfs:range xsd:string ;
	skos:definition "The raw, unprocessed log line or record."@en ;
	skos:prefLabel "rawEntry"@en ;
	.

stonework:references
	a owl:ObjectProperty ;
	skos:definition "Generic reference from one entity to another. Use a more specific property where one exists."@en ;
	skos:prefLabel "references" ;
	.

stonework:refines
	a owl:ObjectProperty ;
	rdfs:domain stonework:AttackTechnique ;
	rdfs:range stonework:AttackPattern ;
	skos:definition "Relates an AttackTechnique to a broader or more abstract AttackPattern that it specializes, enabling roll-up from operational techniques to pattern families."@en ;
	skos:prefLabel "refines"@en ;
	.

stonework:regionCode
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Region ;
	rdfs:range xsd:string ;
	skos:definition "The ISO 3166-2 region code (e.g. US-CA, GB-ENG)."@en ;
	skos:prefLabel "regionCode"@en ;
	.

stonework:registeredTo
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:Agent ;
	skos:definition "Relates infrastructure to the Agent recorded as its owner or registrant of record — the entity in whose name the resource is officially registered."@en ;
	skos:prefLabel "registeredTo" ;
	.

stonework:registeredWith
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:Agent ;
	skos:definition "Relates infrastructure to the registrar, registry, or administrative authority through which the registration was processed or is maintained."@en ;
	skos:prefLabel "registeredWith" ;
	.

stonework:registrationDate
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Domain ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when the domain was first registered."@en ;
	skos:prefLabel "registrationDate"@en ;
	skos:scopeNote "Uses xsd:dateTime so source-native registration timestamps, including dns:registeredOn, can map without losing precision."@en ;
	.

stonework:registryKeyPath
	a owl:DatatypeProperty ;
	rdfs:domain stonework:RegistryKey ;
	rdfs:range xsd:string ;
	skos:definition "The full registry key path (e.g. HKEY_LOCAL_MACHINE\\SOFTWARE\\...)."@en ;
	skos:prefLabel "registryKeyPath"@en ;
	.

stonework:registryValueData
	a owl:DatatypeProperty ;
	rdfs:domain stonework:RegistryValue ;
	rdfs:range rdfs:Literal ;
	skos:definition "The typed literal data stored in the registry value."@en ;
	skos:prefLabel "registryValueData"@en ;
	skos:scopeNote "The broad literal range preserves string, numeric, multi-string, and binary-valued source representations. Use stonework:registryValueType to record the Windows registry type explicitly."@en ;
	.

stonework:registryValueName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:RegistryValue ;
	rdfs:range xsd:string ;
	skos:definition "The name of the registry value."@en ;
	skos:prefLabel "registryValueName"@en ;
	.

stonework:registryValueType
	a owl:DatatypeProperty ;
	rdfs:domain stonework:RegistryValue ;
	rdfs:range xsd:string ;
	skos:definition "The type of the registry value (e.g. REG_SZ, REG_DWORD, REG_BINARY)."@en ;
	skos:prefLabel "registryValueType"@en ;
	.

stonework:relatedAttackPattern
	a owl:ObjectProperty ;
	rdfs:range stonework:AttackPattern ;
	skos:definition "Relates an entity to an AttackPattern representing the same underlying technique in a different framework shape, resolved from a shared technique identifier (e.g. a CAPEC entry and the MITRE ATT&CK technique it maps to, or a CWE weakness and the CAPEC pattern that exploits it)."@en ;
	skos:prefLabel "relatedAttackPattern" ;
	skos:scopeNote "Domain intentionally left unset: subjects include stonework:Weakness (CWE → CAPEC) and stonework:AttackPattern itself (CAPEC → ATT&CK). Materialized by joining a framework's technique-identifier literal (see stonework:relatedTechniqueIdentifier) against the ATT&CK technique's external reference. Framework ontologies declare their concrete property (e.g. capec:relatedAttackTechnique, cwe:relatedAttackPattern) as rdfs:subPropertyOf this."@en ;
	.

stonework:relatedTechnique
	a owl:ObjectProperty ;
	rdfs:domain stonework:CyberTechnique ;
	rdfs:range stonework:CyberTechnique ;
	skos:definition "Relates a CyberTechnique to another related CyberTechnique via a cross-framework or cross-abstraction-level association."@en ;
	skos:prefLabel "relatedTechnique" ;
	skos:scopeNote "For technique-to-technique associations where both ends are already stonework:CyberTechnique individuals. Where the association instead crosses AttackPattern shapes (e.g. CWE weakness → CAPEC pattern, CAPEC pattern → ATT&CK technique), use stonework:relatedAttackPattern, whose domain is not restricted to CyberTechnique."@en ;
	.

stonework:relatedTechniqueIdentifier
	a owl:DatatypeProperty ;
	rdfs:range xsd:string ;
	skos:definition "A framework-native technique identifier string (e.g. a MITRE ATT&CK technique ID such as 'T1003.001') carried on an entity from another framework, both for provenance and as the join key used to materialize the corresponding stonework:relatedAttackPattern or stonework:mitigatesAttackPattern edge."@en ;
	skos:prefLabel "relatedTechniqueIdentifier" ;
	skos:scopeNote "Domain intentionally left unset: populated on entities as different as capec:AttackPattern and cis:Control. Framework-specific subproperties (e.g. capec:attackTechniqueId, cis:mitigatesTechniqueId) carry the concrete literal. Retained after materialization — it records the source string as ingested, distinct from the resolved object-property edge."@en ;
	.

stonework:relatedTo
	a owl:ObjectProperty ;
	skos:definition "Shortcut triple: generic relationship. Corresponds to STIX relationship_type 'related-to'." ;
	skos:prefLabel "relatedTo" ;
	.

stonework:reliability
	a owl:DatatypeProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:HumanSource
			stonework:Provenance
		) ;
	] ;
	rdfs:range xsd:string ;
	skos:definition "The assessed reliability of the source (e.g. using the NATO Admiralty Code A–F)."@en ;
	skos:prefLabel "reliability"@en ;
	.

stonework:remediates
	a owl:ObjectProperty ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:Vulnerability
			stonework:Weakness
		) ;
	] ;
	skos:definition "Relates an entity that addresses or corrects a Vulnerability or Weakness to the condition it remediates."@en ;
	skos:prefLabel "remediates" ;
	.

stonework:reportedBy
	a owl:ObjectProperty ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Report
			stonework:Sighting
		) ;
	] ;
	rdfs:range stonework:Agent ;
	skos:definition "Relates a Report or Sighting to the Agent who created it."@en ;
	skos:prefLabel "reportedBy"@en ;
	.

stonework:reportedIn
	a owl:ObjectProperty ;
	rdfs:domain stonework:Vulnerability ;
	rdfs:range stonework:Publication ;
	skos:definition "A Vulnerability is formally disclosed in this Publication (advisory, CVE NVD entry, security bulletin). Primary arc into the Publication class."@en ;
	skos:prefLabel "reportedIn"@en ;
	.

stonework:resolvedTo
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:resolvesTo ;
	rdfs:domain stonework:Domain ;
	rdfs:range stonework:IPAddress ;
	skos:definition "A Domain resolves to this IPAddress via DNS. More specific than stonework:resolvesTo (Infrastructure → Infrastructure); use this for explicit domain-to-IP mappings."@en ;
	skos:prefLabel "resolvedTo"@en ;
	.

stonework:resolvesTo
	a owl:ObjectProperty ;
	rdfs:domain stonework:Infrastructure ;
	rdfs:range stonework:Infrastructure ;
	skos:definition "Relates one Infrastructure entity to another Infrastructure entity to which it resolves, such as a Domain resolving to an IPAddress."@en ;
	skos:prefLabel "resolvesTo"@en ;
	.

stonework:respondsToActivity
	a owl:ObjectProperty ;
	rdfs:domain stonework:FinancialTransaction ;
	rdfs:range stonework:CyberActivity ;
	skos:definition "A cyber activity whose occurrence prompted or provides the context for this financial transaction, without asserting that the transaction financed the activity."@en ;
	skos:prefLabel "respondsToActivity"@en ;
	skos:scopeNote "Use for a victim's ransom payment linked to the incident it responds to, restitution or remediation payments, and similar contextual relationships. Use stonework:fundsActivity only when the transaction finances the linked activity."@en ;
	.

stonework:revokedBy
	a owl:ObjectProperty ;
	skos:definition "Shortcut triple: source STIX object is revoked and superseded by target. Corresponds to STIX relationship_type 'revoked-by'." ;
	skos:prefLabel "revokedBy" ;
	.

stonework:riskOfScenario
	a owl:ObjectProperty ;
	rdfs:domain stonework:Risk ;
	rdfs:range stonework:ThreatScenario ;
	skos:definition "Relates an assessed Risk to the ThreatScenario whose realization gives rise to that risk."@en ;
	skos:prefLabel "riskOfScenario"@en ;
	.

stonework:riskScore
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Risk ;
	rdfs:range xsd:decimal ;
	skos:definition "A numeric risk score expressing combined impact and likelihood."@en ;
	skos:prefLabel "riskScore"@en ;
	skos:scopeNote "Convenience projection for a current score. Use stonework:MetricObservation with stonework:metricRiskScore when methodology, source, model version, or assessment time must be preserved."@en ;
	.

stonework:roleContext
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:RoleAssignment ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:CyberActivity
			stonework:CyberEntity
		) ;
	] ;
	skos:definition "The campaign, operation, organization, or other context in which a RoleAssignment applies."@en ;
	skos:prefLabel "roleContext"@en ;
	.

stonework:rolePlayer
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:RoleAssignment ;
	rdfs:range stonework:CyberEntity ;
	owl:inverseOf stonework:hasRoleAssignment ;
	skos:definition "The entity that bears the Role in a qualified RoleAssignment."@en ;
	skos:prefLabel "rolePlayer"@en ;
	.

stonework:ruleContent
	a owl:DatatypeProperty ;
	rdfs:domain stonework:DetectionRule ;
	rdfs:range xsd:string ;
	skos:definition "The full text content of the detection rule."@en ;
	skos:prefLabel "ruleContent"@en ;
