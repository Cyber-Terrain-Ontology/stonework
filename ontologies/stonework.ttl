@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@base <https://cyberterrain.org/ns/stonework#> .

###  https://cyberterrain.org/ns/stonework#
<https://cyberterrain.org/ns/stonework#> rdf:type owl:Ontology ;
                                         owl:versionIRI <https://cyberterrain.org/ns/stonework/0.2.0> ;
                                         owl:versionInfo "0.2.0" ;
                                         rdfs:label "STONEWORK"@en ;
                                         dcterms:title "STONEWORK — Semantic Threat Ontology and Research Framework"@en ;
                                         dcterms:description "A semantic threat ontology and research framework that serves as the evolutionary successor to the STONES ontology. It provides a forward-looking, extensible foundation for modeling next-generation cyber threat intelligence concepts, objects, relationships, workflows, and knowledge beyond the scope of STIX 2.1." ;
                                         dcterms:creator "Hohimer Intelligence Strategies LLC" ;
                                         dcterms:license <https://opensource.org/licenses/MIT> .


#################################################################
#    Object Properties
#################################################################

###  https://cyberterrain.org/ns/stonework#accountFor
stonework:accountFor rdf:type owl:ObjectProperty ;
                     rdfs:domain stonework:UserAccount ;
                     rdfs:range stonework:Agent ;
                     skos:prefLabel "accountFor" .

###  https://cyberterrain.org/ns/stonework#achieves
stonework:achieves rdf:type owl:ObjectProperty ;
                   skos:prefLabel "achieves" .

###  https://cyberterrain.org/ns/stonework#affected
stonework:affected rdf:type owl:ObjectProperty ;
                   rdfs:domain stonework:Vulnerability ;
                   rdfs:range stonework:Product ;
                   skos:prefLabel "affected" ;
                   skos:definition "Relates a vulnerability to a product known to be affected by it." ;
                   skos:scopeNote "The range is a stonework:Product individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded." .

###  https://cyberterrain.org/ns/stonework#affiliatedWith
stonework:affiliatedWith rdf:type owl:ObjectProperty ;
                         rdfs:range stonework:Agent ;
                         skos:prefLabel "affiliatedWith" .

###  https://cyberterrain.org/ns/stonework#associatedWith
stonework:associatedWith rdf:type owl:ObjectProperty ;
                         skos:prefLabel "associatedWith" .

###  https://cyberterrain.org/ns/stonework#attributedTo
stonework:attributedTo rdf:type owl:ObjectProperty ;
                       rdfs:domain stonework:Campaign ;
                       rdfs:range stonework:ThreatActor ;
                       skos:prefLabel "attributedTo" ;
                       skos:definition "Shortcut triple: source Campaign or IntrusionSet is attributed to target ThreatActor or IntrusionSet. Corresponds to STIX relationship_type 'attributed-to'." .

###  https://cyberterrain.org/ns/stonework#categorizedBy
stonework:categorizedBy rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
                        rdfs:range stonework:Category ;
                        skos:prefLabel "categorizedBy" ;
                        skos:definition "Links any individual to one or more contextual categories." ;
                        skos:scopeNote "This is the primary mechanism for flexible, context-sensitive classification (e.g., Evidence, HighValue, Suspect, etc.). Multiple categories per individual are allowed."@en .

###  https://cyberterrain.org/ns/stonework#circumvents
stonework:circumvents rdf:type owl:ObjectProperty ;
                      rdfs:domain stonework:AITechnique , stonework:AttackPattern ;
                      rdfs:range stonework:AnalyticTechnique , stonework:DefendTechnique ;
                      skos:prefLabel "circumvents" .

###  https://cyberterrain.org/ns/stonework#clusteredWith
stonework:clusteredWith rdf:type owl:ObjectProperty ;
                        skos:prefLabel "clusteredWith" .

###  https://cyberterrain.org/ns/stonework#communicatesWith
stonework:communicatesWith rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
                           rdfs:domain stonework:Malware , stonework:Tool ;
                           rdfs:range stonework:Infrastructure ;
                           skos:prefLabel "communicatesWith" .

###  https://cyberterrain.org/ns/stonework#compromisedIn
stonework:compromisedIn rdf:type owl:ObjectProperty ;
                        rdfs:domain stonework:Agent ;
                        rdfs:range stonework:Incident ;
                        skos:prefLabel "compromisedIn" .

###  https://cyberterrain.org/ns/stonework#consistsOf
stonework:consistsOf rdf:type owl:ObjectProperty ;
                     skos:prefLabel "consistsOf" .

###  https://cyberterrain.org/ns/stonework#contactFor
stonework:contactFor rdf:type owl:ObjectProperty ;
                     rdfs:domain stonework:EmailAddress , stonework:PhoneNumber ;
                     rdfs:range stonework:Agent ;
                     skos:prefLabel "contactFor" .

###  https://cyberterrain.org/ns/stonework#contains
stonework:contains rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
                   rdfs:domain stonework:AutonomousSystem , stonework:IPBlock ;
                   rdfs:range stonework:IPAddress , stonework:IPBlock ;
                   skos:prefLabel "contains" .

###  https://cyberterrain.org/ns/stonework#counters
stonework:counters rdf:type owl:ObjectProperty ;
                   rdfs:domain stonework:AnalyticTechnique , stonework:DefendTechnique ;
                   rdfs:range stonework:AITechnique , stonework:AttackTechnique ;
                   skos:prefLabel "counters" .

###  https://cyberterrain.org/ns/stonework#derivedFrom
stonework:derivedFrom rdf:type owl:ObjectProperty ;
                      skos:prefLabel "derivedFrom" .

###  https://cyberterrain.org/ns/stonework#detects
stonework:detects rdf:type owl:ObjectProperty ;
                  skos:prefLabel "detects" ;
                  skos:definition "Shortcut triple: source CourseOfAction or Indicator detects target. Corresponds to STIX relationship_type 'detects'." .

###  https://cyberterrain.org/ns/stonework#downloads
stonework:downloads rdf:type owl:ObjectProperty ;
                    rdfs:domain stonework:Malware ;
                    rdfs:range stonework:File , stonework:Malware ;
                    skos:prefLabel "downloads" .

###  https://cyberterrain.org/ns/stonework#drops
stonework:drops rdf:type owl:ObjectProperty ;
                rdfs:domain stonework:Malware ;
                rdfs:range stonework:DigitalArtifact , stonework:File , stonework:Malware ;
                skos:prefLabel "drops" .

###  https://cyberterrain.org/ns/stonework#emailOf
stonework:emailOf rdf:type owl:ObjectProperty ;
                  rdfs:domain stonework:EmailAddress ;
                  rdfs:range stonework:Agent ;
                  skos:prefLabel "emailOf" .

###  https://cyberterrain.org/ns/stonework#exploits
stonework:exploits rdf:type owl:ObjectProperty ;
                   rdfs:domain <https://cyberterrain.org/ns/stones#Malware> , stonework:Campaign , stonework:ThreatActor ;
                   rdfs:range <https://cyberterrain.org/ns/stones#Vulnerability> ;
                   skos:prefLabel "exploits" ;
                   skos:definition "Shortcut triple: source Malware or ThreatActor exploits target Vulnerability. Corresponds to STIX relationship_type 'exploits'." .

###  https://cyberterrain.org/ns/stonework#generatedFrom
stonework:generatedFrom rdf:type owl:ObjectProperty ;
                        skos:prefLabel "generatedFrom" .

###  https://cyberterrain.org/ns/stonework#hasHash
stonework:hasHash rdf:type owl:ObjectProperty ;
                  rdfs:range stonework:Hash ;
                  skos:prefLabel "hasHash" ;
                  skos:definition "Relates an entity to its hash entries. The range is a stonework:Hash individual representing a single hash algorithm and digest value." .

###  https://cyberterrain.org/ns/stonework#hasMembers
stonework:hasMembers rdf:type owl:ObjectProperty ;
                     rdfs:domain stonework:Group , stonework:Organization , stonework:ThreatActor ;
                     skos:prefLabel "hasMembers" .

###  https://cyberterrain.org/ns/stonework#hasTechnique
stonework:hasTechnique rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
                       rdfs:domain stonework:Tactic , stonework:Technique ;
                       rdfs:range stonework:Technique ;
                       skos:prefLabel "hasTechnique" ;
                       skos:definition "Relates a tactic to an offensive technique that serves that tactic's goal." .

###  https://cyberterrain.org/ns/stonework#hasWeakness
stonework:hasWeakness rdf:type owl:AsymmetricProperty , owl:ObjectProperty ;
                      rdfs:domain stonework:Vulnerability ;
                      rdfs:range stonework:Weakness ;
                      skos:prefLabel "hasWeakness" ;
                      skos:definition "Relates a vulnerability to the weakness class it exploits or instantiates."@en ;
                      skos:scopeNote "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en .

###  https://cyberterrain.org/ns/stonework#hashOf
stonework:hashOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf stonework:hasHash ;
                 rdfs:domain stonework:Hash ;
                 skos:prefLabel "hashOf" ;
                 skos:definition "Relates a hash entry to the entity it describes. The domain is a stonework:Hash individual representing a single hash algorithm and digest value." .

###  https://cyberterrain.org/ns/stonework#hostedBy
stonework:hostedBy rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
                   rdfs:domain stonework:Infrastructure ;
                   rdfs:range stonework:Agent ;
                   skos:prefLabel "hostedBy" .

###  https://cyberterrain.org/ns/stonework#indicates
stonework:indicates rdf:type owl:ObjectProperty ;
                    skos:prefLabel "indicates" ;
                    skos:definition "Shortcut triple: source Indicator indicates presence of target. Corresponds to STIX relationship_type 'indicates'." .

###  https://cyberterrain.org/ns/stonework#linkedTo
stonework:linkedTo rdf:type owl:ObjectProperty ;
                   skos:prefLabel "linkedTo" .

###  https://cyberterrain.org/ns/stonework#membersOf
stonework:membersOf rdf:type owl:ObjectProperty ;
                    owl:inverseOf stonework:hasMembers ;
                    rdfs:range stonework:Group , stonework:Organization , stonework:ThreatActor ;
                    skos:prefLabel "membersOf" .

###  https://cyberterrain.org/ns/stonework#mentions
stonework:mentions rdf:type owl:ObjectProperty ;
                   rdfs:domain stonework:Provenance ;
                   skos:prefLabel "mentions" .

###  https://cyberterrain.org/ns/stonework#mitigates
stonework:mitigates rdf:type owl:ObjectProperty ;
                    rdfs:domain stonework:Control , stonework:Mitigation ;
                    rdfs:range stonework:AttackPattern ;
                    skos:prefLabel "mitigates" ;
                    skos:definition "Shortcut triple: source CourseOfAction mitigates target AttackPattern or Vulnerability. Corresponds to STIX relationship_type 'mitigates'." .

###  https://cyberterrain.org/ns/stonework#observedIn
stonework:observedIn rdf:type owl:ObjectProperty ;
                     rdfs:domain stonework:Malware , stonework:Tool ;
                     rdfs:range stonework:Campaign ;
                     skos:prefLabel "observedIn" .

###  https://cyberterrain.org/ns/stonework#originatesFrom
stonework:originatesFrom rdf:type owl:ObjectProperty ;
                         rdfs:range stonework:Location ;
                         skos:prefLabel "originatesFrom" .

###  https://cyberterrain.org/ns/stonework#overlapsWith
stonework:overlapsWith rdf:type owl:ObjectProperty ;
                       skos:prefLabel "overlapsWith" .

###  https://cyberterrain.org/ns/stonework#precedes
stonework:precedes rdf:type owl:ObjectProperty ;
                   skos:prefLabel "precedes" .

###  https://cyberterrain.org/ns/stonework#references
stonework:references rdf:type owl:ObjectProperty ;
                     skos:prefLabel "references" .

###  https://cyberterrain.org/ns/stonework#registeredTo
stonework:registeredTo rdf:type owl:ObjectProperty ;
                       rdfs:domain stonework:Infrastructure ;
                       rdfs:range stonework:Agent ;
                       skos:prefLabel "registeredTo" .

###  https://cyberterrain.org/ns/stonework#registeredWith
stonework:registeredWith rdf:type owl:ObjectProperty ;
                         rdfs:domain stonework:Infrastructure ;
                         rdfs:range stonework:Agent ;
                         skos:prefLabel "registeredWith" .

###  https://cyberterrain.org/ns/stonework#relatedTechnique
stonework:relatedTechnique rdf:type owl:ObjectProperty ;
                           rdfs:range stonework:Technique ;
                           skos:prefLabel "relatedTechnique" ;
                           skos:definition "Relates any STIX object to a technique it exploits, instantiates, or operationalizes." ;
                           skos:scopeNote "Covers two cross-dataset links: (1) CWE weakness → CAPEC technique (exploits/instantiates), and (2) CAPEC technique → ATT&CK technique (operationalizes). Both subjects are stones:StixObject individuals." .

###  https://cyberterrain.org/ns/stonework#relatedTo
stonework:relatedTo rdf:type owl:ObjectProperty ;
                    skos:prefLabel "relatedTo" ;
                    skos:definition "Shortcut triple: generic relationship. Corresponds to STIX relationship_type 'related-to'." .

###  https://cyberterrain.org/ns/stonework#remediates
stonework:remediates rdf:type owl:ObjectProperty ;
                     rdfs:range stonework:Vulnerability , stonework:Weakness ;
                     skos:prefLabel "remediates" .

###  https://cyberterrain.org/ns/stonework#resolvesTo
stonework:resolvesTo rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
                     rdfs:domain stonework:Infrastructure ;
                     rdfs:range stonework:Infrastructure ;
                     skos:prefLabel "resolvesTo"@en .

###  https://cyberterrain.org/ns/stonework#revokedBy
stonework:revokedBy rdf:type owl:ObjectProperty ;
                    skos:prefLabel "revokedBy" ;
                    skos:definition "Shortcut triple: source STIX object is revoked and superseded by target. Corresponds to STIX relationship_type 'revoked-by'." .

###  https://cyberterrain.org/ns/stonework#sharesCertificate
stonework:sharesCertificate rdf:type owl:ObjectProperty ;
                            rdfs:domain stonework:Infrastructure ;
                            skos:prefLabel "sharesCertificate" .

###  https://cyberterrain.org/ns/stonework#sharesRegistrant
stonework:sharesRegistrant rdf:type owl:ObjectProperty ;
                           rdfs:domain stonework:Infrastructure ;
                           skos:prefLabel "sharesRegistrant" .

###  https://cyberterrain.org/ns/stonework#subdomainOf
stonework:subdomainOf rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
                      rdfs:domain stonework:Domain ;
                      rdfs:range stonework:Domain ;
                      skos:prefLabel "subdomainOf" .

###  https://cyberterrain.org/ns/stonework#targets
stonework:targets rdf:type owl:ObjectProperty ;
                  rdfs:domain stonework:Campaign , stonework:Malware , stonework:ThreatActor ;
                  rdfs:range stonework:Location ;
                  skos:prefLabel "targets" ;
                  skos:definition "Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type 'targets'." .

###  https://cyberterrain.org/ns/stonework#techniqueOf
stonework:techniqueOf rdf:type owl:ObjectProperty ;
                      owl:inverseOf stonework:hasTechnique ;
                      rdfs:domain stonework:Technique ;
                      rdfs:range stonework:Tactic , stonework:Technique ;
                      skos:prefLabel "techniqueOf"@en ;
                      skos:definition "Links a Technique to the Tactic(s) it achieves or supports."@en ;
                      skos:scopeNote "This is the inverse of hasTechnique. A single Technique may support multiple Tactics (e.g. 'Phishing' supports both Initial Access and Credential Access)."@en ;
                      rdfs:isDefinedBy <https://cyberterrain.org/ns/stonework#> .

###  https://cyberterrain.org/ns/stonework#urlOf
stonework:urlOf rdf:type owl:ObjectProperty ;
                rdfs:domain stonework:URL ;
                skos:prefLabel "urlOf" .

###  https://cyberterrain.org/ns/stonework#uses
stonework:uses rdf:type owl:ObjectProperty ;
               rdfs:domain stonework:Campaign , stonework:Malware , stonework:ThreatActor ;
               rdfs:range stonework:AttackTechnique ;
               skos:prefLabel "uses" ;
               skos:definition "Relates a threat actor group or campaign to an offensive technique they are known to employ." ;
               skos:scopeNote "Sub-property stones:uses carries the shortcut triples emitted by the STIX 2.1 transform for relationship_type 'uses'." .

###  https://cyberterrain.org/ns/stonework#variantOf
stonework:variantOf rdf:type owl:ObjectProperty ;
                    rdfs:domain stonework:Malware ;
                    rdfs:range stonework:File , stonework:Hash , stonework:Malware ;
                    skos:prefLabel "variantOf" .

###  https://cyberterrain.org/ns/stonework#weaknessOf
stonework:weaknessOf rdf:type owl:ObjectProperty ;
                     owl:inverseOf stonework:hasWeakness ;
                     rdfs:domain stonework:Weakness ;
                     rdfs:range stonework:Vulnerability ;
                     skos:prefLabel "weaknessOf"@en ;
                     skos:definition "Relates a weakness to the vulnerability that exploits or instantiates it."@en ;
                     skos:scopeNote "The range is a vulnerability individual. The weakness individual (domain) is a stonework:Weakness whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en .


#################################################################
#    Classes
#################################################################

###  https://cyberterrain.org/ns/stonework#AITechnique
stonework:AITechnique rdf:type owl:Class ;
                      rdfs:subClassOf stonework:CyberTechnique ;
                      skos:prefLabel "AI Technique"@en ;
                      skos:definition "A specific method by which adversaries attack AI/ML systems (e.g., training data poisoning, adversarial examples, model extraction)."@en .

###  https://cyberterrain.org/ns/stonework#Activity
stonework:Activity rdf:type owl:Class ;
                   rdfs:subClassOf stonework:CyberEntity ;
                   skos:prefLabel "Activity" ;
                   skos:definition "A specific occurrence or performance of actions by one or more agents over time."@en ;
                   skos:scopeNote "Superclass for higher-level operational concepts such as Campaigns, Incidents, and Events."@en .

###  https://cyberterrain.org/ns/stonework#Agent
stonework:Agent rdf:type owl:Class ;
                rdfs:subClassOf stonework:CyberEntity ;
                skos:prefLabel "Agent" ;
                skos:definition "Any entity that can act, perform actions, or be attributed responsibility in a cyber or sociotechnical context."@en ;
                skos:scopeNote "Covers human individuals, groups, organizations, and other actors (e.g. threat actors, vendors, government bodies). Used as the top-level superclass for identity-related objects in alignment with STIX Identity."@en ;
                rdfs:seeAlso prov:Agent .

###  https://cyberterrain.org/ns/stonework#AnalyticTechnique
stonework:AnalyticTechnique rdf:type owl:Class ;
                            rdfs:subClassOf stonework:CyberTechnique ;
                            skos:prefLabel "Analytic Technique" ;
                            skos:definition "Methods of analysis (part of the Analytic Characterization Framework)"@en .

###  https://cyberterrain.org/ns/stonework#Assessment
stonework:Assessment rdf:type owl:Class ;
                     rdfs:subClassOf stonework:Information ;
                     skos:prefLabel "Assessment" ;
                     skos:definition "A process of evaluating, analyzing, or estimating risk, likelihood, impact, or other security-related attributes."@en ;
                     skos:scopeNote "Covers risk assessments, vulnerability assessments, impact analyses, and similar evaluative processes. Not a static property but an active process that produces outputs (e.g. risk ratings) that can be represented as properties or linked individuals."@en .

###  https://cyberterrain.org/ns/stonework#AttackPattern
stonework:AttackPattern rdf:type owl:Class ;
                        rdfs:subClassOf stonework:Behavior ;
                        skos:prefLabel "Attack Pattern"@en ;
                        skos:definition "A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&CK techniques."@en .

###  https://cyberterrain.org/ns/stonework#AttackTechnique
stonework:AttackTechnique rdf:type owl:Class ;
                          rdfs:subClassOf stonework:CyberTechnique ;
                          skos:prefLabel "Attack Technique"@en ;
                          skos:definition "A prescribed offensive method used by an adversary to achieve a specific tactical objective within a target environment."@en ;
                          skos:scopeNote "Aligns with MITRE ATT&CK techniques and D3FEND OffensiveTechnique. Not a subclass of stones:AttackPattern — attack patterns (e.g. CAPEC) are abstract descriptions of attack classes, whereas AttackTechnique is an operationalized plan for execution. Framework-specific subclasses (e.g. attack:Technique) provide the concrete individuals."@en .

###  https://cyberterrain.org/ns/stonework#AutonomousSystem
stonework:AutonomousSystem rdf:type owl:Class ;
                           rdfs:subClassOf stonework:Infrastructure ;
                           skos:prefLabel "Autonomous System"@en ;
                           skos:definition "Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number." .

###  https://cyberterrain.org/ns/stonework#Behavior
stonework:Behavior rdf:type owl:Class ;
                   rdfs:subClassOf stonework:CyberEntity ;
                   skos:prefLabel "Behavior" ;
                   skos:definition "A pattern of actions or methods characteristic of an entity, particularly adversaries."@en ;
                   skos:scopeNote "Groups TTP-related classes such as Tactics, Techniques, and Procedures."@en .

###  https://cyberterrain.org/ns/stonework#Campaign
stonework:Campaign rdf:type owl:Class ;
                   rdfs:subClassOf stonework:Activity ;
                   skos:prefLabel "Campaign"@en ;
                   skos:definition "A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to intrusion sets or threat actors." .

###  https://cyberterrain.org/ns/stonework#Category
stonework:Category rdf:type owl:Class ;
                   rdfs:subClassOf stonework:CyberEntity ;
                   skos:prefLabel "Category" ;
                   skos:definition "A classification or tagging concept used to group or qualify other individuals in a particular context." ;
                   skos:scopeNote "Categories are reified so they can be referenced, versioned, or scoped. They are not rigid types." .

###  https://cyberterrain.org/ns/stonework#Control
stonework:Control rdf:type owl:Class ;
                  rdfs:subClassOf stonework:SecurityMeasure ;
                  rdfs:comment """Instances of stonework:Control may represent individual controls, control enhancements, or sub‑controls. Framework‑specific identifiers (e.g., \"AC‑2\", \"CIS 4.1\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Control text SHOULD be referenced via citations rather than reproduced verbatim.""" ;
                  skos:prefLabel "Control" ;
                  skos:definition "A prescribed security or privacy safeguard that specifies an action, capability, or condition intended to reduce risk, enforce policy, or achieve a defined protection objective within an information system or organization." ;
                  skos:scopeNote "This class provides a semantic representation of security and privacy controls from frameworks such as NIST SP 800‑53 and the CIS Controls. It supports mapping to external control identifiers and families without embedding copyrighted control text." .

###  https://cyberterrain.org/ns/stonework#CryptoAsset
stonework:CryptoAsset rdf:type owl:Class ;
                      rdfs:subClassOf stonework:DigitalArtifact ;
                      skos:prefLabel "Crypto Asset"@en ;
                      skos:definition "A digital asset or wallet address used in cryptocurrency transactions, often relevant for tracking ransomware payments or illicit finance."@en .

###  https://cyberterrain.org/ns/stonework#CyberEntity
stonework:CyberEntity rdf:type owl:Class ;
                      skos:prefLabel "Cyber Entity" ;
                      skos:definition "Any concept, object, or resource that exists or operates within a cyber or sociotechnical domain."@en ;
                      skos:scopeNote "Serves as the root superclass for the STONEWORK ontology."@en .

###  https://cyberterrain.org/ns/stonework#CyberTechnique
stonework:CyberTechnique rdf:type owl:Class ;
                         rdfs:subClassOf stonework:Technique ;
                         skos:prefLabel "Cyber Technique" ;
                         skos:definition "A technique performed within or against cyberspace, encompassing both offensive and defensive cyber operations." ;
                         skos:scopeNote "Mirrors D3FEND's CyberTechnique class. Subclassed by stonework:AttackTechnique (offensive) and stonework:DefendTechnique (defensive), enabling a single property chain to span both ATT&CK and D3FEND individuals." .

###  https://cyberterrain.org/ns/stonework#DefendTechnique
stonework:DefendTechnique rdf:type owl:Class ;
                          rdfs:subClassOf stonework:CyberTechnique ;
                          skos:prefLabel "Defend Technique" ;
                          skos:definition "A prescribed defensive method used to detect, prevent, or respond to adversary behavior within a target environment." ;
                          skos:scopeNote "Aligns with MITRE D3FEND DefensiveTechnique. Framework-specific subclasses (e.g. d3fend:DefensiveTechnique) extend this class when D3FEND data is loaded." .

###  https://cyberterrain.org/ns/stonework#DigitalArtifact
stonework:DigitalArtifact rdf:type owl:Class ;
                          rdfs:subClassOf stonework:CyberEntity ;
                          skos:prefLabel "Digital Artifact" ;
                          skos:definition "Any discrete digital object or content entity that can be observed, transmitted, stored, or acted upon in a cyber environment."@en ;
                          skos:scopeNote "Includes files, hashes, malware samples, network traffic captures, and other content-bearing items. Aligns with D3FEND DigitalArtifact concepts."@en .

###  https://cyberterrain.org/ns/stonework#Domain
stonework:Domain rdf:type owl:Class ;
                 rdfs:subClassOf stonework:Infrastructure ;
                 skos:prefLabel "Domain"@en ;
                 skos:definition "Represents a network domain name. Can reference the IP addresses it resolves to." .

###  https://cyberterrain.org/ns/stonework#EmailAddress
stonework:EmailAddress rdf:type owl:Class ;
                       rdfs:subClassOf stonework:Identifier ;
                       skos:prefLabel "Email Address"@en ;
                       skos:definition "Represents a single email address, optionally associating it with a display name and a user account." .

###  https://cyberterrain.org/ns/stonework#Event
stonework:Event rdf:type owl:Class ;
                rdfs:subClassOf stonework:Activity ;
                skos:prefLabel "Event" .

###  https://cyberterrain.org/ns/stonework#File
stonework:File rdf:type owl:Class ;
               rdfs:subClassOf stonework:DigitalArtifact ;
               skos:prefLabel "File"@en ;
               skos:definition "Represents a file with its metadata and optional content reference. Supports extensions for archive files, NTFS streams, PE binaries, PDF documents, and raster images." .

###  https://cyberterrain.org/ns/stonework#Group
stonework:Group rdf:type owl:Class ;
                rdfs:subClassOf stonework:Agent ;
                skos:prefLabel "Group" ;
                skos:definition "Any collection of Persons, Organizations, or other Groups that share a common purpose or identity but do not necessarily have formal legal structure."@en ;
                skos:scopeNote "Used for informal collectives, communities, ad-hoc teams, criminal syndicates, or loose alliances. More general than Organization. Can contain other Groups or Organizations."@en .

###  https://cyberterrain.org/ns/stonework#Hash
stonework:Hash rdf:type owl:Class ;
               rdfs:subClassOf stonework:DigitalArtifact ;
               skos:prefLabel "Hash"@en ;
               skos:definition "A single cryptographic hash entry associating a hashing algorithm with its hex-encoded digest value. Used to represent entries in the STIX hashes dictionary." .

###  https://cyberterrain.org/ns/stonework#Host
stonework:Host rdf:type owl:Class ;
               rdfs:subClassOf stonework:Infrastructure ;
               skos:prefLabel "Host"@en ;
               skos:definition "A computing system, device, or endpoint (physical, virtual, container, or cloud instance) that can run processes, host files, and participate in networks."@en .

###  https://cyberterrain.org/ns/stonework#IPAddress
stonework:IPAddress rdf:type owl:Class ;
                    rdfs:subClassOf stonework:Infrastructure ;
                    skos:prefLabel "IP Address"@en ;
                    skos:definition "Represents a single IP address (IPv4 or IPv6)."@en .

###  https://cyberterrain.org/ns/stonework#IPBlock
stonework:IPBlock rdf:type owl:Class ;
                  rdfs:subClassOf stonework:Infrastructure ;
                  skos:prefLabel "IP Block"@en ;
                  skos:definition "A Classless Inter-Domain Routing (CIDR) block used to represent an IP network range."@en .

###  https://cyberterrain.org/ns/stonework#Identifier
stonework:Identifier rdf:type owl:Class ;
                     rdfs:subClassOf stonework:CyberEntity ;
                     skos:prefLabel "Identifier" ;
                     skos:definition "An atomic label, string, or token used to uniquely identify, locate, or reference a cyber entity, resource, or principal."@en ;
                     skos:scopeNote "Includes contact identifiers, network locators, accounts, and similar atomic artifacts."@en .

###  https://cyberterrain.org/ns/stonework#Impact
stonework:Impact rdf:type owl:Class ;
                 rdfs:subClassOf stonework:SecurityCondition ;
                 rdfs:comment "Instances of stonework:Impact SHOULD specify the affected asset or mission, the type of consequence, and the severity level. Impact SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
                 skos:prefLabel "Impact" ;
                 skos:definition "The magnitude of harm, loss, or adverse effects that would result if a threat were realized and a compromise occurred, expressed in terms of mission, business, operational, or technical consequences." ;
                 skos:scopeNote "Impact represents the severity of consequences associated with a compromise. It may include effects on confidentiality, integrity, availability, safety, mission success, financial loss, or reputational damage. Impact values may be qualitative or quantitative." .

###  https://cyberterrain.org/ns/stonework#Incident
stonework:Incident rdf:type owl:Class ;
                   rdfs:subClassOf stonework:Activity ;
                   skos:prefLabel "Incident" ;
                   skos:definition "A significant adverse event or series of related events that has caused, or has the potential to cause, harm to an organization’s operations, assets, or people." .

###  https://cyberterrain.org/ns/stonework#Information
stonework:Information rdf:type owl:Class ;
                      rdfs:subClassOf stonework:CyberEntity ;
                      skos:prefLabel "Information" ;
                      skos:definition "Data or knowledge artifacts that convey meaning, facts, or intelligence."@en ;
                      skos:scopeNote "Superclass for structured knowledge such as Assessments, Provenance, and Threat Scenarios."@en .

###  https://cyberterrain.org/ns/stonework#Infrastructure
stonework:Infrastructure rdf:type owl:Class ;
                         rdfs:subClassOf stonework:CyberEntity ;
                         skos:prefLabel "Infrastructure"@en ;
                         skos:definition "Represents systems, software services, or any group of resources used to conduct cyber operations. Infrastructure is used by threat actors and intrusion sets both offensively and defensively." .

###  https://cyberterrain.org/ns/stonework#Likelihood
stonework:Likelihood rdf:type owl:Class ;
                     rdfs:subClassOf stonework:SecurityCondition ;
                     rdfs:comment "Instances of stonework:Likelihood may incorporate assumptions, uncertainty, adversary behavior, historical frequency, or environmental conditions. Likelihood SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
                     skos:prefLabel "Likelihood" ;
                     skos:definition "The estimated probability, plausibility, or frequency with which a threat could be realized and lead to a compromise under specified conditions." ;
                     skos:scopeNote "Likelihood reflects the chance that a compromise will occur, considering adversary capability, intent, opportunity, preconditions, and environmental factors. Likelihood values may be qualitative, ordinal, or quantitative." .

###  https://cyberterrain.org/ns/stonework#Location
stonework:Location rdf:type owl:Class ;
                   rdfs:subClassOf stonework:CyberEntity ;
                   skos:prefLabel "Location"@en ;
                   skos:definition "Represents a geographic location. May be as specific as a latitude/longitude coordinate or as broad as a continent. At least one of region, country, or latitude/longitude must be provided." .

###  https://cyberterrain.org/ns/stonework#Malware
stonework:Malware rdf:type owl:Class ;
                  rdfs:subClassOf stonework:DigitalArtifact ;
                  skos:prefLabel "Malware"@en ;
                  skos:definition "A type of TTP that represents malicious code. Captures both malware families (when is_family is true) and specific instances or samples." .

###  https://cyberterrain.org/ns/stonework#Mitigation
stonework:Mitigation rdf:type owl:Class ;
                     rdfs:subClassOf stonework:SecurityMeasure ;
                     skos:prefLabel "Mitigation" ;
                     skos:definition "A deliberate Process or set of activities intended to reduce the likelihood, impact, or severity of a risk, threat, vulnerability, or adverse event."@en ;
                     skos:scopeNote """Mitigations are proactive or reactive actions taken to address weaknesses or threats. 
Examples include: applying a security patch, enabling multi-factor authentication, deploying a firewall rule, isolating a compromised host, or training users.  A Mitigation may be a one-time action or a repeatable control."""@en ;
                     rdfs:seeAlso <https://csrc.nist.gov/glossary/term/mitigation> .

###  https://cyberterrain.org/ns/stonework#NetworkService
stonework:NetworkService rdf:type owl:Class ;
                         rdfs:subClassOf stonework:Infrastructure ;
                         skos:prefLabel "Network Service" ;
                         skos:definition "A network-accessible service or endpoint provided by infrastructure, such as HTTP, DNS, or SSH servers."@en .

###  https://cyberterrain.org/ns/stonework#NetworkTraffic
stonework:NetworkTraffic rdf:type owl:Class ;
                         rdfs:subClassOf stonework:DigitalArtifact ;
                         skos:prefLabel "Network Traffic"@en ;
                         skos:definition "Represents an arbitrary network traffic flow between source and destination endpoints. Supports extensions for HTTP, ICMP, socket, and TCP specifics." .

###  https://cyberterrain.org/ns/stonework#Operation
stonework:Operation rdf:type owl:Class ;
                    rdfs:subClassOf stonework:Activity ;
                    skos:prefLabel "Operation" .

###  https://cyberterrain.org/ns/stonework#Organization
stonework:Organization rdf:type owl:Class ;
                       rdfs:subClassOf stonework:Agent ;
                       skos:prefLabel "Organization" ;
                       skos:definition "A formal or semi-formal structured entity such as a company, government agency, non-profit, military unit, or consortium with defined boundaries and usually legal identity."@en ;
                       skos:scopeNote "Corresponds to STIX Identity with identity_class = 'organization'. Includes corporations, government bodies, NGOs, universities, etc. Distinguished from Group by having more persistent structure, roles, and often legal standing."@en ;
                       rdfs:seeAlso prov:Organization .

###  https://cyberterrain.org/ns/stonework#Person
stonework:Person rdf:type owl:Class ;
                 rdfs:subClassOf stonework:Agent ;
                 skos:prefLabel "Person" ;
                 skos:definition "A single human individual."@en ;
                 skos:scopeNote "Represents real named people (e.g. employees, threat actors, researchers). Does not include legal entities or groups. Corresponds to STIX Identity with identity_class = 'individual'."@en ;
                 rdfs:seeAlso prov:Person .

###  https://cyberterrain.org/ns/stonework#PhoneNumber
stonework:PhoneNumber rdf:type owl:Class ;
                      rdfs:subClassOf stonework:Identifier ;
                      skos:prefLabel "Phone Number" .

###  https://cyberterrain.org/ns/stonework#Playbook
stonework:Playbook rdf:type owl:Class ;
                   rdfs:subClassOf stonework:Behavior ;
                   rdfs:comment "Playbooks are often versioned, tested, and executed as instances of Process."@en ;
                   skos:prefLabel "Playbook" ;
                   skos:definition "A documented, structured Process that defines a sequenced set of steps, decisions, and actions to be executed in response to a specific type of event, incident, or operational need."@en ;
                   skos:scopeNote "A Playbook provides reusable, often automated or semi-automated guidance for security operations, incident response, threat hunting, recovery, or routine tasks. It typically includes triggers, decision points, assigned roles (Agents), inputs/outputs, and success criteria.  Playbooks bridge planning and execution."@en ;
                   rdfs:seeAlso prov:Plan .

###  https://cyberterrain.org/ns/stonework#Procedure
stonework:Procedure rdf:type owl:Class ;
                    rdfs:subClassOf stonework:Behavior ;
                    rdfs:comment "Procedures are instances or patterns of execution that realize a technique. They may include command lines, API calls, malware behaviors, or operator playbook steps. Procedures are distinct from techniques, which describe generalized methods." ;
                    skos:prefLabel "Procedure" ;
                    skos:definition "A concrete, observable sequence of actions, commands, or behaviors that implements a technique in a specific operational context." ;
                    skos:scopeNote "Procedures describe the actual steps an adversary takes, such as specific commands, scripts, tools, or configurations. They represent the most granular level of adversary behavior." .

###  https://cyberterrain.org/ns/stonework#Process
stonework:Process rdf:type owl:Class ;
                  rdfs:subClassOf stonework:Activity ;
                  skos:prefLabel "Process"@en ;
                  skos:definition "An identifiable activity or sequence of activities performed over time by one or more agents to achieve an operational, security, or business objective. It transforms inputs (artifacts, data, configurations) into outputs and may be governed by plans, controls, or policies." ;
                  skos:scopeNote "This class operates at the enterprise/operational level and is distinct from low-level runtime Process objects (e.g., STIX SCO Process). It is intended for modeling Controls, Playbooks, Mitigations, Threat Scenarios, and other repeatable or planned workflows."@en ;
                  rdfs:seeAlso prov:Activity , <https://www.opmw.org/model/p-plan/> .

###  https://cyberterrain.org/ns/stonework#Product
stonework:Product rdf:type owl:Class ;
                  rdfs:subClassOf stonework:CyberEntity ;
                  rdfs:comment "Instances of stonework:Product may include operating systems, applications, libraries, devices, or embedded components. Versioning, vendor attribution, and edition details SHOULD be represented using explicit properties rather than encoded strings."@en ;
                  skos:prefLabel "Product" ;
                  skos:definition "A software, hardware, or firmware entity identified by its vendor, product name, and version characteristics, used to represent a specific platform or component within vulnerability, configuration, or threat‑intelligence contexts."@en ;
                  skos:scopeNote "This class provides a semantic representation of platform entities commonly identified using CPE naming schemes. It does not require the use of CPE, but supports mapping to CPE identifiers when available."@en .

###  https://cyberterrain.org/ns/stonework#Provenance
stonework:Provenance rdf:type owl:Class ;
                     rdfs:subClassOf stonework:Information ;
                     skos:prefLabel "Provenance"@en ;
                     skos:definition "Structured source references used to record the origin and trustworthiness of data and relationships."@en ;
                     skos:scopeNote "Includes Feeds, Publications, and URL References."@en .

###  https://cyberterrain.org/ns/stonework#Risk
stonework:Risk rdf:type owl:Class ;
               rdfs:subClassOf stonework:SecurityCondition ;
               rdfs:comment "Instances of stonework:Risk may reference the threat being considered, the assets affected, the expected impact of compromise, and the likelihood of occurrence. Risk values may be qualitative or quantitative, and SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
               skos:prefLabel "Risk" ;
               skos:definition "A measure of the potential for loss or adverse effects arising from the realization of a threat, expressed as a function of the impact of compromise and the likelihood that the compromise will occur." ;
               skos:scopeNote "This class represents the assessed or estimated level of exposure to harm for a specific asset, mission, or organization. Risk is typically derived from the combination of impact and likelihood, and may incorporate assumptions, uncertainty, and contextual factors." .

###  https://cyberterrain.org/ns/stonework#RuntimeProcess
stonework:RuntimeProcess rdf:type owl:Class ;
                         rdfs:subClassOf stonework:DigitalArtifact ;
                         skos:prefLabel "Runtime Process"@en ;
                         skos:definition "Represents a running or terminated process on a host. Supports extensions for operating system process and service attributes."@en .

###  https://cyberterrain.org/ns/stonework#SecurityCondition
stonework:SecurityCondition rdf:type owl:Class ;
                            rdfs:subClassOf stonework:CyberEntity ;
                            skos:prefLabel "Security Condition" ;
                            skos:definition "A state, circumstance, or factor relevant to the security posture of a system, asset, or mission."@en ;
                            skos:scopeNote "Includes Threats, Vulnerabilities, Risks, Impacts, and Likelihoods."@en .

###  https://cyberterrain.org/ns/stonework#SecurityMeasure
stonework:SecurityMeasure rdf:type owl:Class ;
                          rdfs:subClassOf stonework:CyberEntity ;
                          skos:prefLabel "Security Measure" ;
                          skos:definition "Any control, mitigation, or safeguard intended to protect against, reduce, or respond to security risks."@en ;
                          skos:scopeNote "Includes Controls and Mitigations."@en .

###  https://cyberterrain.org/ns/stonework#Tactic
stonework:Tactic rdf:type owl:Class ;
                 rdfs:subClassOf stonework:Behavior ;
                 rdfs:comment "Instances of stonework:Tactic SHOULD correspond to high‑level adversary goals. Techniques are typically modeled as children or members of a tactic." ;
                 skos:prefLabel "Tactic" ;
                 skos:definition "A high‑level adversary objective or strategic goal that groups related techniques by the purpose they serve during an intrusion or operation." ;
                 skos:scopeNote "Tactics represent the strategic intent behind adversary behavior, such as gaining initial access, executing code, or exfiltrating data. They serve as conceptual categories for techniques." .

###  https://cyberterrain.org/ns/stonework#Technique
stonework:Technique rdf:type owl:Class ;
                    rdfs:subClassOf stonework:Behavior ;
                    rdfs:comment "Mirrors D3FEND's Technique class and reflects the PROV-O Plan philosophy: a technique is a plan that describes how an action should be carried out, distinct from the activity that executes it. Subclassed by stonework:CyberTechnique for cyber-specific methods." ;
                    skos:prefLabel "Technique" ;
                    skos:definition "A reusable, prescribed method for achieving an objective, which may be instantiated as a concrete execution by an actor or system." ;
                    skos:scopeNote "Technique is intentionally not a subclass of stones:AttackPattern. Attack patterns (e.g. CAPEC) are abstract descriptions of attack classes in the STIX sense; techniques are operationalized plans. See stonework:CyberTechnique, stonework:AttackTechnique, stonework:DefendTechnique." .

###  https://cyberterrain.org/ns/stonework#Threat
stonework:Threat rdf:type owl:Class ;
                 rdfs:subClassOf stonework:SecurityCondition ;
                 rdfs:comment "Instances of stonework:Threat may describe adversary capabilities, strategic objectives, targeting patterns, or environmental conditions that increase the likelihood of harmful action. Threats may be linked to threat actors, campaigns, malware, TTPs, weaknesses, or assets, but are conceptually distinct from the actions or events that realize them." ;
                 skos:prefLabel "Threat" ;
                 skos:definition "A potential or actual source of harm arising from an adversary's capability, intent, and opportunity to exploit weaknesses or create adverse effects within a system, organization, or mission." ;
                 skos:scopeNote "This class represents the abstract notion of a cyber threat, independent of specific threat actors, campaigns, or events. It provides a semantic foundation for modeling adversary capabilities, intentions, targeting, and conditions that give rise to harmful outcomes." .

###  https://cyberterrain.org/ns/stonework#ThreatActor
stonework:ThreatActor rdf:type owl:Class ;
                      rdfs:subClassOf stonework:Agent ;
                      rdfs:comment "Instances of stonework:ThreatActor may represent specific threat actor groups, campaigns, or personas. They may be linked to observed behaviors, techniques, targeting patterns, or strategic objectives. Threat actors are distinct from the threats they pose; they are the entities that carry out actions that realize threats." ;
                      skos:prefLabel "Threat Actor"@en ;
                      skos:definition "An individual, group, organization, or collective that has the capability and intent to conduct harmful activities within a cyber or sociotechnical context." ;
                      skos:scopeNote "This class represents the actors behind cyber threats. It includes both human and non-human entities that can perform actions, have intent, and be attributed responsibility for cyber operations."@en ;
                      rdfs:seeAlso prov:Agent .

###  https://cyberterrain.org/ns/stonework#ThreatScenario
stonework:ThreatScenario rdf:type owl:Class ;
                         rdfs:subClassOf stonework:Information ;
                         rdfs:comment "Instances of stonework:ThreatScenario may include assumptions, triggering conditions, targeted assets, adversary profiles, attack paths, and expected impacts. Threat scenarios are distinct from threats, attacks, or incidents; they represent hypothetical or anticipated sequences rather than observed events." ;
                         skos:prefLabel "Threat Scenario" ;
                         skos:definition "A structured description of how a threat could materialize against specific assets or missions, incorporating adversary intent, capability, opportunity, preconditions, and potential consequences." ;
                         skos:scopeNote "Threat scenarios describe plausible or anticipated sequences of adversarial behavior and environmental conditions that could lead to harmful outcomes. They support risk assessment, prioritization, and strategic planning by expressing how threats may be realized in a given organizational context." .

###  https://cyberterrain.org/ns/stonework#Tool
stonework:Tool rdf:type owl:Class ;
               rdfs:subClassOf stonework:DigitalArtifact ;
               skos:prefLabel "Tool"@en ;
               skos:definition "Legitimate software that can be used by threat actors to perform attacks. Distinguishable from malware by being designed for benign purposes but repurposed maliciously." .

###  https://cyberterrain.org/ns/stonework#URL
stonework:URL rdf:type owl:Class ;
              rdfs:subClassOf stonework:Identifier ;
              skos:prefLabel "URL"@en ;
              skos:definition "Represents a Uniform Resource Locator conforming to RFC 3986." .

###  https://cyberterrain.org/ns/stonework#UserAccount
stonework:UserAccount rdf:type owl:Class ;
                      rdfs:subClassOf stonework:Identifier ;
                      skos:prefLabel "User Account"@en ;
                      skos:definition "Represents a user account on a system or service, including local OS accounts, cloud accounts, and social media accounts. Supports a unix-account extension for POSIX attributes." .

###  https://cyberterrain.org/ns/stonework#Vulnerability
stonework:Vulnerability rdf:type owl:Class ;
                        rdfs:subClassOf stonework:SecurityCondition ;
                        skos:prefLabel "Vulnerability" ;
                        skos:definition "A mistake in software, hardware, or system architecture that can be directly used by a threat actor to gain access to a system or network." ;
                        skos:scopeNote "This class represents a semantic representation for any type of cyber vulnerability." .

###  https://cyberterrain.org/ns/stonework#Weakness
stonework:Weakness rdf:type owl:Class ;
                   rdfs:subClassOf stonework:SecurityCondition ;
                   rdfs:comment """Instances of stonework:Weakness may represent base weaknesses, variant weaknesses, or compound weaknesses. CWE identifiers (e.g., \"CWE‑79\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Descriptions and extended details SHOULD be referenced via citations rather than reproduced verbatim.""" ;
                   skos:prefLabel "Weakness" ;
                   skos:definition "A type of flaw, fault, or design condition in software, hardware, or system architecture that can enable vulnerabilities, reduce security assurance, or increase the likelihood of exploitable behavior." ;
                   skos:scopeNote "This class provides a semantic representation of weakness types defined in the Common Weakness Enumeration (CWE). It supports hierarchical relationships, abstraction levels, and mappings to related attack patterns, vulnerabilities, and security controls." .


#################################################################
#    Named Individuals
#################################################################

###  https://cyberterrain.org/ns/stonework#evidence
stonework:evidence rdf:type owl:NamedIndividual , stonework:Category ;
                   skos:prefLabel "Evidence" ;
                   skos:definition "Material or information offered to support or refute a claim, typically within an investigation or legal context."@en ;
                   skos:scopeNote "This is a reusable category instance. It is *not* a class. Use stonework:categorizedBy to assert that something is evidence in a given context."@en .

###  https://cyberterrain.org/ns/stonework#indicator
stonework:indicator rdf:type owl:NamedIndividual , stonework:Category ;
                    skos:prefLabel "Indicator" ;
                    skos:definition "An assertion that a specific pattern or set of Digital Artifacts is associated with malicious behavior, enabling detection, correlation, and response."@en ;
                    skos:scopeNote "In STONEWORK, Indicators can be simple (single IOC like a hash or IP) or complex (full STIX patterns combining multiple artifacts and conditions)."@en .
