stonework:spawns
	a owl:ObjectProperty ;
	rdfs:domain stonework:RuntimeProcess ;
	rdfs:range stonework:RuntimeProcess ;
	owl:inverseOf stonework:hasParentProcess ;
	skos:definition "A RuntimeProcess creates a child process. Inverse of stonework:hasParentProcess; enables top-down process tree traversal for execution chain analysis."@en ;
	skos:prefLabel "spawns"@en ;
	.

stonework:srcPort
	a owl:DatatypeProperty ;
	rdfs:domain stonework:NetworkTraffic ;
	rdfs:range xsd:unsignedShort ;
	skos:definition "The source TCP/UDP port number."@en ;
	skos:prefLabel "srcPort"@en ;
	.

stonework:startedAtTime
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:CyberActivity ;
	rdfs:range xsd:dateTime ;
	rdfs:seeAlso prov:startedAtTime ;
	skos:definition "The date and time at which a CyberActivity began."@en ;
	skos:prefLabel "startedAtTime" ;
	.

stonework:stepOrder
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Step ;
	rdfs:range xsd:integer ;
	skos:definition "An optional ordinal position for a Step within a strictly linear Behavior, where the full precededByStep graph is unnecessary."@en ;
