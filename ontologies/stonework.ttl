stonework:signedWith
	a owl:ObjectProperty ;
	rdfs:domain stonework:File ;
	rdfs:range stonework:Certificate ;
	skos:definition "A File is code-signed with this Certificate. Supports trust chain analysis, publisher attribution of binaries, and detection of certificate abuse or misuse."@en ;
	skos:prefLabel "signedWith"@en ;
