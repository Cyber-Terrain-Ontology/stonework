stonework:rawEntry rdf:type owl:DatatypeProperty ;
                   rdfs:domain stonework:Log ;
                   rdfs:range xsd:string ;
                   skos:prefLabel "rawEntry"@en ;
                   skos:definition "The raw, unprocessed log line or record."@en .

