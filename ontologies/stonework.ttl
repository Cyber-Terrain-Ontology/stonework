	skos:prefLabel "storedOn"@en ;
	.

stonework:subdomainOf
	a
		owl:ObjectProperty ,
		owl:TransitiveProperty
		;
	rdfs:domain stonework:Domain ;
	rdfs:range stonework:Domain ;
	skos:definition "This Domain is a subdomain of the specified parent Domain. Transitive: if A is a subdomain of B and B of C, then A is a subdomain of C."@en ;
	skos:prefLabel "subdomainOf" ;
	.

stonework:subsidiary
	a owl:ObjectProperty ;
	rdfs:domain stonework:Organization ;
	rdfs:range stonework:Organization ;
	skos:definition "Relates an Organization to a subsidiary organization it owns or controls."@en ;
	skos:prefLabel "subsidiary"@en ;
