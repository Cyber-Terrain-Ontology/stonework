stonework:madeBySensor
	a owl:ObjectProperty ;
	rdfs:domain stonework:SecurityObservation ;
	rdfs:range stonework:Sensor ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAmadeBySensor> ;
