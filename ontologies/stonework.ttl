	skos:prefLabel "isKnownExploited"@en ;
	skos:scopeNote "Convenience projection for a current catalog snapshot. A false value is only meaningful as of a specific time; preserve dated membership evidence with stonework:MetricObservation and stonework:metricKevMembership."@en ;
