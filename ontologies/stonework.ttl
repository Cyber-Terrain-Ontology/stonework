stonework:ruleFormat
	a owl:DatatypeProperty ;
	rdfs:domain stonework:DetectionRule ;
	rdfs:range xsd:string ;
	skos:definition "The format or language of the rule (e.g. YARA, Sigma, Snort, KQL, SPL)."@en ;
	skos:prefLabel "ruleFormat"@en ;
	.

stonework:ruleName
	a owl:DatatypeProperty ;
	rdfs:domain stonework:DetectionRule ;
	rdfs:range xsd:string ;
	skos:definition "The human-readable name of the detection rule."@en ;
	skos:prefLabel "ruleName"@en ;
	.

stonework:ruleVersion
	a owl:DatatypeProperty ;
	rdfs:domain stonework:DetectionRule ;
	rdfs:range xsd:string ;
	skos:definition "The version string of the detection rule."@en ;
	skos:prefLabel "ruleVersion"@en ;
	.

stonework:runs
	a owl:ObjectProperty ;
	rdfs:domain stonework:Host ;
	rdfs:range stonework:RuntimeProcess ;
	owl:inverseOf stonework:executedOn ;
	skos:definition "Relates a Host to the RuntimeProcesses executing on it."@en ;
	skos:prefLabel "runs"@en ;
	.

stonework:scenarioActor
	a owl:ObjectProperty ;
	rdfs:domain stonework:ThreatScenario ;
	rdfs:range stonework:ThreatActor ;
	skos:definition "Relates a ThreatScenario to the threat actor type or group it models."@en ;
	skos:prefLabel "scenarioActor"@en ;
	.

stonework:scenarioAsset
	a owl:ObjectProperty ;
	rdfs:domain stonework:ThreatScenario ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			stonework:DataAsset
			stonework:Infrastructure
		) ;
	] ;
	skos:definition "Relates a ThreatScenario to the targeted assets in the scenario."@en ;
	skos:prefLabel "scenarioAsset"@en ;
	.

stonework:scenarioTechnique
	a owl:ObjectProperty ;
	rdfs:domain stonework:ThreatScenario ;
	rdfs:range stonework:AttackTechnique ;
	skos:definition "Relates a ThreatScenario to the AttackTechniques in the attack path."@en ;
	skos:prefLabel "scenarioTechnique"@en ;
	.

stonework:serialNumber
	a owl:DatatypeProperty ;
	rdfs:range xsd:string ;
	skos:definition "A globally unique identifier for a BOM document, typically expressed as a URN UUID (e.g. urn:uuid:...) per the CycloneDX specification or as a document namespace per SPDX." ;
	skos:prefLabel "serial number" ;
	skos:scopeNote "Domain intentionally left unset. Primary subject is stonework:SoftwareBillOfMaterials. Use dcterms:created for the BOM timestamp."@en ;
