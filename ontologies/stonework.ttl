			stonework:Infrastructure
			stonework:Location
		) ;
	] ;
	skos:definition "Relates a Sighting to the infrastructure or location where the observation was made."@en ;
	skos:prefLabel "sightedAt"@en ;
	.

stonework:sightedBy
	a owl:ObjectProperty ;
	rdfs:domain stonework:Sighting ;
	rdfs:range stonework:Agent ;
	skos:definition "Relates a Sighting to the Agent who made the observation."@en ;
	skos:prefLabel "sightedBy"@en ;
	.

stonework:sightedObject
	a owl:ObjectProperty ;
	rdfs:domain stonework:Sighting ;
	skos:definition "Relates a Sighting to the entity that was observed."@en ;
	skos:prefLabel "sightedObject"@en ;
	.

stonework:sightingCount
	a owl:DatatypeProperty ;
	rdfs:domain stonework:Sighting ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "The number of times the sighted object was observed."@en ;
	skos:prefLabel "sightingCount"@en ;
