	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:domain stonework:Currency ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "The number of decimal places in the currency's minor unit — 0 for JPY, 2 for USD, 3 for BHD — as defined by ISO 4217 for fiat currencies."@en ;
	skos:prefLabel "minorUnitDigits"@en ;
	.

stonework:mitigates
	a owl:ObjectProperty ;
	skos:definition "Relates a Mitigation, CourseOfAction, or Control to the AttackPattern or Vulnerability it addresses. Corresponds to STIX relationship_type 'mitigates'."@en ;
	skos:prefLabel "mitigates" ;
	skos:scopeNote "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'mitigates' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. Contrast with stonework:mitigatesAttackPattern, a purpose-built subproperty with a controlled domain/range, populated by materialize-technique-links.sparql rather than lifted directly from STIX."@en ;
	.

stonework:mitigatesAttackPattern
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:mitigates ;
	rdfs:domain stonework:Countermeasure ;
	rdfs:range stonework:AttackPattern ;
	skos:definition "Relates a Countermeasure (e.g. a CIS Control safeguard) to the AttackPattern it mitigates, resolved from a shared technique identifier."@en ;
	skos:prefLabel "mitigatesAttackPattern" ;
	skos:scopeNote "Materialized by joining a framework's technique-identifier literal (see stonework:relatedTechniqueIdentifier, e.g. cis:mitigatesTechniqueId) against the ATT&CK technique's external reference. Framework ontologies declare their concrete property (e.g. cis:mitigatesTechnique) as rdfs:subPropertyOf this."@en ;
	.

stonework:mitigatesVulnerability
	a owl:ObjectProperty ;
	rdfs:domain stonework:CourseOfAction ;
	rdfs:range stonework:Vulnerability ;
	skos:definition "A CourseOfAction (patch, workaround, compensating control) addresses this Vulnerability. Distinct from stonework:mitigates (Countermeasure → AttackPattern)."@en ;
	skos:prefLabel "mitigatesVulnerability"@en ;
	.

