	skos:prefLabel "madeBySensor"@en ;
	skos:scopeNote "Inspired by SOSA sosa:madeBySensor. Enables queries such as 'which sensor produced this observation?' and 'what has this IDS sensor observed in the last 24 hours?' The producing sensor may also be the created_by_ref identity in the STIX wire format."@en ;
	.

stonework:manifestsAs
	a owl:ObjectProperty ;
	rdfs:domain stonework:Threat ;
	rdfs:range stonework:ThreatScenario ;
	skos:definition "A Threat is concretely expressed as a ThreatScenario with defined actor, asset, and technique. Connects abstract threat to actionable scenario modelling."@en ;
	skos:prefLabel "manifestsAs"@en ;
	.

