# imports: https://cyberterrain.org/ns/frameworks/dns
# imports: https://cyberterrain.org/ns/stonework#

@prefix dns: <https://cyberterrain.org/ns/frameworks/dns#> .
@prefix email: <https://cyberterrain.org/ns/frameworks/email#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/frameworks/email>
	a owl:Ontology ;
	rdfs:label "Email Framework Ontology"@en ;
	rdfs:comment "Ontology for origins, delivery and content of email"@en ;
	owl:imports
		<https://cyberterrain.org/ns/frameworks/dns> ,
		<https://cyberterrain.org/ns/stonework#>
		;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/email/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

email:BCC
	a owl:ObjectProperty ;
	rdfs:subPropertyOf email:Recipient ;
	rdfs:label "Blind Carbon Copy Recipient"@en ;
	rdfs:comment "The BCC field is stripped from email after being relayed from the initial source, as each BCC recipient recieves an email addressed only to them."@en ;
	.

email:CC
	a owl:ObjectProperty ;
	rdfs:subPropertyOf email:Recipient ;
	rdfs:label "Carbon Copy Recipient"@en ;
	rdfs:comment "the CC field is retained in delivered emails, recipients will see all other addresses contained in the CC: field in the delivered email"@en ;
	.

email:Email
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	rdfs:label "Email"@en ;
	rdfs:comment "A single, complete message, as delivered through a Mail Transport Agent"@en ;
	.

email:EmailBody
	a owl:Class ;
	rdfs:subClassOf email:Email ;
	rdfs:label "Email Body Content"@en ;
	rdfs:comment "This represents the entire content of an email, minus the header content generated by the Mail Transport"@en ;
	.

email:EmailHeader
	a owl:Class ;
	rdfs:subClassOf email:Email ;
	rdfs:label "Email Header"@en ;
	rdfs:comment "Email headers represent the information appended to the email body, as it passed between Mail Transports"@en ;
	.

email:IMAPService
	a owl:Class ;
	rdfs:subClassOf stonework:NetworkService ;
	rdfs:label "IMAP Service"@en ;
	rdfs:comment "An IMAP (Internet Message Access Protocol) Service is a mail server that accepts email messages from a mail client, and allows the client to access and manage them on the server without downloading them."@en ;
	.

email:OriginRelay
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "email:sent from SMTP relay at"@en ;
	rdfs:comment "The address of the SMTP Server that accepted and relayed the email"@en ;
	rdfs:domain email:EmailHeader ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			dns:A
			stonework:IPAddress
		) ;
	] ;
	.

email:Origination
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "email:sent from mail client at"@en ;
	rdfs:domain email:EmailHeader ;
	rdfs:range [
		a owl:Class ;
		owl:unionOf (
			dns:A
			stonework:IPAddress
		) ;
	] ;
	.

email:POP3Service
	a owl:Class ;
	rdfs:subClassOf stonework:NetworkService ;
	rdfs:label "POP3 Service"@en ;
	rdfs:comment "A POP3 (Post Office Protocol) Service is a mail server that accepts email messages from a mail client, and allows the client to download them for local storage and access."@en ;
	.

email:Recipient
	a owl:ObjectProperty ;
	rdfs:label "email:Recipient"@en ;
	rdfs:comment "The email address(es) this email was addressed to (but not necessarily successfully delivered to"@en ;
	rdfs:domain email:Email ;
	rdfs:range stonework:EmailAddress ;
	.

email:SMTPService
	a owl:Class ;
	rdfs:subClassOf stonework:NetworkService ;
	rdfs:label "SMTP Service"@en ;
	rdfs:comment "An SMTP (Simple Mail Transfer Protocol) Service is a mail server that accepts email messages from a mail client or another mail server, and relays them towards their destination."@en ;
	.

email:Sender
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "email:Sent from address"@en ;
	rdfs:comment "The From: Field in email is absolutely arbitrary, and can be populated with anything that matches the email address format. There is no guarantee it is a legitimate address"@en ;
	rdfs:domain email:Email ;
	rdfs:range stonework:EmailAddress ;
	.

email:Status
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "Email read status"@en ;
	rdfs:comment "The message status -- read, unread, etc"@en ;
	rdfs:domain email:Email ;
	rdfs:range xsd:string ;
	.

email:Subject
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "Email subject"@en ;
	rdfs:comment "The subject line"@en ;
	rdfs:domain email:EmailHeader ;
	rdfs:range xsd:string ;
	.

email:To
	a owl:ObjectProperty ;
	rdfs:subPropertyOf email:Recipient ;
	rdfs:label "email:Primary Recipient"@en ;
	rdfs:comment "The To: recipient list in an email indicates the primary recipients of the email."@en ;
	.

email:bodyContent
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "Body Content"@en ;
	rdfs:comment "The raw content of the email body" ;
	rdfs:domain email:EmailBody ;
	rdfs:range xsd:string ;
	.

email:containsFile
	a owl:ObjectProperty ;
	rdfs:label "email:has attachment"@en ;
	rdfs:comment "the email body contains a MIME-encoded attached file"@en ;
	rdfs:domain email:EmailBody ;
	rdfs:range stonework:File ;
	.

email:containsURL
	a owl:ObjectProperty ;
	rdfs:label "email:contains URL"@en ;
	rdfs:comment "the email body contains a link to a URL"@en ;
	rdfs:domain email:EmailBody ;
	rdfs:range stonework:URI ;
	.

email:hasHeader
	a owl:ObjectProperty ;
	rdfs:label "email:has header"@en ;
	rdfs:comment "extracted/parsed headers"@en ;
	rdfs:domain email:Email ;
	rdfs:range email:EmailHeader ;
	.

email:hasSpoolfile
	a owl:ObjectProperty ;
	rdfs:label "email:extracted from spool file"@en ;
	rdfs:comment "the spool file the email message was found in"@en ;
	rdfs:domain email:Email ;
	rdfs:range stonework:File ;
	.

email:headerContent
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "Email Head Raw Content"@en ;
	rdfs:comment "The raw text content of an Email Header"@en ;
	rdfs:domain email:EmailHeader ;
	rdfs:range xsd:string ;
	.

email:messageID
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "Message ID"@en ;
	rdfs:comment "Message ID String - these are considered best-effort to be globally unique"@en ;
	rdfs:domain email:EmailHeader ;
	rdfs:range xsd:normalizedString ;
	.

email:onDomain
	a owl:ObjectProperty ;
	rdfs:label "email:on domain"@en ;
	rdfs:comment "The domain portion of an email Address"@en ;
	rdfs:domain stonework:EmailAddress ;
	rdfs:range stonework:Domain ;
	.

email:returnPath
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "email:Return Path"@en ;
	rdfs:comment "The address that responses to this email should be sent to"@en ;
	rdfs:domain email:EmailHeader ;
	rdfs:range stonework:EmailAddress ;
	.
