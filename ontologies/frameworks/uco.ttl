# imports: https://cyberterrain.org/ns/stonework#

@prefix action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frameworks: <https://cyberterrain.org/ns/frameworks/> .
@prefix identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix location: <https://ontology.unifiedcyberontology.org/uco/location/> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

frameworks:uco
	a owl:Ontology ;
	rdfs:label "STONEWORK: UCO 1.5.0 Mapping"@en ;
	dcterms:description "Declares conservative subclass mappings from Unified Cyber Ontology (UCO) 1.5.0 core, action, identity, location, and observable classes into STONEWORK. Load this adapter alongside the official UCO ontologies when cross-model reasoning is required; it deliberately does not import UCO or reproduce UCO SHACL constraints."@en ;
	dcterms:source <https://github.com/ucoProject/UCO/tree/1.5.0> ;
	rdfs:seeAlso <https://unifiedcyberontology.org/releases/1.5.0/> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/uco/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	skos:scopeNote "UCO observable characteristics are represented through facet nodes, while STONEWORK commonly uses direct properties. This adapter maps compatible classes only and intentionally avoids subproperty axioms that would incorrectly type UCO facet nodes as the observable objects they characterize. UCO observable:Observation is mapped to stonework:CyberActivity because it denotes the act of observing; stonework:SecurityObservation denotes the resulting machine-produced intelligence record."@en ;
	.

action:Action
	rdfs:subClassOf stonework:CyberActivity ;
	.

action:Technique
	rdfs:subClassOf stonework:Technique ;
	.

core:Assertion
	rdfs:subClassOf stonework:QualifiedAssertion ;
	.

