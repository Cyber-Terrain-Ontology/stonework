# imports: https://cyberterrain.org/ns/stonework#

@prefix attack: <https://cyberterrain.org/ns/frameworks/attack#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/frameworks/attack>
	a owl:Ontology ;
	rdfs:label "MITRE ATT&CK Framework Ontology"@en ;
	rdfs:comment "OWL rendering of the MITRE ATT&CK Data Model Specification v3.3.0: one class per ATT&CK concept, named as MITRE names it and placed under the STONEWORK concept it specializes, plus the ATT&CK-specific properties. ATT&CK relationships that mean the same as a STONEWORK property (uses, mitigates, detects, attributed-to, targets, revoked-by) have no attack: property: the interpretation step writes the STONEWORK property directly. ATT&CK is published as STIX 2.1 JSON; the STIX objects are kept faithfully in STONES, and this vocabulary records what each object means in ATT&CK. Instances keep MITRE's STIX IDs as IRIs (ctienc:attack-pattern--{uuid})."@en ;
	dcterms:source <https://mitre-attack.github.io/attack-data-model/schemas/> ;
	rdfs:seeAlso <https://attack.mitre.org/> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/attack/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	skos:scopeNote "DRAFT 2026-10-13 for review. Parents marked OPEN in rdfs:comment are still to be decided. Consumers such as the CTI Encyclopedia gateway query without inference, so data written with an attack: property that specializes a STONEWORK property should also carry the STONEWORK property."@en ;
	.

attack:Analytic
	a owl:Class ;
	rdfs:subClassOf stonework:DefendTechnique ;
	rdfs:label "ATT&CK Analytic"@en ;
	rdfs:comment "Platform-specific detection logic implementing a detection strategy, with the log sources it needs and the elements a defender may tune. STIX type x-mitre-analytic; ATT&CK ID ANxxxx. A defensive technique, as D3FEND models detection: a more specific technique within its detection strategy (attack:analytic, under stonework:hasTechnique). Not a stonework:AnalyticTechnique, which covers analytic methods such as analysis of competing hypotheses or clustering. Query stonework:AttackTechnique, not stonework:Technique, for ATT&CK's T-numbered techniques."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/analytic.schema> ;
	.

attack:Asset
	a owl:Class ;
	rdfs:label "ATT&CK Asset"@en ;
	rdfs:comment "A system, device or technology adversaries may target, in the ICS domain. STIX type x-mitre-asset; ATT&CK ID Axxxx. Not in the Enterprise bundle. OPEN: no general STONEWORK asset class exists yet."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/asset.schema> ;
	.

attack:Campaign
	a owl:Class ;
	rdfs:subClassOf stonework:Campaign ;
	rdfs:label "ATT&CK Campaign"@en ;
	rdfs:comment "A grouping of adversarial behaviours over a period of time with a common target or objective. STIX type campaign; ATT&CK ID Cxxxx."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/campaign.schema> ;
	.

attack:Collection
	a owl:Class ;
	rdfs:label "ATT&CK Collection"@en ;
	rdfs:comment "A versioned release of ATT&CK objects (e.g. Enterprise ATT&CK 19.2). STIX type x-mitre-collection. Release metadata rather than a domain concept, so it has no STONEWORK parent."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/collection.schema> ;
	.

attack:DataComponent
	a owl:Class ;
	rdfs:label "ATT&CK Data Component"@en ;
	rdfs:comment "A kind of telemetry useful for detection (e.g. Process Creation), with the log sources and channels that provide it. STIX type x-mitre-data-component; ATT&CK ID DCxxxx. OPEN: a Data Component is a kind of stonework:Event rather than an event, so it has no STONEWORK parent class. STONEWORK already models kinds of telemetry as classes: frameworks/ocsf.ttl places the OCSF event classes under stonework:Event. A Data Component can therefore be matched to the OCSF class(es) for the same telemetry (e.g. Process Creation to ocsf:ProcessActivity), which is the likely anchor; stonework:Log is an actual record."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/data-component.schema> ;
	.

attack:DataSource
	a owl:Class ;
	rdfs:label "ATT&CK Data Source"@en ;
	rdfs:comment "A grouping of data components. STIX type x-mitre-data-source; ATT&CK ID DSxxxx. Superseded by data components and log sources in spec v3.3.0 (x_mitre_data_source_ref is deprecated, removed in v4.0.0). OPEN: same parent question as attack:DataComponent."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/data-source.schema> ;
	owl:deprecated "true"^^xsd:boolean ;
	.

attack:DetectionStrategy
	a owl:Class ;
	rdfs:subClassOf stonework:DefendTechnique ;
	rdfs:label "ATT&CK Detection Strategy"@en ;
	rdfs:comment "A high-level approach for detecting a technique, organizing platform-specific analytics. STIX type x-mitre-detection-strategy; ATT&CK ID DETxxxx."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/detection-strategy.schema> ;
	skos:scopeNote "A defensive technique, as D3FEND models detection, not a stonework:DetectionPlan: it has no Steps. It contains its platform-specific analytics as more specific techniques (attack:analytic, under stonework:hasTechnique) and stonework:detects the ATT&CK technique."@en ;
	.

attack:Group
	a owl:Class ;
	rdfs:subClassOf stonework:ThreatActorGroup ;
	rdfs:label "ATT&CK Group"@en ;
	rdfs:comment "A threat actor group tracked by a common name in the security community. ATT&CK ID Gxxxx. MITRE publishes each group as a STIX intrusion-set, conflating the actor with the cluster of activity attributed to it. STONEWORK keeps them apart: the STIX intrusion-set stays a stonework:CyberActivityCluster (the activity, a process), and the ATT&CK interpretation step mints a separate attack:Group (the actor, an agent) that the cluster is stonework:attributedTo. The two cannot be one individual: stonework:CyberActivity aligns to BFO process and stonework:Agent to BFO material entity, which BFO holds disjoint (asserted directly in frameworks/bfo.ttl)."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/group.schema> ;
	skos:scopeNote "The group's techniques and software are the intrusion-set's stonework:uses links, written onto the group as well so that 'which groups use T1059' is one hop."@en ;
	.

attack:Malware
	a owl:Class ;
	rdfs:subClassOf
		attack:Software ,
		stonework:MalwareFamily
		;
	rdfs:label "ATT&CK Malware"@en ;
	rdfs:comment "ATT&CK software of STIX type malware."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/software.schema> ;
	.

attack:Matrix
	a owl:Class ;
	rdfs:label "ATT&CK Matrix"@en ;
	rdfs:comment "The arrangement of tactics for one ATT&CK domain (enterprise-attack, mobile-attack, ics-attack). STIX type x-mitre-matrix. Release metadata rather than a domain concept, so it has no STONEWORK parent."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/matrix.schema> ;
	.

attack:Mitigation
	a owl:Class ;
	rdfs:subClassOf stonework:Mitigation ;
	rdfs:label "ATT&CK Mitigation"@en ;
	rdfs:comment "A security concept or class of technologies that can prevent a technique from succeeding. STIX type course-of-action; ATT&CK ID Mxxxx. ATT&CK mitigations are general, so they sit under stonework:Mitigation; their faithful STIX typing (stones:CourseOfAction, under stonework:CourseOfAction) also applies, which is consistent since CourseOfAction is a kind of Mitigation. As a stonework:Mitigation it is a stonework:Behavior, so a ControlPlan or Step can stonework:implements it."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/mitigation.schema> ;
	.

attack:Software
	a owl:Class ;
	rdfs:subClassOf stonework:Product ;
	rdfs:label "ATT&CK Software"@en ;
	rdfs:comment "Malware or a tool used by adversaries. STIX type malware or tool; ATT&CK ID Sxxxx."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/software.schema> ;
	.

attack:SubTechnique
	a owl:Class ;
	rdfs:subClassOf attack:Technique ;
	rdfs:label "ATT&CK Sub-technique"@en ;
	rdfs:comment "A more specific technique: an attack-pattern with x_mitre_is_subtechnique true and an ATT&CK ID of the form Txxxx.yyy. Linked to its parent by attack:subtechniqueOf."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/technique.schema> ;
	.

attack:Tactic
	a owl:Class ;
	rdfs:subClassOf stonework:Tactic ;
	rdfs:label "ATT&CK Tactic"@en ;
	rdfs:comment "The adversary's tactical goal: the reason for performing a technique. STIX type x-mitre-tactic; ATT&CK ID TAxxxx."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/tactic.schema> ;
	.

attack:Technique
	a owl:Class ;
	rdfs:subClassOf stonework:AttackTechnique ;
	rdfs:label "ATT&CK Technique"@en ;
	rdfs:comment "How an adversary achieves a tactical goal. STIX type attack-pattern; ATT&CK ID Txxxx (sub-techniques Txxxx.yyy). Excludes deprecated per-technique mitigations that reuse T-numbers (those are course-of-action objects)."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/technique.schema> ;
	.

attack:Tool
	a owl:Class ;
	rdfs:subClassOf
		attack:Software ,
		stonework:Tool
		;
	rdfs:label "ATT&CK Tool"@en ;
	rdfs:comment "ATT&CK software of STIX type tool: legitimate software that adversaries may use."@en ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/software.schema> ;
	.

attack:alias
	a owl:DatatypeProperty ;
	rdfs:label "alias"@en ;
	rdfs:comment "Another name for a Group, Campaign or Software (aliases, x_mitre_aliases)."@en ;
	rdfs:range xsd:string ;
	.

attack:analytic
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:hasTechnique ;
	rdfs:label "analytic"@en ;
	rdfs:comment "An Analytic that implements a Detection Strategy, from the strategy's x_mitre_analytic_refs. In STONEWORK terms the strategy, a defensive technique, has the analytic as a more specific technique (stonework:hasTechnique)."@en ;
	rdfs:domain attack:DetectionStrategy ;
	rdfs:range attack:Analytic ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/detection-strategy.schema> ;
	.

attack:attackId
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf
		stonework:attackId ,
		stonework:externalId
		;
	rdfs:label "ATT&CK ID"@en ;
	rdfs:comment "The ATT&CK ID: the external_id of the object's mitre-attack external reference (Txxxx, Txxxx.yyy, TAxxxx, Gxxxx, Sxxxx, Cxxxx, Mxxxx, DETxxxx, ANxxxx, DCxxxx, DSxxxx, Axxxx). Not unique across types: deprecated mitigations reuse technique T-numbers, so take it from the object, never look objects up by it without their type. The canonical and source forms are the same, so it specializes both stonework:attackId and stonework:externalId."@en ;
	rdfs:range xsd:string ;
	.

attack:dataComponent
	a owl:ObjectProperty ;
	rdfs:label "data component"@en ;
	rdfs:comment "A Data Component whose telemetry an Analytic needs, from the analytic's x_mitre_log_source_references (each also names a log source and channel)."@en ;
	rdfs:domain attack:Analytic ;
	rdfs:range attack:DataComponent ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/analytic.schema> ;
	.

attack:deprecated
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "deprecated"@en ;
	rdfs:comment "x_mitre_deprecated: true when MITRE no longer maintains the object."@en ;
	rdfs:range xsd:boolean ;
	.

attack:domain
	a owl:DatatypeProperty ;
	rdfs:label "ATT&CK domain"@en ;
	rdfs:comment "x_mitre_domains: enterprise-attack, mobile-attack or ics-attack."@en ;
	rdfs:range xsd:string ;
	.

attack:platform
	a owl:DatatypeProperty ;
	rdfs:label "platform"@en ;
	rdfs:comment "x_mitre_platforms: a platform the object applies to (e.g. Windows, Linux, IaaS, Containers)."@en ;
	rdfs:range xsd:string ;
	.

attack:shortname
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "shortname"@en ;
	rdfs:comment "A tactic's x_mitre_shortname (e.g. credential-access): the phase_name techniques use in kill_chain_phases to name this tactic."@en ;
	rdfs:domain attack:Tactic ;
	rdfs:range xsd:string ;
	.

attack:specVersion
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "ATT&CK spec version"@en ;
	rdfs:comment "x_mitre_attack_spec_version: the ATT&CK Data Model Specification version the object conforms to (e.g. 3.3.0)."@en ;
	rdfs:range xsd:string ;
	.

attack:subtechniqueOf
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:techniqueOf ;
	rdfs:label "subtechnique of"@en ;
	rdfs:comment 'ATT&CK relationship type subtechnique-of: a Sub-technique specializes its parent Technique. Under stonework:techniqueOf, the inverse of stonework:hasTechnique ("a Technique to a more specific Technique it contains").'@en ;
	rdfs:domain attack:SubTechnique ;
	rdfs:range attack:Technique ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/relationship-types> ;
	.

attack:tactic
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:techniqueOf ;
	rdfs:label "tactic"@en ;
	rdfs:comment "The Tactic a Technique serves, from the technique's kill_chain_phases (phase_name matches the tactic's x_mitre_shortname). A technique may serve several tactics. Under stonework:techniqueOf, the inverse of stonework:hasTechnique (\"a Tactic to a Technique that serves its goal\")."@en ;
	rdfs:domain attack:Technique ;
	rdfs:range attack:Tactic ;
	rdfs:seeAlso <https://mitre-attack.github.io/attack-data-model/schemas/sdo/technique.schema> ;
	.

attack:url
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "ATT&CK page"@en ;
	rdfs:comment "The object's page on attack.mitre.org (the url of its mitre-attack external reference), e.g. https://attack.mitre.org/techniques/T1059/. The de facto public identifier for ATT&CK objects; a web page, not the object itself, so kept as a value rather than an owl:sameAs."@en ;
	rdfs:range xsd:anyURI ;
	.

attack:version
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "object version"@en ;
	rdfs:comment "x_mitre_version: the object's own major.minor version."@en ;
	rdfs:range xsd:string ;
	.
