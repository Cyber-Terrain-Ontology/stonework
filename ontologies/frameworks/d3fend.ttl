# imports: https://cyberterrain.org/ns/stonework#

@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frameworks: <https://cyberterrain.org/ns/frameworks/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

frameworks:d3fend
	a owl:Ontology ;
	rdfs:label "STONEWORK: D3FEND 1.5.0 Mapping"@en ;
	dcterms:description "Declares conservative class, property, identifier, and annotation mappings from MITRE D3FEND 1.5.0 into STONEWORK. Load this adapter alongside the official D3FEND ontology when countermeasure knowledge graph reasoning is required; it does not reproduce the D3FEND taxonomy or its OWL restrictions."@en ;
	dcterms:source <https://d3fend.mitre.org/ontologies/d3fend/1.5.0/d3fend.owl> ;
	rdfs:seeAlso <https://d3fend.mitre.org/resources/ontology/> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/d3fend/0.2.0> ;
	owl:versionInfo "0.2.0" ;
	skos:scopeNote "Mappings are intentionally one-way: D3FEND terms remain governed by the source ontology's hierarchy, class/individual punning, and restrictions while gaining compatible STONEWORK types and predicates. No owl:equivalentClass or owl:equivalentProperty claims are made. Where the upper models differ, a D3FEND resource may retain source-native artifact typing while also receiving a STONEWORK functional type such as DigitalIdentity or NetworkService."@en ;
	.

d3f:AccessControlList
	rdfs:subClassOf stonework:AccessControlList ;
	.

d3f:Agent
	rdfs:subClassOf stonework:Agent ;
	.

d3f:AgentGroup
	rdfs:subClassOf stonework:Group ;
	.

d3f:AnalyticTechnique
	rdfs:subClassOf stonework:AnalyticTechnique ;
	.

d3f:Certificate
	rdfs:subClassOf stonework:Certificate ;
	.

d3f:ComputerPlatform
	rdfs:subClassOf stonework:Host ;
	.

d3f:CyberTechnique
	rdfs:subClassOf stonework:CyberTechnique ;
	.

d3f:DefensiveTactic
	rdfs:subClassOf stonework:DefensiveTactic ;
	.

d3f:DefensiveTechnique
	rdfs:subClassOf
		stonework:Countermeasure ,
		stonework:DefendTechnique
		;
	.

d3f:DigitalArtifact
	rdfs:subClassOf stonework:DigitalArtifact ;
	.

d3f:DigitalEvent
	rdfs:subClassOf stonework:CyberActivity ;
	.

d3f:DigitalIdentity
	rdfs:subClassOf stonework:DigitalIdentity ;
	.

d3f:Directory
	rdfs:subClassOf stonework:Directory ;
	.

d3f:DomainName
	rdfs:subClassOf
		stonework:Domain ,
		stonework:Identifier
		;
	.

d3f:Event
	rdfs:subClassOf stonework:Event ;
	.

d3f:File
	rdfs:subClassOf stonework:File ;
	.

d3f:Host
	rdfs:subClassOf stonework:Host ;
	.

d3f:IPAddress
	rdfs:subClassOf
		stonework:IPAddress ,
		stonework:Identifier
		;
	.

d3f:Identifier
	rdfs:subClassOf stonework:Identifier ;
	.

d3f:Log
	rdfs:subClassOf stonework:Log ;
	.

d3f:MACAddress
	rdfs:subClassOf stonework:MACAddress ;
	.

d3f:NetworkNode
	rdfs:subClassOf stonework:Infrastructure ;
	.

d3f:NetworkServiceApplicationProcess
	rdfs:subClassOf stonework:NetworkService ;
	.

d3f:NetworkTraffic
	rdfs:subClassOf stonework:NetworkTraffic ;
	.

d3f:OffensiveTactic
	rdfs:subClassOf stonework:OffensiveTactic ;
	.

d3f:OffensiveTechnique
	rdfs:subClassOf stonework:AttackTechnique ;
	.

d3f:OperationalActivityPlan
	rdfs:subClassOf stonework:Behavior ;
	.

d3f:Organization
	rdfs:subClassOf stonework:Organization ;
	.

d3f:Person
	rdfs:subClassOf stonework:Person ;
	.

d3f:PhysicalArtifact
	rdfs:subClassOf stonework:PhysicalArtifact ;
	.

d3f:Procedure
	rdfs:subClassOf stonework:Procedure ;
	.

d3f:Process
	rdfs:subClassOf stonework:RuntimeProcess ;
	.

d3f:Sensor
	rdfs:subClassOf stonework:Sensor ;
	.

d3f:Step
	rdfs:subClassOf stonework:Step ;
	.

d3f:System
	rdfs:subClassOf stonework:Infrastructure ;
	.

d3f:Technique
	rdfs:subClassOf stonework:Technique ;
	.

d3f:URL
	rdfs:subClassOf stonework:URI ;
	.

d3f:UserAccount
	rdfs:subClassOf stonework:UserAccount ;
	.

d3f:UserGroup
	rdfs:subClassOf stonework:UserGroup ;
	.

d3f:Vulnerability
	rdfs:subClassOf stonework:Vulnerability ;
	.

d3f:Weakness
	rdfs:subClassOf stonework:Weakness ;
	.

d3f:associated-with
	rdfs:subPropertyOf stonework:relatedTo ;
	.

d3f:counters
	rdfs:subPropertyOf stonework:counters ;
	.

d3f:d3fend-id
	rdfs:subPropertyOf stonework:externalId ;
	.

d3f:definition
	rdfs:subPropertyOf skos:definition ;
	.

d3f:detects
	rdfs:subPropertyOf stonework:detects ;
	.

d3f:enables
	rdfs:subPropertyOf stonework:techniqueOf ;
	.

d3f:synonym
	rdfs:subPropertyOf skos:altLabel ;
	.
