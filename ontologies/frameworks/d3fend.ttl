# imports: https://cyberterrain.org/ns/stonework#

@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frameworks: <https://cyberterrain.org/ns/frameworks/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

frameworks:d3fend
	a owl:Ontology ;
	rdfs:label "STONEWORK: D3FEND Mapping"@en ;
	dcterms:description "Declares subclass mappings from D3FEND classes into STONEWORK. D3FEND classes are mapped as subclasses of their STONEWORK counterparts, consistent with STONEWORK's role as the middle-tier ontology. Load alongside D3FEND when countermeasure knowledge graph reasoning is required."@en ;
	rdfs:seeAlso <http://d3fend.mitre.org/ontologies/d3fend.owl> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/d3fend/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

d3f:Agent
	rdfs:subClassOf stonework:Agent ;
	.

