# imports: https://cyberterrain.org/ns/frameworks/stix
# imports: https://cyberterrain.org/ns/stonework#
# imports: https://cyberterrain.org/ns/stonework/categories#

@prefix killchain: <https://cyberterrain.org/ns/frameworks/killchain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stones: <https://cyberterrain.org/ns/stones#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/frameworks/killchain>
	a owl:Ontology ;
	rdfs:label "Cyber Kill Chain Framework Ontology"@en ;
	rdfs:comment "OWL vocabulary for the Lockheed Martin Cyber Kill Chain framework."@en ;
	owl:imports
		<https://cyberterrain.org/ns/frameworks/stix> ,
		<https://cyberterrain.org/ns/stonework#> ,
		<https://cyberterrain.org/ns/stonework/categories#>
		;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/killchain/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

killchain:ActionsOnObjectives
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary achieves their intended goals (data exfiltration, data destruction, encryption for ransom, etc.)."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "actions-on-objectives" ;
	skos:prefLabel "Actions on Objectives"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "actions-on-objectives" ;
	.

killchain:CommandAndControl
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary establishes a command channel to remotely control the compromised system."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "command-and-control" ;
	skos:prefLabel "Command and Control"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "command-and-control" ;
	.

killchain:Delivery
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary transmits the weaponized payload to the target (e.g., spear-phishing email, USB drop, drive-by download)."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "delivery" ;
	skos:prefLabel "Delivery"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "delivery" ;
	.

killchain:Exploitation
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary triggers a vulnerability or exploit on the target system to execute code."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "exploitation" ;
	skos:prefLabel "Exploitation"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "exploitation" ;
	.

killchain:Installation
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary installs malware on the target system to establish persistence."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "installation" ;
	skos:prefLabel "Installation"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "installation" ;
	.

killchain:Reconnaissance
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary gathers information to identify and select targets (e.g., public source reconnaissance, phishing email harvesting)."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "reconnaissance" ;
	skos:prefLabel "Reconnaissance"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "reconnaissance" ;
	.

killchain:Weaponization
	a
		owl:NamedIndividual ,
		skos:Concept ,
		stones:KillChainPhase ,
		stonework:KillChainPhase
		;
	skos:definition "The adversary couples a remote access trojan with an exploit into a deliverable payload (e.g., creating a malicious PDF or Word document)."@en ;
	skos:inScheme
		stonework:categoryScheme ,
		stonework:killChainPhaseScheme
		;
	skos:notation "weaponization" ;
	skos:prefLabel "Weaponization"@en ;
	stones:killChainName "lockheed-martin-cyber-kill-chain" ;
	stones:phaseName "weaponization" ;
	.

killchain:killChainPhase
	a owl:ObjectProperty ;
	rdfs:range stonework:KillChainPhase ;
	rdfs:seeAlso
		stones:killChainName ,
		stones:phaseName
		;
	skos:definition "Links an entity to one or more phases of a kill chain framework."@en ;
	skos:prefLabel "kill chain phase"@en ;
	.
