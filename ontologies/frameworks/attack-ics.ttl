# imports: https://cyberterrain.org/ns/stonework#

@prefix attackics: <https://cyberterrain.org/ns/frameworks/attack-ics#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/frameworks/attack-ics>
	a owl:Ontology ;
	rdfs:label "STONEWORK: ATT&CK ICS Mapping"@en ;
	dcterms:description "Declares a lightweight vocabulary for MITRE ATT&CK for ICS techniques, assets, and mitigations as STONEWORK types. This adapter does not reproduce the ATT&CK ICS matrix or STIX x-mitre-asset dataset; load official ATT&CK ICS data alongside it when instance-level coverage is required."@en ;
	dcterms:source <https://attack.mitre.org/matrices/ics/> ;
	rdfs:seeAlso <https://attack.mitre.org/assets/> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/attack-ics/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	skos:scopeNote "Mappings are one-way subclass and subproperty claims. ICS asset kinds (PLC, RTU, SIS, HMI, historian, engineering workstation) are SKOS values in stonework:icsAssetTypeScheme, not OWL subclasses of attackics:Asset."@en ;
	.

attackics:Asset
	a owl:Class ;
	rdfs:subClassOf stonework:PhysicalArtifact ;
	rdfs:label "ATT&CK ICS Asset"@en ;
	rdfs:comment "An industrial control or operational-technology asset as described by MITRE ATT&CK ICS x-mitre-asset. Classify the asset role with stonework:hasICSAssetType when the categories module is loaded. An asset that also runs processes and participates in networks may additionally be typed as stonework:Host."@en ;
	.

attackics:Mitigation
	a owl:Class ;
	rdfs:subClassOf stonework:Mitigation ;
	rdfs:label "ATT&CK ICS Mitigation"@en ;
	rdfs:comment "A reusable defensive measure from MITRE ATT&CK ICS that reduces the likelihood or impact of one or more ICS techniques."@en ;
	.

attackics:Technique
	a owl:Class ;
	rdfs:subClassOf stonework:AttackTechnique ;
	rdfs:label "ATT&CK ICS Technique"@en ;
	rdfs:comment "An adversary method from MITRE ATT&CK ICS used to achieve a tactical objective against industrial control systems."@en ;
	.

attackics:attackId
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "ATT&CK ICS ID"@en ;
	rdfs:comment "ATT&CK ICS identifier string, e.g. 'T0801' for a technique or 'M0801' for a mitigation."@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			attackics:Asset
			attackics:Mitigation
			attackics:Technique
		) ;
	] ;
	rdfs:range xsd:string ;
	.

attackics:mitigatesTechnique
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:mitigatesAttackPattern ;
	rdfs:label "mitigates technique"@en ;
	rdfs:comment "ATT&CK ICS technique that this mitigation helps address."@en ;
	rdfs:domain attackics:Mitigation ;
	rdfs:range attackics:Technique ;
	.

attackics:targetsAsset
	a owl:ObjectProperty ;
	rdfs:label "targets asset"@en ;
	rdfs:comment "ICS asset that this technique is known to target."@en ;
	rdfs:domain attackics:Technique ;
	rdfs:range attackics:Asset ;
	.
