# imports: https://cyberterrain.org/ns/stonework#

@prefix cpe: <https://cyberterrain.org/ns/frameworks/cpe#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/frameworks/cpe>
	a owl:Ontology ;
	rdfs:label "CPE Framework Ontology"@en ;
	rdfs:comment "OWL vocabulary for NVD Common Platform Enumeration (CPE) 2.3 data as represented in the CTI Encyclopedia. Stub stonework:VersionedProduct individuals are created by the CVE serializer; this ontology describes the enrichment properties added by the CPE ingest."@en ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/cpe/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

cpe:cpeName
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf stonework:cpeUri ;
	rdfs:label "CPE name"@en ;
	rdfs:comment "Full CPE 2.3 URI string, e.g. 'cpe:2.3:a:autodesk:autocad:2025:*:*:*:*:*:*:*'."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:string ;
	.

cpe:cpeNameId
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "CPE name ID"@en ;
	rdfs:comment "NVD-assigned UUID for this CPE entry."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:string ;
	.

cpe:created
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf stonework:created ;
	rdfs:label "created"@en ;
	rdfs:comment "Date this CPE entry was created in the NVD dictionary."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:dateTime ;
	.

cpe:deprecated
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "deprecated"@en ;
	rdfs:comment "True if NVD has deprecated this CPE entry."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:boolean ;
	.

cpe:deprecatedBy
	a owl:ObjectProperty ;
	rdfs:label "deprecated by"@en ;
	rdfs:comment "Links a deprecated CPE to the successor CPE that replaces it."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range stonework:VersionedProduct ;
	.

cpe:lastModified
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "last modified"@en ;
	rdfs:comment "Date this CPE entry was last modified in the NVD dictionary."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range xsd:dateTime ;
	.

cpe:title
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf stonework:title ;
	rdfs:label "title"@en ;
	rdfs:comment "Human-readable product title with language tag, as supplied by NVD. May appear in multiple languages."@en ;
	rdfs:domain stonework:VersionedProduct ;
	rdfs:range rdf:langString ;
	.
