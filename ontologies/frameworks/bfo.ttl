# imports: https://cyberterrain.org/ns/stonework#

@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frameworks: <https://cyberterrain.org/ns/frameworks/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

frameworks:bfo
	a owl:Ontology ;
	rdfs:label "STONEWORK: BFO 2020 Mapping"@en ;
	dcterms:description "Declares subclass mappings from STONEWORK classes to Basic Formal Ontology (BFO) 2020. This file carries no dependency on BFO imports — it asserts alignment axioms only. Load alongside BFO 2020 when formal BFO reasoning is required."@en ;
	rdfs:seeAlso <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/bfo/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

stonework:Agent
	rdfs:subClassOf bfo:0000040 ;
	.

stonework:Behavior
	rdfs:subClassOf bfo:0000031 ;
	.

stonework:Countermeasure
	rdfs:subClassOf bfo:0000031 ;
	.

stonework:CyberActivity
	rdfs:subClassOf
		bfo:0000003 ,
		bfo:0000015
		;
	.

stonework:CyberEntity
	rdfs:subClassOf bfo:0000002 ;
	.

stonework:DigitalArtifact
	rdfs:subClassOf bfo:0000031 ;
	.

stonework:Impact
	rdfs:subClassOf bfo:0000019 ;
	.

stonework:Infrastructure
	rdfs:subClassOf bfo:0000040 ;
	.

stonework:IntelligenceProduct
	rdfs:subClassOf bfo:0000031 ;
	.

stonework:Likelihood
	rdfs:subClassOf bfo:0000019 ;
	.

stonework:Process
	rdfs:subClassOf bfo:0000015 ;
	.

stonework:Risk
	rdfs:subClassOf bfo:0000016 ;
	.

stonework:RiskFactor
	rdfs:subClassOf bfo:0000020 ;
	.

stonework:Role
	rdfs:subClassOf bfo:0000023 ;
	.

stonework:SecurityCondition
	rdfs:subClassOf bfo:0000020 ;
	.

stonework:Vulnerability
	rdfs:subClassOf bfo:0000016 ;
	.

stonework:Weakness
	rdfs:subClassOf bfo:0000016 ;
	.
