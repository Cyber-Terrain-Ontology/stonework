@prefix dns: <https://cyberterrain.org/ns/frameworks/dns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cyberterrain.org/ns/frameworks/dns>
	a owl:Ontology ;
	rdfs:label "DNS Framework Ontology"@en ;
	rdfs:comment "Describes elements within the DNS system."@en ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/dns/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

dns:A
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "A Record"@en ;
	rdfs:comment "Resolves a text hostname to an IPv4 Address"@en ;
	owl:disjointWith
		dns:AAAA ,
		dns:CNAME ,
		dns:MX ,
		dns:NS ,
		dns:PTR ,
		dns:TXT
		;
	.

dns:AAAA
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "AAAA Record"@en ;
	rdfs:comment "Resolves a text hostname to an IPv6 Address"@en ;
	.

dns:CNAME
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "CNAME Record"@en ;
	rdfs:comment "a CNAME record (Canonical Name) acts as an alias from one DNS host entry to another, allowing multiple names to resolve to the same address"@en ;
	.

dns:DNSService
	a owl:Class ;
	rdfs:subClassOf stonework:NetworkService ;
	rdfs:label "DNS Service"@en ;
	rdfs:comment "A DNS Service is a network service that resolves names to addresses and other information about domains and hosts. It is commonly used for domain name resolution, email routing, and other functions related to the Domain Name System."@en ;
	.

dns:DNSrecord
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	rdfs:label "DNS Record"@en ;
	rdfs:comment "A Generic DNS Record, within a DNS Zone"@en ;
	.

dns:MX
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "MX Record"@en ;
	rdfs:comment "MX records indicate where an SMTP server to receive email sent tot the domain can be connected to at"@en ;
	.

dns:NICHandle
	a owl:Class ;
	rdfs:subClassOf stonework:Identifier ;
	rdfs:label "NIC Handle"@en ;
	rdfs:comment "A unique alphanumeric token assigned by a domain registrar or registry to identify a registrant contact record. Domains sharing a NIC Handle may be attributed to the same person or organization."@en ;
	.

dns:NS
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "NS Record"@en ;
	rdfs:comment "NS records indicate the Name Server IP address for a given domain"@en ;
	.

dns:PTR
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "PTR Record"@en ;
	rdfs:comment "PTR records resolve an IP Address to hostname"@en ;
	.

dns:Query
	a owl:Class ;
	rdfs:subClassOf stonework:Event ;
	rdfs:label "DNS Query"@en ;
	rdfs:comment "An observable DNS name resolution request — the act of a client asking a resolver to look up a name or record type. A Query is a network occurrence at a point in time, not a stored artifact."@en ;
	.

dns:QueryRecord
	a owl:Class ;
	rdfs:subClassOf stonework:Log ;
	rdfs:label "DNS Query Record"@en ;
	rdfs:comment "A persisted log entry capturing the details of a specific DNS Query event, as recorded by a resolver, DNS server, or network sensor. Represents the artifact form of the query — the data at rest — as distinct from the Query itself (the network occurrence). Typically includes the queried name, record type requested, source IP, timestamp, response code, and resolved values returned."@en ;
	.

dns:Registrant
	a owl:Class ;
	rdfs:subClassOf stonework:Agent ;
	rdfs:label "Domain Registrant"@en ;
	rdfs:comment "A Person or Organization that is the registered owner of a DNS Domain Name within a TLD zone"@en ;
	.

dns:Registrar
	a owl:Class ;
	rdfs:subClassOf stonework:Organization ;
	rdfs:label "Domain Registrar"@en ;
	rdfs:comment "An organization that arbitrates the acquisition and global registration of DNS Domains"@en ;
	.

dns:TXT
	a owl:Class ;
	rdfs:subClassOf dns:DNSrecord ;
	rdfs:label "TXT Record"@en ;
	rdfs:comment "TXT records encode human-readable information into DNS Zones. They may be used for extended information about zones for use by other programs, such as geographic location data, or cryptographic signing keys (DNSSEC)"@en ;
	.

dns:Zone
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	rdfs:label "DNS Zone"@en ;
	rdfs:comment "A specific namespace within DNS assigned to a finite set of authoritative nameservers, defining the set of records that resolve within it. A Zone is a data artifact — a configuration boundary — not itself a service."@en ;
	.

dns:hasAuthNS
	a owl:ObjectProperty ;
	rdfs:label "dns:hasAuthNS"@en ;
	rdfs:comment "These nameservers are listed as the official servers to resolve addresses and zones in this domain, all other nameservers should only cache the resolution from these servers"@en ;
	rdfs:domain stonework:Domain ;
	rdfs:range dns:NS ;
	owl:inverseOf dns:isAuthNSfor ;
	.

dns:hasContactInfo
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:hasContactInfo"@en ;
	rdfs:comment "Registrant name and (mailing) address"@en ;
	rdfs:domain dns:Registrant ;
	rdfs:range stonework:Agent ;
	.

dns:hasCustomer
	a owl:ObjectProperty ;
	rdfs:label "dns:hasCustomer"@en ;
	rdfs:comment "this domain registrar has registered a domain on the root DNS servers for this customer"@en ;
	rdfs:domain dns:Registrar ;
	rdfs:range dns:Registrant ;
	.

dns:hasNICHandle
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:hasNICHandle"@en ;
	rdfs:comment "The NIC Handle string value assigned to this registrant by their registrar or registry."@en ;
	rdfs:domain dns:Registrant ;
	rdfs:range xsd:normalizedString ;
	.

dns:hasRecord
	a
		owl:ObjectProperty ,
		owl:InverseFunctionalProperty
		;
	rdfs:label "dns:hasRecord"@en ;
	rdfs:comment "DNS records exist within a specified zone (usually a domain or subdomain) and are commonly written it in a way that makes them relative to the base address of the zone. (ie, a hostname will then have the zone name appended to the right of it)"@en ;
	rdfs:domain dns:Zone ;
	rdfs:range dns:DNSrecord ;
	owl:inverseOf dns:inZone ;
	.

dns:hasRegistrant
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf stonework:registeredTo ;
	rdfs:label "dns:hasRegistrant"@en ;
	rdfs:comment "The company or individual who purchased and registered this domain"@en ;
	rdfs:domain stonework:Domain ;
	rdfs:range dns:Registrant ;
	owl:inverseOf dns:registeredDomain ;
	.

dns:hasRegistrar
	a owl:ObjectProperty ;
	rdfs:subPropertyOf stonework:registeredWith ;
	rdfs:label "dns:hasRegistrar"@en ;
	rdfs:comment "The domain registrar the domain has been registered with"@en ;
	rdfs:domain stonework:Domain ;
	rdfs:range dns:Registrar ;
	.

dns:hasRegistrarURL
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:hasRegistrarURL"@en ;
	rdfs:comment "the URL for the registrar's public website"@en ;
	rdfs:domain dns:Registrar ;
	rdfs:range stonework:URI ;
	.

dns:hasRegistrarWHOIS
	a owl:ObjectProperty ;
	rdfs:label "dns:hasRegistrarWHOIS"@en ;
	rdfs:comment "The address for the WHOIS server containing information about domains registered through this registrar"@en ;
	rdfs:domain dns:Registrar ;
	rdfs:range dns:A ;
	.

dns:hasZone
	a
		owl:ObjectProperty ,
		owl:InverseFunctionalProperty
		;
	rdfs:label "dns:hasZone"@en ;
	rdfs:comment "domains may contain multiple zones ('subdomains') defining a range of records that will resolve, with names relative to the name of the zone."@en ;
	rdfs:domain stonework:Domain ;
	rdfs:range dns:Zone ;
	owl:inverseOf dns:inDomain ;
	.

dns:inDomain
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:inDomain"@en ;
	rdfs:comment "this DNS zone is attached to (and relative to) this zone or domain"@en ;
	rdfs:domain dns:Zone ;
	rdfs:range stonework:Domain ;
	owl:inverseOf dns:hasZone ;
	.

dns:inZone
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:inZone"@en ;
	rdfs:comment "this DNS record is attached to (and relative to) this DNS zone."@en ;
	rdfs:domain dns:DNSrecord ;
	rdfs:range dns:Zone ;
	.

dns:isAliasOf
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:isAliasOf"@en ;
	rdfs:comment "This DNS Record acts as an alias or pointer to another DNS Record, and does not actually resolve to a distinct IP Address by itself"@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			dns:CNAME
			dns:MX
			dns:NS
			dns:PTR
		) ;
	] ;
	rdfs:range dns:A ;
	.

dns:isAuthNSfor
	a owl:ObjectProperty ;
	rdfs:label "dns:isAuthNSfor"@en ;
	rdfs:domain dns:NS ;
	rdfs:range stonework:Domain ;
	owl:inverseOf dns:hasAuthNS ;
	.

dns:isAuthoritativeResponse
	a owl:DatatypeProperty ;
	rdfs:label "dns:isAuthoritativeResponse"@en ;
	rdfs:comment "Is this DNS Query coming from an Authoritative Nameserver for the listed resource?"@en ;
	rdfs:domain dns:Query ;
	rdfs:range xsd:boolean ;
	.

dns:queryRecordOf
	a owl:ObjectProperty ;
	rdfs:label "dns:queryRecordOf"@en ;
	rdfs:comment "Links a persisted QueryRecord to the DNS Query event it captures."@en ;
	rdfs:domain dns:QueryRecord ;
	rdfs:range dns:Query ;
	.

dns:recievedFrom
	a owl:ObjectProperty ;
	rdfs:label "dns:recievedFrom"@en ;
	rdfs:comment "the IP address this resolver query came from."@en ;
	rdfs:domain dns:Query ;
	rdfs:range stonework:IPAddress ;
	.

dns:registeredDomain
	a owl:ObjectProperty ;
	rdfs:label "dns:registeredDomain"@en ;
	rdfs:comment "this person or organization is the listed owner of this domain"@en ;
	rdfs:domain dns:Registrant ;
	rdfs:range stonework:Domain ;
	owl:inverseOf dns:hasRegistrant ;
	.

dns:registeredOn
	a
		owl:DatatypeProperty ,
		owl:FunctionalProperty
		;
	rdfs:subPropertyOf stonework:registrationDate ;
	rdfs:label "dns:registeredOn"@en ;
	rdfs:comment "the date the domain was registered on"@en ;
	rdfs:domain stonework:Domain ;
	rdfs:range xsd:dateTime ;
	.

dns:resolvesToAddress
	a owl:ObjectProperty ;
	rdfs:label "dns:resolvesToAddress"@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			dns:A
			dns:AAAA
		) ;
	] ;
	rdfs:range stonework:IPAddress ;
	.

dns:resolvesToRecord
	a
		owl:ObjectProperty ,
		owl:FunctionalProperty
		;
	rdfs:label "dns:resolvesToRecord"@en ;
	rdfs:domain stonework:IPAddress ;
	rdfs:range dns:PTR ;
	.

dns:usingMX
	a owl:ObjectProperty ;
	rdfs:label "dns:usingMX"@en ;
	rdfs:comment "Mail Relays use MX Records to determine what host to deliver email to, when only a domain or zones and not a specific hostname is not mentioned in the email address"@en ;
	rdfs:domain [
		a owl:Class ;
		owl:unionOf (
			stonework:Domain
			dns:Zone
		) ;
	] ;
	rdfs:range dns:MX ;
	.
