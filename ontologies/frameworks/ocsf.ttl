frameworks:ocsf
	a owl:Ontology ;
	rdfs:label "STONEWORK: OCSF 1.9.0 Mapping"@en ;
	dcterms:description "An OWL adapter for the Open Cybersecurity Schema Framework (OCSF) 1.9.0 core event taxonomy. OCSF event categories and concrete event classes are represented as subclasses of stonework:Event while retaining their published category and class identifiers. The adapter does not copy the OCSF attribute dictionary or impose JSON-schema constraints."@en ;
	dcterms:source <https://github.com/ocsf/ocsf-schema/tree/1.9.0> ;
	rdfs:seeAlso <https://schema.ocsf.io/1.9.0/> ;
	owl:imports <https://cyberterrain.org/ns/stonework#> ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/ocsf/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

