@prefix frameworks: <https://cyberterrain.org/ns/frameworks/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stones: <https://cyberterrain.org/ns/stones#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix stonex: <https://cyberterrain.org/ns/stonex#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

frameworks:stix
	a owl:Ontology ;
	rdfs:label "STONES: STIX Framework Ontology"@en ;
	rdfs:comment "A mapping of the STONES Ontology to STONEWORK. Provides a class hierarchy for all STONES Domain Objects (SDOs), Cyber Observable Objects (SCOs), Relationship Objects (SROs), Meta Objects, and structured sub-types, together with datatype and object properties covering all standard STONES properties."@en ;
	owl:versionIRI <https://cyberterrain.org/ns/frameworks/stix/0.1.0> ;
	owl:versionInfo "0.1.0" ;
	.

stones:ArtifactObject
	a owl:Class ;
	rdfs:subClassOf stonework:DigitalArtifact ;
	.

