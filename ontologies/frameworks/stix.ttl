@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix frameworks: <https://cyberterrain.org/ns/frameworks/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stones: <https://cyberterrain.org/ns/stones#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@base <https://cyberterrain.org/ns/frameworks/stonesx> .

###  https://cyberterrain.org/ns/frameworks/stonesx
frameworks:stonesx rdf:type owl:Ontology ;
                   owl:imports <https://cyberterrain.org/ns/stones#> , <https://cyberterrain.org/ns/stonework#> ;
                   rdfs:label "STONES Framework Ontology"@en ;
                   rdfs:comment "A mapping of the STONES Ontology to STONEWORK. Provides a class hierarchy for all STONES Domain Objects (SDOs), Cyber Observable Objects (SCOs), Relationship Objects (SROs), Meta Objects, and structured sub-types, together with datatype and object properties covering all standard STONES properties."@en .


#################################################################
#    Data Properties
#################################################################

###  https://cyberterrain.org/ns/stones#relationshipType
stones:relationshipType rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
                        rdfs:domain stones:Relationship ;
                        rdfs:range xsd:string ;
                        skos:prefLabel "relationshipType" ;
                        skos:definition "The relationship_type string value from the STIX 2.1 SRO (e.g. 'uses', 'mitigates', 'subtechnique-of'). Drawn from the STIX 2.1 open vocabulary; corresponding named individuals are declared as stones:RelationshipTypeVocabulary instances in vocabularies.ttl. A shortcut object property is also asserted: stones:<type_underscored> from source to target." .


#################################################################
#    General Axioms
#################################################################

###  https://cyberterrain.org/ns/stones#ArtifactObject
stones:ArtifactObject rdfs:subClassOf stonework:DigitalArtifact .

###  https://cyberterrain.org/ns/stones#AttackPattern
stones:AttackPattern rdfs:subClassOf stonework:AttackPattern .

###  https://cyberterrain.org/ns/stones#attributed_to
stones:attributed_to rdfs:subPropertyOf stonework:attributedTo .

###  https://cyberterrain.org/ns/stones#AutonomousSystemObject
stones:AutonomousSystemObject rdfs:subClassOf stonework:AutonomousSystem .

###  https://cyberterrain.org/ns/stones#Campaign
stones:Campaign rdfs:subClassOf stonework:Campaign .

###  https://cyberterrain.org/ns/stones#CourseOfAction
stones:CourseOfAction rdfs:subClassOf stonework:Mitigation .

###  https://cyberterrain.org/ns/stones#detects
stones:detects rdfs:subPropertyOf stonework:detects .

###  https://cyberterrain.org/ns/stones#DomainNameObject
stones:DomainNameObject rdfs:subClassOf stonework:Domain .

###  https://cyberterrain.org/ns/stones#EmailAddressObject
stones:EmailAddressObject rdfs:subClassOf stonework:EmailAddress .

###  https://cyberterrain.org/ns/stones#exploits
stones:exploits rdfs:subPropertyOf stonework:exploits .

###  https://cyberterrain.org/ns/stones#FileObject
stones:FileObject rdfs:subClassOf stonework:File .

###  https://cyberterrain.org/ns/stones#Hash
stones:Hash rdfs:subClassOf stonework:Hash .

###  https://cyberterrain.org/ns/stones#Identity
stones:Identity rdfs:subClassOf stonework:Agent .

###  https://cyberterrain.org/ns/stones#indicates
stones:indicates rdfs:subPropertyOf stonework:indicates .

###  https://cyberterrain.org/ns/stones#Infrastructure
stones:Infrastructure rdfs:subClassOf stonework:Infrastructure .

###  https://cyberterrain.org/ns/stones#IPv4AddressObject
stones:IPv4AddressObject rdfs:subClassOf stonework:IPAddress .

###  https://cyberterrain.org/ns/stones#IPv6AddressObject
stones:IPv6AddressObject rdfs:subClassOf stonework:IPAddress .

###  https://cyberterrain.org/ns/stones#Location
stones:Location rdfs:subClassOf stonework:Location .

###  https://cyberterrain.org/ns/stones#MACAddressObject
stones:MACAddressObject rdfs:subClassOf stonework:Infrastructure .

###  https://cyberterrain.org/ns/stones#Malware
stones:Malware rdfs:subClassOf stonework:Malware .

###  https://cyberterrain.org/ns/stones#mitigates
stones:mitigates rdfs:subPropertyOf stonework:mitigates .

###  https://cyberterrain.org/ns/stones#MutexObject
stones:MutexObject rdfs:subClassOf stonework:DigitalArtifact .

###  https://cyberterrain.org/ns/stones#NetworkTrafficObject
stones:NetworkTrafficObject rdfs:subClassOf stonework:NetworkTraffic .

###  https://cyberterrain.org/ns/stones#ProcessObject
stones:ProcessObject rdfs:subClassOf stonework:RuntimeProcess .

###  https://cyberterrain.org/ns/stones#related_to
stones:related_to rdfs:subPropertyOf stonework:relatedTo .

###  https://cyberterrain.org/ns/stones#revoked_by
stones:revoked_by rdfs:subPropertyOf stonework:revokedBy .

###  https://cyberterrain.org/ns/stones#SoftwareObject
stones:SoftwareObject rdfs:subClassOf stonework:Product .

###  https://cyberterrain.org/ns/stones#subtechnique_of
stones:subtechnique_of rdfs:subPropertyOf stonework:techniqueOf .

###  https://cyberterrain.org/ns/stones#targets
stones:targets rdfs:subPropertyOf stonework:targets .

###  https://cyberterrain.org/ns/stones#ThreatActor
stones:ThreatActor rdfs:subClassOf stonework:ThreatActor .

###  https://cyberterrain.org/ns/stones#Tool
stones:Tool rdfs:subClassOf stonework:Tool .

###  https://cyberterrain.org/ns/stones#URLObject
stones:URLObject rdfs:subClassOf stonework:URL .

###  https://cyberterrain.org/ns/stones#UserAccountObject
stones:UserAccountObject rdfs:subClassOf stonework:UserAccount .

###  https://cyberterrain.org/ns/stones#uses
stones:uses rdfs:subPropertyOf stonework:uses .

###  https://cyberterrain.org/ns/stones#Vulnerability
stones:Vulnerability rdfs:subClassOf stonework:Vulnerability .
