###  https://cyberterrain.org/ns/stones#Vulnerability
stones:Vulnerability rdfs:subClassOf stonework:Vulnerability .

###  https://cyberterrain.org/ns/stones#WindowsRegistryKeyObject
stones:WindowsRegistryKeyObject rdfs:subClassOf stonework:Registry .

###  https://cyberterrain.org/ns/stones#WindowsRegistryValue
stones:WindowsRegistryValue rdfs:subClassOf stonework:Registry .


#################################################################
#    Attack Motivation Vocabulary Mappings
#################################################################

###  Map stones:AttackMotivationVocabulary to stonework:Motivation
stones:AttackMotivationVocabulary rdfs:subClassOf stonework:Motivation .

###  Map stonex vocabulary individuals to stonework Motivation named individuals
stonex:_accidental owl:sameAs stonework:motivationAccidental .
stonex:_coercion owl:sameAs stonework:motivationCoercion .
stonex:_dominance owl:sameAs stonework:motivationDominance .
stonex:_ideology owl:sameAs stonework:motivationIdeology .
stonex:_notoriety owl:sameAs stonework:motivationNotoriety .
stonex:_organizational-gain owl:sameAs stonework:motivationOrganizationalGain .
stonex:_personal-gain owl:sameAs stonework:motivationPersonalGain .
stonex:_personal-satisfaction owl:sameAs stonework:motivationPersonalSatisfaction .
stonex:_revenge owl:sameAs stonework:motivationRevenge .
stonex:_unpredictable owl:sameAs stonework:motivationUnpredictable .


#################################################################
#    Infrastructure Type Vocabulary Mappings
#################################################################

stones:InfrastuctureTypeVocabulary rdfs:subClassOf stonework:InfrastructureType .

stonex:_amplification owl:sameAs stonework:infraTypeAmplification .
stonex:_anonymization owl:sameAs stonework:infraTypeAnonymization .
stonex:_botnet owl:sameAs stonework:infraTypeBotnet .
stonex:_command-and-control owl:sameAs stonework:infraTypeC2 .
stonex:_exfiltration owl:sameAs stonework:infraTypeExfiltration .
stonex:_firewall owl:sameAs stonework:infraTypeFirewall .
stonex:_hosting-malware owl:sameAs stonework:infraTypeHostingMalware .
stonex:_hosting-target-lists owl:sameAs stonework:infraTypeHostingTargetLists .
stonex:_phishing owl:sameAs stonework:infraTypePhishing .
stonex:_reconnaissance owl:sameAs stonework:infraTypeReconnaissance .
stonex:_routers-switches owl:sameAs stonework:infraTypeRoutersSwitches .
stonex:_staging owl:sameAs stonework:infraTypeStaging .
stonex:_workstation owl:sameAs stonework:infraTypeWorkstation .


