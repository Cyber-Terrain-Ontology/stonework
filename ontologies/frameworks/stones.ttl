@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix stones:    <https://cyberterrain.org/ns/stones#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix stonesx:   <https://cyberterrain.org/ns/frameworks/stonesx#> .

# --- Ontology declaration -------------------------------------------

<https://cyberterrain.org/ns/frameworks/stonesx>
    a owl:Ontology ;
    rdfs:label "STONES Framework Ontology"@en ;
    rdfs:comment "A mapping of the STONES Ontology to STONEWORK. Provides a class hierarchy for all STONES Domain Objects (SDOs), Cyber Observable Objects (SCOs), Relationship Objects (SROs), Meta Objects, and structured sub-types, together with datatype and object properties covering all standard STONES properties."@en ;
    owl:imports <https://cyberterrain.org/ns/stonework#> , <https://cyberterrain.org/ns/stones#> .

# --- Equivalent Classes --------------------------------------------------------

stones:AutonomousSystemObject       owl:equivalentClass     stonework:AutonomousSystem .
stones:AttackPattern                owl:equivalentClass     stonework:AttackPattern .
stones:Campaign                     owl:equivalentClass     stonework:Campaign .
stones:EmailAddressObject           owl:equivalentClass     stonework:EmailAddress .
stones:FileObject                   owl:equivalentClass     stonework:File .
stones:Infrastructure               owl:equivalentClass     stonework:Infrastructure .
stones:Hash                         owl:equivalentClass     stonework:Hash .
stones:StixCyberobservableObject    owl:equivalentClass     stonework:Indicators .
stones:Tool                         owl:equivalentClass     stonework:Tool .
stones:ProcessObject                owl:equivalentClass     stonework:OSProcess .
stones:ThreatActor                  owl:equivalentClass     stonework:ThreatActor .
stones:URLObject                    owl:equivalentClass     stonework:URL .
stones:UserAccountObject            owl:equivalentClass     stonework:UserAccount .
stones:Vulnerability                owl:equivalentClass     stonework:Vulnerability .

# --- Subclasses --------------------------------------------------------

stones:CourseOfAction               owl:subClassOf          stonework:Mitigation .
stones:DomainNameObject             owl:subClassOf          stonework:Domain .
stones:Identity                     owl:subClassOf          stonework:Agent .
stones:IPv4AddressObject            owl:subClassOf          stonework:IPAddress .
stones:IPv6AddressObject            owl:subClassOf          stonework:IPAddress .
stones:Location                     owl:subClassOf          stonework:Location .
stones:SoftwareObject               owl:subClassOf          stonework:Product .
stones:StixSubType                  owl:subClassOf          stonework:Indicators .

# --- Datatype Properties --------------------------------------------

###  https://cyberterrain.org/ns/stones#relationshipType
stones:relationshipType rdf:type owl:DatatypeProperty, owl:FunctionalProperty ;
                        rdfs:domain stones:Relationship ;
                        rdfs:range xsd:string ;
                        skos:prefLabel "relationshipType" ;
                        skos:definition "The relationship_type string value from the STIX 2.1 SRO (e.g. 'uses', 'mitigates', 'subtechnique-of'). Drawn from the STIX 2.1 open vocabulary; corresponding named individuals are declared as stones:RelationshipTypeVocabulary instances in vocabularies.ttl. A shortcut object property is also asserted: stones:<type_underscored> from source to target." .

# --- Object Properties ----------------------------------------------

stones:mitigates        owl:equivalentProperty      stonework:mitigates .
stones:detects          owl:equivalentProperty      stonework:detects .
stones:revoked_by       owl:equivalentProperty      stonework:revokedBy .
stones:attributed_to    owl:equivalentProperty      stonework:attributedTo .
stones:indicates        owl:equivalentProperty      stonework:indicates .
stones:related_to       owl:equivalentProperty      stonework:relatedTo .
stones:targets          owl:equivalentProperty      stonework:targets .
stones:exploits         owl:equivalentProperty      stonework:exploits .

# --- Object SubProperties ---------------------------------------------

stones:uses             rdfs:subPropertyOf          stonework:uses .
stones:subtechnique_of  rdfs:subPropertyOf          stonework:techniqueOf .


