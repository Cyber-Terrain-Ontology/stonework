@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

stonework:StrictQualifiedAssertionProvenanceShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Provenance ;
		sh:message "A qualified assertion in the strict profile must identify at least one provenance source."@en ;
		sh:minCount "1"^^xsd:integer ;
		sh:path stonework:hasProvenance ;
	] ;
	sh:targetClass stonework:QualifiedAssertion ;
	.
