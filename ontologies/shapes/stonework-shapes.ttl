@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

stonework:ActivityWindowShape
	a sh:NodeShape ;
	sh:property
		[
			sh:datatype xsd:dateTime ;
			sh:lessThanOrEquals stonework:endedAtTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "startedAtTime must be no later than endedAtTime."@en ;
			sh:path stonework:startedAtTime ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:endedAtTime ;
		]
		;
	sh:targetSubjectsOf
		stonework:endedAtTime ,
		stonework:startedAtTime
		;
	.

stonework:BomEntryShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:VersionedProduct ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "A BomEntry must identify exactly one versioned product."@en ;
		sh:minCount "1"^^xsd:integer ;
		sh:path stonework:installationOf ;
	] ;
	sh:targetClass stonework:BomEntry ;
	.

stonework:CertificateValidityShape
	a sh:NodeShape ;
	sh:property
		[
			sh:datatype xsd:dateTime ;
			sh:lessThanOrEquals stonework:certValidNotAfter ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "certValidNotBefore must be no later than certValidNotAfter."@en ;
			sh:path stonework:certValidNotBefore ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:certValidNotAfter ;
		]
		;
	sh:targetClass stonework:Certificate ;
	.

stonework:ConfidenceShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:integer ;
		sh:maxCount "1"^^xsd:integer ;
		sh:maxInclusive "100"^^xsd:integer ;
		sh:message "confidence must be one integer from 0 through 100."@en ;
		sh:minInclusive "0"^^xsd:integer ;
		sh:path stonework:confidence ;
	] ;
	sh:targetSubjectsOf stonework:confidence ;
	.

stonework:CvssBaseScoreShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:decimal ;
		sh:maxCount "1"^^xsd:integer ;
		sh:maxInclusive "10.0"^^xsd:decimal ;
		sh:message "cvssBaseScore must be one decimal from 0.0 through 10.0."@en ;
		sh:minInclusive "0.0"^^xsd:decimal ;
		sh:path stonework:cvssBaseScore ;
	] ;
	sh:targetSubjectsOf stonework:cvssBaseScore ;
	.

stonework:DefaultTransitionShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Transition ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "A Step has at most one defaultTransition, a Transition."@en ;
		sh:path stonework:defaultTransition ;
	] ;
	sh:targetSubjectsOf stonework:defaultTransition ;
	.

stonework:DeviationShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:DeviationKind ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A Deviation has exactly one kind."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:deviationKind ;
		] ,
		[
			sh:class stonework:DigitalArtifact ;
			sh:path stonework:evidencedBy ;
		] ,
		[
			sh:class stonework:Process ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A Deviation is found in exactly one run."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:deviationRun ;
		] ,
		[
			sh:class stonework:Process ;
			sh:path stonework:deviationExecution ;
		] ,
		[
			sh:class stonework:Step ;
			sh:message "A Deviation concerns at least one Step of the run's Plan."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:deviationStep ;
		]
		;
	sh:targetClass stonework:Deviation ;
	.

stonework:EpssScoreShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:decimal ;
		sh:maxCount "1"^^xsd:integer ;
		sh:maxInclusive "1.0"^^xsd:decimal ;
		sh:message "epssScore must be one decimal from 0.0 through 1.0."@en ;
		sh:minInclusive "0.0"^^xsd:decimal ;
		sh:path stonework:epssScore ;
	] ;
	sh:targetSubjectsOf stonework:epssScore ;
	.

stonework:HasPlaybookTypeShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:PlaybookType ;
		sh:message "hasPlaybookType takes a PlaybookType."@en ;
		sh:path stonework:hasPlaybookType ;
	] ;
	sh:targetSubjectsOf stonework:hasPlaybookType ;
	.

stonework:HashShape
	a sh:NodeShape ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:hashAlgorithm ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:hashValue ;
		]
		;
	sh:targetClass stonework:Hash ;
	.

stonework:HypothesisPartShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Hypothesis ;
		sh:message "A Hypothesis's parts are Hypotheses: the claims it is the conjunction of."@en ;
		sh:path stonework:hypothesisPart ;
	] ;
	sh:targetSubjectsOf stonework:hypothesisPart ;
	.

stonework:HypothesisShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:Variable ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A Hypothesis predicts at most one Variable. One tested directly by an Investigation (stonework:testsHypothesis) need not predict a plan Variable at all."@en ;
			sh:path stonework:predictsVariable ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:IRI ;
			sh:path stonework:predictedType ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:predictedLiteral ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:predictedValue ;
		]
		;
	sh:targetClass stonework:Hypothesis ;
	.

stonework:InvestigationOutcomeShape
	a sh:NodeShape ;
	sh:property
		[
			sh:hasValue stonework:investigationStatusClosed ;
			sh:message "An Investigation with an outcome should have the status Closed."@en ;
			sh:path stonework:hasInvestigationStatus ;
			sh:severity sh:Warning ;
		] ,
		[
			sh:message "An Investigation with an outcome should record when it ended (stonework:endedAtTime)."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:endedAtTime ;
			sh:severity sh:Warning ;
		]
		;
	sh:targetSubjectsOf stonework:hasInvestigationOutcome ;
	.

stonework:InvestigationShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:Agent ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "An Investigation has at most one lead investigator."@en ;
			sh:path stonework:leadInvestigator ;
		] ,
		[
			sh:class stonework:Investigation ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "An Investigation is merged into at most one other Investigation."@en ;
			sh:path stonework:mergedInto ;
		] ,
		[
			sh:class stonework:InvestigationOutcome ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "An Investigation has at most one outcome."@en ;
			sh:path stonework:hasInvestigationOutcome ;
		] ,
		[
			sh:class stonework:InvestigationStatus ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "An Investigation has at most one current status."@en ;
			sh:path stonework:hasInvestigationStatus ;
		]
		;
	sh:targetClass stonework:Investigation ;
	.

stonework:IpVersionShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:integer ;
		sh:in (
			"4"^^xsd:integer
			"6"^^xsd:integer
		) ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "ipVersion must be the integer 4 or 6."@en ;
		sh:path stonework:ipVersion ;
	] ;
	sh:targetSubjectsOf stonework:ipVersion ;
	.

stonework:JoinKindShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:FlowKind ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "A Step has at most one joinKind, a FlowKind (exclusive or parallel)."@en ;
		sh:path stonework:joinKind ;
	] ;
	sh:targetSubjectsOf stonework:joinKind ;
	.

stonework:KnownExploitedShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:boolean ;
		sh:maxCount "1"^^xsd:integer ;
		sh:path stonework:isKnownExploited ;
	] ;
	sh:targetSubjectsOf stonework:isKnownExploited ;
	.

stonework:LatitudeShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:decimal ;
		sh:maxCount "1"^^xsd:integer ;
		sh:maxInclusive "90.0"^^xsd:decimal ;
		sh:message "latitude must be one decimal from -90.0 through 90.0."@en ;
		sh:minInclusive "-90.0"^^xsd:decimal ;
		sh:path stonework:latitude ;
	] ;
	sh:targetSubjectsOf stonework:latitude ;
	.

stonework:LikelihoodScoreShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:decimal ;
		sh:maxCount "1"^^xsd:integer ;
		sh:maxInclusive "1.0"^^xsd:decimal ;
		sh:message "likelihoodScore must be one decimal from 0.0 through 1.0."@en ;
		sh:minInclusive "0.0"^^xsd:decimal ;
		sh:path stonework:likelihoodScore ;
	] ;
	sh:targetSubjectsOf stonework:likelihoodScore ;
	.

stonework:LongitudeShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:decimal ;
		sh:maxCount "1"^^xsd:integer ;
		sh:maxInclusive "180.0"^^xsd:decimal ;
		sh:message "longitude must be one decimal from -180.0 through 180.0."@en ;
		sh:minInclusive "-180.0"^^xsd:decimal ;
		sh:path stonework:longitude ;
	] ;
	sh:targetSubjectsOf stonework:longitude ;
	.

stonework:MetricObservationShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:CyberEntity ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:metricFor ;
		] ,
		[
			sh:class stonework:MetricType ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:metricType ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:observedAt ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path stonework:metricValue ;
		]
		;
	sh:targetClass stonework:MetricObservation ;
	.

stonework:MonetaryAmountShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:Currency ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A MonetaryAmount must identify exactly one Currency."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:currency ;
		] ,
		[
			sh:datatype xsd:decimal ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A MonetaryAmount must identify exactly one decimal amount."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:amount ;
		]
		;
	sh:targetClass stonework:MonetaryAmount ;
	.

stonework:ObservationWindowShape
	a sh:NodeShape ;
	sh:property
		[
			sh:datatype xsd:dateTime ;
			sh:lessThanOrEquals stonework:lastSeen ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "firstSeen must be no later than lastSeen."@en ;
			sh:path stonework:firstSeen ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:lastSeen ;
		]
		;
	sh:targetSubjectsOf
		stonework:firstSeen ,
		stonework:lastSeen
		;
	.

stonework:OutcomeVariableShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Variable ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "A Step or Plan has at most one outcomeVariable, a Variable."@en ;
		sh:path stonework:outcomeVariable ;
	] ;
	sh:targetSubjectsOf stonework:outcomeVariable ;
	.

stonework:PartOfExecutionShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:CyberActivity ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "An execution is part of at most one parent execution; use stonework:partOfExecution+ for every ancestor."@en ;
		sh:path stonework:partOfExecution ;
	] ;
	sh:targetSubjectsOf stonework:partOfExecution ;
	.

stonework:PerformerRoleShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Role ;
		sh:message "A Step's performerRole is a Role; the Agents who hold it are given by RoleAssignments."@en ;
		sh:path stonework:performerRole ;
	] ;
	sh:targetSubjectsOf stonework:performerRole ;
	.

stonework:PortShape
	a sh:NodeShape ;
	sh:property
		[
			sh:datatype xsd:unsignedShort ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:dstPort ;
		] ,
		[
			sh:datatype xsd:unsignedShort ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:port ;
		] ,
		[
			sh:datatype xsd:unsignedShort ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:srcPort ;
		]
		;
	sh:targetSubjectsOf
		stonework:dstPort ,
		stonework:port ,
		stonework:srcPort
		;
	.

stonework:PriorityShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:PriorityLevel ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "At most one current priority."@en ;
		sh:path stonework:hasPriority ;
	] ;
	sh:targetSubjectsOf stonework:hasPriority ;
	.

stonework:ProductInstallationShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:Infrastructure ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A ProductInstallation must identify exactly one Infrastructure target."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:installedOn ;
		] ,
		[
			sh:class stonework:VersionedProduct ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A ProductInstallation must identify exactly one versioned product."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:installationOf ;
		]
		;
	sh:targetClass stonework:ProductInstallation ;
	.

stonework:QualifiedAssertionShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:Provenance ;
			sh:message "A qualified assertion's provenance value must be a STONEWORK Provenance instance."@en ;
			sh:path stonework:hasProvenance ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:lessThanOrEquals stonework:validUntil ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "validFrom must be no later than validUntil."@en ;
			sh:path stonework:validFrom ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:validUntil ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:assertionRelationType ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:assertionObject ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:assertionSubject ;
		]
		;
	sh:targetClass stonework:QualifiedAssertion ;
	.

stonework:RegistrationDateShape
	a sh:NodeShape ;
	sh:property [
		sh:datatype xsd:dateTime ;
		sh:maxCount "1"^^xsd:integer ;
		sh:path stonework:registrationDate ;
	] ;
	sh:targetSubjectsOf stonework:registrationDate ;
	.

stonework:RoleAssignmentShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:CyberEntity ;
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:rolePlayer ;
		] ,
		[
			sh:class stonework:Role ;
			sh:maxCount "1"^^xsd:integer ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:assignedRole ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:or (
				[
					sh:class stonework:CyberActivity ;
				]
				[
					sh:class stonework:CyberEntity ;
				]
			) ;
			sh:path stonework:roleContext ;
		]
		;
	sh:targetClass stonework:RoleAssignment ;
	.

stonework:SecurityActuationShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:Countermeasure ;
			sh:path stonework:appliesCountermeasure ;
		] ,
		[
			sh:class stonework:CyberEntity ;
			sh:message "Every stonework:actsOn value on a SecurityActuation must be a CyberEntity."@en ;
			sh:path stonework:actsOn ;
		] ,
		[
			sh:class stonework:SecurityActuator ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A SecurityActuation must identify exactly one SecurityActuator."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:madeByActuator ;
		] ,
		[
			sh:message "A SecurityActuation should identify at least one affected CyberEntity; an actuation with no resolved target is incomplete, not malformed."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:actsOn ;
			sh:severity sh:Warning ;
		]
		;
	sh:targetClass stonework:SecurityActuation ;
	.

stonework:SeparatedFromShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Step ;
		sh:message "separatedFrom relates two Steps."@en ;
		sh:path stonework:separatedFrom ;
	] ;
	sh:targetSubjectsOf stonework:separatedFrom ;
	.

stonework:SightingShape
	a sh:NodeShape ;
	sh:property [
		sh:maxCount "1"^^xsd:integer ;
		sh:message "A Sighting must identify exactly one sighted object."@en ;
		sh:minCount "1"^^xsd:integer ;
		sh:path stonework:sightedObject ;
	] ;
	sh:targetClass stonework:Sighting ;
	.

stonework:SplitKindShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:FlowKind ;
		sh:maxCount "1"^^xsd:integer ;
		sh:message "A Step has at most one splitKind, a FlowKind (exclusive or parallel)."@en ;
		sh:path stonework:splitKind ;
	] ;
	sh:targetSubjectsOf stonework:splitKind ;
	.

stonework:StepTargetShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:CyberEntity ;
		sh:message "A Step's stepTarget is a CyberEntity, or a Variable whose value in the run is the target."@en ;
		sh:path stonework:stepTarget ;
	] ;
	sh:targetSubjectsOf stonework:stepTarget ;
	.

stonework:SuppliedByShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Role ;
		sh:message "A Variable's suppliedBy is a Role: the participants who supply its value from outside the Plan."@en ;
		sh:path stonework:suppliedBy ;
	] ;
	sh:targetSubjectsOf stonework:suppliedBy ;
	.

stonework:TransitionShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:ComparisonOperator ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:guardOperator ;
		] ,
		[
			sh:class stonework:Step ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A Transition must identify exactly one destination Step."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:toStep ;
		] ,
		[
			sh:class stonework:Step ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A Transition must identify exactly one source Step."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:fromStep ;
		] ,
		[
			sh:class stonework:Variable ;
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:guardVariable ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A Transition has at most one guardValue."@en ;
			sh:path stonework:guardValue ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:IRI ;
			sh:path stonework:guardType ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:guardLiteralValue ;
		]
		;
	sh:targetClass stonework:Transition ;
	.

stonework:UsedBindingShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:VariableBinding ;
		sh:path stonework:usedBinding ;
	] ;
	sh:targetSubjectsOf stonework:usedBinding ;
	.

stonework:VariableBindingShape
	a sh:NodeShape ;
	sh:property
		[
			sh:class stonework:CyberActivity ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A VariableBinding names exactly one execution it was bound in."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:boundIn ;
		] ,
		[
			sh:class stonework:Variable ;
			sh:maxCount "1"^^xsd:integer ;
			sh:message "A VariableBinding records the value of exactly one Variable."@en ;
			sh:minCount "1"^^xsd:integer ;
			sh:path stonework:bindingOf ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path stonework:boundToLiteral ;
		] ,
		[
			sh:maxCount "1"^^xsd:integer ;
			sh:path stonework:boundTo ;
		]
		;
	sh:targetClass stonework:VariableBinding ;
	sh:xone (
		[
			sh:property [
				sh:minCount "1"^^xsd:integer ;
				sh:path stonework:boundTo ;
			] ;
		]
		[
			sh:property [
				sh:minCount "1"^^xsd:integer ;
				sh:path stonework:boundToLiteral ;
			] ;
		]
	) ;
	.

stonework:VariableShape
	a sh:NodeShape ;
	sh:property
		[
			sh:maxCount "0"^^xsd:integer ;
			sh:message "Since 0.12.0 a Variable's value in one execution is a stonework:VariableBinding; boundTo is no longer said of the Variable."@en ;
			sh:path stonework:boundTo ;
		] ,
		[
			sh:maxCount "0"^^xsd:integer ;
			sh:message "Since 0.12.0 a Variable's value in one execution is a stonework:VariableBinding; boundToLiteral is no longer said of the Variable."@en ;
			sh:path stonework:boundToLiteral ;
		]
		;
	sh:targetClass stonework:Variable ;
	.

stonework:VersionedProductShape
	a sh:NodeShape ;
	sh:property [
		sh:class stonework:Product ;
		sh:maxCount "1"^^xsd:integer ;
		sh:path stonework:versionOf ;
	] ;
	sh:targetClass stonework:VersionedProduct ;
	.
