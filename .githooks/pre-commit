#!/usr/bin/env bash
# Stonework pre-commit hook.
# Hooks are tracked in .githooks/ and activated repo-wide via:
#   git config core.hooksPath .githooks
#
# New contributors: run  bash tools/download-rdf-toolkit.sh  once after cloning.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Format staged TTL files ────────────────────────────────────────────────
staged_ttl=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ttl$' || true)
if [ -n "$staged_ttl" ]; then
    abs_files=()
    while IFS= read -r rel; do
        abs_files+=("$REPO_ROOT/$rel")
    done <<< "$staged_ttl"
    bash "$SCRIPT_DIR/format-ttl.sh" "${abs_files[@]}"
fi

# ── Protect catalog-v001.xml ───────────────────────────────────────────────
bash "$SCRIPT_DIR/protect-catalog.sh"
