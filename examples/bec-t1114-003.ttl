@prefix cti-enc: <https://cyberterrain.org/cti-encyclopedia/resource/> .
@prefix ex: <https://cyberterrain.org/ns/stonework/examples/bec-t1114-003#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:acct-ap-clerk-mailbox
	a stonework:UserAccount ;
	skos:prefLabel "Accounts-payable clerk's mailbox account"@en ;
	stonework:accountName "ap@manufacturer.example" ;
	stonework:accountOf ex:ap-clerk ;
	stonework:hasAccountType stonework:accountTypeCloud ;
	.

ex:acct-controller-bank
	a stonework:UserAccount ;
	skos:definition "The controller's login to the bank's portal, from which wires are released. The bank's portal log records this login, not the person, as the releaser."@en ;
	skos:prefLabel "Controller's bank-portal login"@en ;
	stonework:accountName "controller (bank portal)" ;
	stonework:accountOf ex:controller ;
	stonework:controls ex:acct-operating ;
	.

ex:acct-controller-mailbox
	a stonework:UserAccount ;
	skos:prefLabel "Controller's mailbox account"@en ;
	stonework:accountName "controller@manufacturer.example" ;
	stonework:accountOf ex:controller ;
	stonework:hasAccountType stonework:accountTypeCloud ;
	.

ex:acct-mule
	a stonework:FinancialAccount ;
	skos:prefLabel "Mule checking account"@en ;
	stonework:accountOf ex:mule ;
	stonework:categorizedBy stonework:financialAccountTypeChecking ;
	stonework:heldAt ex:bank-mule ;
	.

ex:acct-operating
	a stonework:FinancialAccount ;
	skos:prefLabel "Manufacturer's operating account"@en ;
	stonework:accountOf ex:org ;
	stonework:categorizedBy stonework:financialAccountTypeChecking ;
	stonework:heldAt ex:bank-org ;
	.

ex:acct-supplier
	a stonework:FinancialAccount ;
	skos:prefLabel "Supplier's account, as on file"@en ;
	stonework:categorizedBy stonework:financialAccountTypeChecking ;
	.

ex:act-create-rule
	a stonework:Process ;
	skos:definition "Using the controller's stolen credentials, the actor created an inbox rule that forwards every message mentioning an invoice, a payment or a wire to an external address, and moves the original to the RSS Feeds folder, where the controller wouldn't look."@en ;
	skos:prefLabel "Execution: create a hidden forwarding rule on the controller's mailbox"@en ;
	stonework:actsOn ex:acct-controller-mailbox ;
	stonework:attributedTo ex:actor ;
	stonework:executionOf cti-enc:attack-pattern--7d77a07d-02fe-4e88-8bd9-e9c008c01bf0 ;
	stonework:performedBy ex:acct-controller-mailbox ;
	stonework:produces ex:rule-forward ;
	stonework:startedAtTime "2026-09-02T03:14:07Z"^^xsd:dateTime ;
	.

ex:actor
	a stonework:ThreatActor ;
	skos:definition "The unidentified actor behind this business email compromise."@en ;
	skos:prefLabel "Unidentified BEC actor"@en ;
	.

ex:addr-forward-target
	a stonework:EmailAddress ;
	skos:prefLabel "External address the forwarding rule sends to"@en ;
	stonework:emailOf ex:actor ;
	stonework:emailValue "archive.mailbox@freemail.example" ;
	.

ex:addr-lookalike
	a stonework:EmailAddress ;
	skos:definition "A lookalike of the supplier's accounts address, with a digit 1 in place of the letter l."@en ;
	skos:prefLabel "Lookalike supplier address"@en ;
	stonework:emailOf ex:actor ;
	stonework:emailValue "accounts@supp1ier.example" ;
	.

ex:amt-wire
	a stonework:MonetaryAmount ;
	skos:prefLabel "Wire amount (USD)"@en ;
	stonework:amount "186400.00"^^xsd:decimal ;
	stonework:currency stonework:currencyUSD ;
	.

ex:analyst
	a stonework:Person ;
	skos:prefLabel "Example security analyst"@en ;
	.

ex:ap-clerk
	a stonework:Person ;
	skos:prefLabel "Example accounts-payable clerk"@en ;
	stonework:hasRoleAssignment ex:ra-ap-clerk ;
	.

ex:b-mailbox-clerk
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-mailbox ;
	stonework:boundIn ex:inv-bec ;
	stonework:boundTo ex:acct-ap-clerk-mailbox ;
	.

ex:b-mailbox-controller
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-mailbox ;
	stonework:boundIn ex:inv-bec ;
	stonework:boundTo ex:acct-controller-mailbox ;
	.

ex:b-rule-clerk
	a stonework:VariableBinding ;
	skos:definition "The search of the clerk's mailbox found no forwarding rule."@en ;
	stonework:bindingOf ex:var-rule-found ;
	stonework:boundIn ex:inv-search-clerk ;
	stonework:boundToLiteral "false"^^xsd:boolean ;
	.

ex:b-rule-controller
	a stonework:VariableBinding ;
	skos:definition "The search of the controller's mailbox found the rule, recorded as a Sighting of T1114.003."@en ;
	stonework:bindingOf ex:var-rule-found ;
	stonework:boundIn ex:inv-search-controller ;
	stonework:boundTo ex:sighting-controller-rule ;
	.

ex:b0909-changed
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-bank-details-changed ;
	stonework:boundIn ex:exe0909-enter ;
	stonework:boundToLiteral "false"^^xsd:boolean ;
	.

ex:b0909-details
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-payee-bank-details ;
	stonework:boundIn ex:exe0909-enter ;
	stonework:boundTo ex:acct-supplier ;
	.

ex:b0916-changed
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-bank-details-changed ;
	stonework:boundIn ex:exe0916-enter ;
	stonework:boundToLiteral "true"^^xsd:boolean ;
	.

ex:b0916-details
	a stonework:VariableBinding ;
	skos:definition "The bank details the clerk entered from the actor's email: the mule account. The callback Step should have received this value; no execution in this run used it."@en ;
	stonework:bindingOf ex:var-payee-bank-details ;
	stonework:boundIn ex:exe0916-enter ;
	stonework:boundTo ex:acct-mule ;
	.

ex:b0930-changed
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-bank-details-changed ;
	stonework:boundIn ex:exe0930-enter ;
	stonework:boundToLiteral "true"^^xsd:boolean ;
	.

ex:b0930-details
	a stonework:VariableBinding ;
	skos:definition "The bank details in the actor's second request, for another invoice: the mule account again."@en ;
	stonework:bindingOf ex:var-payee-bank-details ;
	stonework:boundIn ex:exe0930-enter ;
	stonework:boundTo ex:acct-mule ;
	.

ex:b0930-verified
	a stonework:VariableBinding ;
	skos:definition "The callback, to the number on file, reached the real supplier, who had not changed banks."@en ;
	stonework:bindingOf ex:var-callback-verified ;
	stonework:boundIn ex:exe0930-verify ;
	stonework:boundToLiteral "false"^^xsd:boolean ;
	.

ex:bank-mule
	a stonework:FinancialInstitution ;
	skos:prefLabel "Mule's bank"@en ;
	stonework:categorizedBy stonework:financialInstitutionTypeCommercialBank ;
	.

ex:bank-org
	a stonework:FinancialInstitution ;
	skos:prefLabel "Manufacturer's bank"@en ;
	stonework:categorizedBy stonework:financialInstitutionTypeCommercialBank ;
	.

ex:bp-supplier-wire
	a stonework:BusinessProcess ;
	skos:definition "The organization's process for paying a supplier invoice by wire."@en ;
	skos:prefLabel "Supplier payment by wire"@en ;
	stonework:hasStep
		ex:wstep-approve ,
		ex:wstep-enter ,
		ex:wstep-release ,
		ex:wstep-verify
		;
	stonework:performedBy ex:org ;
	stonework:planVersion "3.2" ;
	.

ex:control-callback
	a stonework:Control ;
	skos:definition "Before any payment, a change to a payee's bank details is verified by telephone, at a number already on file and not one given in the request."@en ;
	skos:prefLabel "Out-of-band verification of payee bank-detail changes"@en ;
	stonework:controlId "FIN-07" ;
	.

ex:controller
	a stonework:Person ;
	skos:prefLabel "Example controller"@en ;
	stonework:hasRoleAssignment ex:ra-controller ;
	.

ex:cstep-block-external
	a stonework:Step ;
	skos:prefLabel "Block automatic forwarding to external domains at the transport layer"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:stepOrder "3"^^xsd:integer ;
	.

ex:cstep-remove-rule
	a stonework:Step ;
	skos:prefLabel "Disable and remove the forwarding rule, keeping a copy as evidence"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:stepOrder "1"^^xsd:integer ;
	.

ex:cstep-reset
	a stonework:Step ;
	skos:prefLabel "Revoke the account's sessions and reset its credentials"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:stepOrder "2"^^xsd:integer ;
	.

ex:cstep-review
	a stonework:Step ;
	skos:prefLabel "Review what was forwarded, and warn the suppliers and customers it exposed"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:stepOrder "4"^^xsd:integer ;
	.

ex:ctlplan-forwarding
	a stonework:ControlPlan ;
	skos:definition "The organization's containment plan for a malicious email forwarding rule. It implements NIST SP 800-53 AC-4 (information flow enforcement), which the CTI Encyclopedia links to T1114.003."@en ;
	skos:prefLabel "Contain a malicious forwarding rule"@en ;
	stonework:hasStep
		ex:cstep-block-external ,
		ex:cstep-remove-rule ,
		ex:cstep-reset ,
		ex:cstep-review
		;
	stonework:implements cti-enc:_Control_nist-ac-4 ;
	.

ex:detplan-forwarding
	a stonework:DetectionPlan ;
	skos:definition "Looks for email forwarding rules on the finance team's mailboxes, following ATT&CK's detection strategy DET0576, and hands a confirmed rule to the containment plan."@en ;
	skos:prefLabel "Detect forwarding rules on finance mailboxes"@en ;
	stonework:hasStep
		ex:dstep-contain ,
		ex:dstep-search
		;
	stonework:implements cti-enc:x-mitre-detection-strategy--f66a9e86-49fb-4de6-963d-0e357a77f679 ;
	.

ex:dev-0916-callback
	a stonework:Deviation ;
	skos:definition "In the 16 September run, the callback the plan required was not made. The run has no execution of the Step; the clerk's statement and the call records establish that it wasn't done, not merely that it wasn't recorded."@en ;
	skos:prefLabel "Deviation: the callback was skipped (16 September)"@en ;
	stonework:deviationKind stonework:deviationKindSkipped ;
	stonework:deviationRun ex:run-wire-0916 ;
	stonework:deviationStep ex:wstep-verify ;
	stonework:evidencedBy
		ex:file-clerk-statement ,
		ex:log-calls-0916
		;
	.

ex:dstep-contain
	a stonework:Step ;
	skos:definition "Run the containment plan for the mailbox where a rule was found."@en ;
	skos:prefLabel "Contain the mailbox"@en ;
	stonework:implements ex:ctlplan-forwarding ;
	stonework:isStepOf ex:detplan-forwarding ;
	stonework:stepOrder "2"^^xsd:integer ;
	.

ex:dstep-search
	a stonework:Step ;
	skos:definition "Search the audit log for New-InboxRule and Set-InboxRule operations on the given mailbox that set ForwardTo, ForwardAsAttachmentTo or RedirectTo, over the last 90 days (ATT&CK analytic AN1591). Run once for each mailbox in question."@en ;
	skos:prefLabel "Search the audit log for forwarding rules on a mailbox"@en ;
	stonework:hasInputVariable ex:var-mailbox ;
	stonework:hasOutputVariable ex:var-rule-found ;
	stonework:implements cti-enc:x-mitre-analytic--710aa303-3e9f-4170-95a4-b2caf5f827fd ;
	stonework:isStepOf ex:detplan-forwarding ;
	stonework:stepOrder "1"^^xsd:integer ;
	.

ex:dt-found-to-contain
	a stonework:Transition ;
	stonework:fromStep ex:dstep-search ;
	stonework:guardType stonework:Sighting ;
	stonework:guardVariable ex:var-rule-found ;
	stonework:toStep ex:dstep-contain ;
	.

ex:email-bank-change
	a stonework:EmailMessage ;
	skos:definition "Sent from the lookalike supplier address in reply to a genuine invoice thread the actor had read through the forwarding rule. It says the supplier has changed banks and gives new account details for the outstanding invoice."@en ;
	skos:prefLabel 'Email: "Updated remittance details"'@en ;
	.

ex:exe-contain
	a stonework:Process ;
	skos:prefLabel "Execution: contain the controller's mailbox"@en ;
	stonework:correspondsToStep ex:dstep-contain ;
	stonework:endedAtTime "2026-10-01T12:00:00Z"^^xsd:dateTime ;
	stonework:executionOf ex:ctlplan-forwarding ;
	stonework:partOfExecution ex:inv-bec ;
	stonework:performedBy
		ex:analyst ,
		ex:svc-automation
		;
	stonework:startedAtTime "2026-09-30T15:45:00Z"^^xsd:dateTime ;
	stonework:usedBinding ex:b-rule-controller ;
	.

ex:exe-cstep-block-external
	a stonework:Process ;
	skos:prefLabel "Execution: apply the transport rule blocking external auto-forwarding"@en ;
	stonework:actsOn ex:mail-tenant ;
	stonework:correspondsToStep ex:cstep-block-external ;
	stonework:endedAtTime "2026-09-30T16:06:04Z"^^xsd:dateTime ;
	stonework:partOfExecution ex:exe-contain ;
	stonework:performedBy ex:svc-automation ;
	stonework:startedAtTime "2026-09-30T16:06:00Z"^^xsd:dateTime ;
	.

ex:exe-cstep-remove-rule
	a stonework:Process ;
	skos:prefLabel 'Execution: remove the rule "Sync"'@en ;
	stonework:actsOn ex:rule-forward ;
	stonework:correspondsToStep ex:cstep-remove-rule ;
	stonework:endedAtTime "2026-09-30T15:50:00Z"^^xsd:dateTime ;
	stonework:partOfExecution ex:exe-contain ;
	stonework:performedBy ex:analyst ;
	stonework:startedAtTime "2026-09-30T15:45:00Z"^^xsd:dateTime ;
	.

ex:exe-cstep-reset
	a stonework:Process ;
	skos:prefLabel "Execution: revoke sessions and reset the controller's credentials"@en ;
	stonework:actsOn ex:acct-controller-mailbox ;
	stonework:correspondsToStep ex:cstep-reset ;
	stonework:endedAtTime "2026-09-30T16:05:00Z"^^xsd:dateTime ;
	stonework:partOfExecution ex:exe-contain ;
	stonework:performedBy ex:analyst ;
	stonework:startedAtTime "2026-09-30T15:51:00Z"^^xsd:dateTime ;
	.

ex:exe-cstep-review
	a stonework:Process ;
	skos:prefLabel "Execution: review the forwarded mail and warn those exposed"@en ;
	stonework:correspondsToStep ex:cstep-review ;
	stonework:endedAtTime "2026-10-01T12:00:00Z"^^xsd:dateTime ;
	stonework:partOfExecution ex:exe-contain ;
	stonework:performedBy
		ex:analyst ,
		ex:controller
		;
	stonework:startedAtTime "2026-09-30T16:30:00Z"^^xsd:dateTime ;
	.

ex:exe0909-approve
	a stonework:Process ;
	skos:prefLabel "Execution: approve the payment (9 September)"@en ;
	stonework:correspondsToStep ex:wstep-approve ;
	stonework:partOfExecution ex:run-wire-0909 ;
	stonework:performedBy ex:controller ;
	stonework:startedAtTime "2026-09-09T14:10:00Z"^^xsd:dateTime ;
	.

ex:exe0909-enter
	a stonework:Process ;
	skos:prefLabel "Execution: enter the invoice (9 September)"@en ;
	stonework:correspondsToStep ex:wstep-enter ;
	stonework:partOfExecution ex:run-wire-0909 ;
	stonework:performedBy ex:ap-clerk ;
	stonework:startedAtTime "2026-09-09T10:02:00Z"^^xsd:dateTime ;
	.

ex:exe0909-release
	a stonework:Process ;
	skos:prefLabel "Execution: release the wire (9 September)"@en ;
	stonework:correspondsToStep ex:wstep-release ;
	stonework:partOfExecution ex:run-wire-0909 ;
	stonework:performedBy ex:acct-controller-bank ;
	stonework:startedAtTime "2026-09-09T15:30:00Z"^^xsd:dateTime ;
	.

ex:exe0916-approve
	a stonework:Process ;
	skos:prefLabel "Execution: approve the payment"@en ;
	stonework:correspondsToStep ex:wstep-approve ;
	stonework:endedAtTime "2026-09-16T15:04:00Z"^^xsd:dateTime ;
	stonework:partOfExecution ex:run-wire-0916 ;
	stonework:performedBy ex:controller ;
