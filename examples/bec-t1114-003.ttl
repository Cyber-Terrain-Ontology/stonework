	a stonework:Process ;
	skos:prefLabel "Execution: enter the invoice with the new bank details"@en ;
	stonework:correspondsToStep ex:wstep-enter ;
	stonework:endedAtTime "2026-09-16T09:20:00Z"^^xsd:dateTime ;
