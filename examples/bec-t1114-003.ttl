	stonework:startedAtTime "2026-09-16T16:29:00Z"^^xsd:dateTime ;
	.

ex:exe0930-enter
	a stonework:Process ;
	skos:prefLabel "Execution: enter the second payment request (30 September)"@en ;
	stonework:correspondsToStep ex:wstep-enter ;
	stonework:partOfExecution ex:run-wire-0930 ;
	stonework:performedBy ex:ap-clerk ;
	stonework:startedAtTime "2026-09-30T09:05:00Z"^^xsd:dateTime ;
	.

ex:exe0930-verify
	a stonework:Process ;
	skos:definition "The clerk called the supplier at the number on file. The supplier had not changed banks, so the payment was stopped."@en ;
	skos:prefLabel "Execution: verify the changed bank details by callback (30 September)"@en ;
	stonework:correspondsToStep ex:wstep-verify ;
	stonework:partOfExecution ex:run-wire-0930 ;
	stonework:performedBy ex:ap-clerk ;
	stonework:startedAtTime "2026-09-30T09:40:00Z"^^xsd:dateTime ;
	stonework:usedBinding ex:b0930-details ;
	.

ex:file-clerk-statement
	a stonework:File ;
	skos:definition "The clerk's signed statement of 1 October: the request came in the supplier's usual invoice thread, the payment was due that day, and the callback was not made."@en ;
	skos:prefLabel "Accounts-payable clerk's statement (1 October)"@en ;
	.

ex:hyp-clerk-rule
	a stonework:Hypothesis ;
	skos:definition "T1114.003 is also in use on the accounts-payable clerk's mailbox."@en ;
	skos:prefLabel "Hypothesis: a forwarding rule on the clerk's mailbox"@en ;
	stonework:confidence "30"^^xsd:integer ;
	stonework:hasHypothesisStatus stonework:hypothesisStatusRefuted ;
	stonework:predictedType stonework:Sighting ;
	stonework:predictsVariable ex:var-rule-found ;
	.

ex:hyp-controller-rule
	a stonework:Hypothesis ;
	skos:definition "T1114.003, Email Forwarding Rule, is in use on the controller's mailbox: the actor learned of the invoice from the controller's mail."@en ;
	skos:prefLabel "Hypothesis: a forwarding rule on the controller's mailbox"@en ;
	stonework:confidence "70"^^xsd:integer ;
	stonework:hasHypothesisStatus stonework:hypothesisStatusConfirmed ;
	stonework:predictedType stonework:Sighting ;
	stonework:predictsVariable ex:var-rule-found ;
	.

ex:incident-bec
	a stonework:Incident ;
	skos:definition "Declared on 30 September, when the callback on the actor's second payment request reached the real supplier, who had not changed banks and had not been paid for September."@en ;
	skos:prefLabel "Supplier payment diverted by business email compromise"@en ;
	stonework:attributedTo ex:actor ;
	stonework:hasIncidentStatus stonework:incidentStatusContained ;
	.

ex:inv-bec
	a stonework:Investigation ;
	skos:prefLabel "Investigation: diverted supplier payment"@en ;
	stonework:collects
		ex:file-clerk-statement ,
		ex:log-calls-0916 ,
		ex:log-clerk-search ,
		ex:log-new-inboxrule
		;
	stonework:endedAtTime "2026-10-03T17:00:00Z"^^xsd:dateTime ;
	stonework:executionOf ex:detplan-forwarding ;
	stonework:hasInvestigationOutcome stonework:investigationOutcomeConfirmed ;
	stonework:hasInvestigationStatus stonework:investigationStatusClosed ;
	stonework:hasPriority stonework:priorityHigh ;
	stonework:investigates ex:incident-bec ;
	stonework:leadInvestigator ex:analyst ;
	stonework:performedBy ex:analyst ;
	stonework:produces ex:dev-0916-callback ;
	stonework:startedAtTime "2026-09-30T14:00:00Z"^^xsd:dateTime ;
	stonework:testsHypothesis
		ex:hyp-clerk-rule ,
		ex:hyp-controller-rule
		;
	.

ex:inv-search-clerk
	a stonework:Investigation ;
	skos:definition "Searched 90 days of the audit log for the clerk's mailbox and found no forwarding or redirect rule. The empty result is kept: it is the evidence against the hypothesis."@en ;
	skos:prefLabel "Execution: search the audit log, clerk's mailbox"@en ;
	stonework:actsOn ex:acct-ap-clerk-mailbox ;
	stonework:correspondsToStep ex:dstep-search ;
	stonework:endedAtTime "2026-09-30T15:41:00Z"^^xsd:dateTime ;
	stonework:hasOutput ex:log-clerk-search ;
	stonework:partOfExecution ex:inv-bec ;
	stonework:performedBy ex:analyst ;
	stonework:startedAtTime "2026-09-30T15:30:00Z"^^xsd:dateTime ;
	stonework:testsHypothesis ex:hyp-clerk-rule ;
	stonework:usedBinding ex:b-mailbox-clerk ;
	.

ex:inv-search-controller
	a stonework:Investigation ;
	skos:prefLabel "Execution: search the audit log, controller's mailbox"@en ;
	stonework:actsOn ex:acct-controller-mailbox ;
	stonework:correspondsToStep ex:dstep-search ;
	stonework:endedAtTime "2026-09-30T15:25:00Z"^^xsd:dateTime ;
	stonework:hasOutput ex:log-new-inboxrule ;
	stonework:partOfExecution ex:inv-bec ;
	stonework:performedBy ex:analyst ;
	stonework:produces ex:sighting-controller-rule ;
	stonework:startedAtTime "2026-09-30T15:10:00Z"^^xsd:dateTime ;
	stonework:testsHypothesis ex:hyp-controller-rule ;
	stonework:usedBinding ex:b-mailbox-controller ;
	.

ex:log-calls-0916
	a stonework:Log ;
	skos:definition "Call detail records for the accounts-payable extensions on 16 September: no call to the supplier's number on file."@en ;
	skos:prefLabel "Call records: accounts payable, 16 September"@en ;
	stonework:logSource "Telephone system call detail records" ;
	.

ex:log-clerk-search
	a stonework:Log ;
	skos:definition "The saved audit-log search for the clerk's mailbox, 2026-07-02 to 2026-09-30: the query and its empty result."@en ;
	skos:prefLabel "Audit log search: clerk's mailbox (no results)"@en ;
	stonework:logSource "Microsoft 365 unified audit log" ;
	.

ex:log-new-inboxrule
	a stonework:Log ;
	skos:definition "The audit-log record of the New-InboxRule operation that created the rule \"Sync\" on the controller's mailbox, from an IP address the controller has never used."@en ;
	skos:prefLabel "Audit log: New-InboxRule on the controller's mailbox"@en ;
	stonework:logSource "Microsoft 365 unified audit log" ;
	.

ex:mail-tenant
	a stonework:Infrastructure ;
	skos:definition "The organization's hosted email service (Exchange Online in this example)."@en ;
	skos:prefLabel "Organization's email tenant"@en ;
	.

ex:mule
	a stonework:Person ;
	skos:prefLabel "Example money mule"@en ;
	.

ex:org
	a stonework:Organization ;
	skos:definition "The victim of this worked example: a small manufacturer that pays its suppliers by wire."@en ;
	skos:prefLabel "Example manufacturer"@en ;
	.

ex:ra-ap-clerk
	a stonework:RoleAssignment ;
	stonework:assignedRole ex:role-ap-clerk ;
	stonework:roleContext ex:org ;
	stonework:rolePlayer ex:ap-clerk ;
	.

ex:ra-controller
	a stonework:RoleAssignment ;
	stonework:assignedRole ex:role-controller ;
	stonework:roleContext ex:org ;
	stonework:rolePlayer ex:controller ;
	.

ex:role-ap-clerk
	a stonework:Role ;
	skos:definition "Enters supplier invoices and payment requests, and verifies changes to suppliers' payment details."@en ;
	skos:prefLabel "Accounts-payable clerk"@en ;
	.

ex:role-controller
	a stonework:Role ;
	skos:definition "Approves and releases payments."@en ;
	skos:prefLabel "Controller"@en ;
	.

ex:rule-forward
	a stonework:DigitalArtifact ;
	skos:definition "The inbox rule \"Sync\" on the controller's mailbox: messages containing \"invoice\", \"payment\" or \"wire\" are forwarded to archive.mailbox@freemail.example and moved to RSS Feeds."@en ;
	skos:prefLabel 'Forwarding inbox rule "Sync"'@en ;
	.

ex:run-wire-0909
	a stonework:Process ;
	skos:definition "An ordinary run: the supplier's August invoice, paid to the account on file. The bank details were unchanged, so the plan went straight from entry to approval."@en ;
	skos:prefLabel "Run: pay the supplier's August invoice by wire (9 September)"@en ;
	stonework:endedAtTime "2026-09-09T15:31:00Z"^^xsd:dateTime ;
	stonework:executionOf ex:bp-supplier-wire ;
	stonework:performedBy
		ex:ap-clerk ,
		ex:controller
		;
	stonework:startedAtTime "2026-09-09T10:02:00Z"^^xsd:dateTime ;
	.

ex:run-wire-0916
	a stonework:Process ;
	skos:definition "The run that paid the supplier's September invoice to the actor's mule account. The bank details had changed, so the plan's guard required the callback, but this run has no execution of that Step."@en ;
	skos:prefLabel "Run: pay the supplier's September invoice by wire (16 September)"@en ;
	stonework:endedAtTime "2026-09-16T16:31:00Z"^^xsd:dateTime ;
	stonework:executionOf ex:bp-supplier-wire ;
	stonework:performedBy
		ex:ap-clerk ,
		ex:controller
		;
	stonework:startedAtTime "2026-09-16T09:12:00Z"^^xsd:dateTime ;
	.

ex:run-wire-0930
	a stonework:Process ;
	skos:definition "The actor's second request, for another invoice. This time the clerk made the callback, which showed the change was false, and the run ended there."@en ;
	skos:prefLabel "Run: the actor's second payment request, stopped at the callback (30 September)"@en ;
	stonework:endedAtTime "2026-09-30T09:45:00Z"^^xsd:dateTime ;
	stonework:executionOf ex:bp-supplier-wire ;
	stonework:performedBy ex:ap-clerk ;
	stonework:startedAtTime "2026-09-30T09:05:00Z"^^xsd:dateTime ;
	.

ex:sighting-controller-rule
	a stonework:Sighting ;
	skos:prefLabel "Sighting: T1114.003 on the controller's mailbox"@en ;
	stonework:evidencedBy ex:log-new-inboxrule ;
	stonework:sightedAt ex:mail-tenant ;
	stonework:sightedBy ex:analyst ;
	stonework:sightedObject cti-enc:attack-pattern--7d77a07d-02fe-4e88-8bd9-e9c008c01bf0 ;
	.

ex:svc-automation
	a stonework:DigitalIdentity ;
	skos:definition "The service account the organization's security automation runs as. Used here as the performer of an automated Step, for want of a STONEWORK class for a non-AI software agent."@en ;
	skos:prefLabel "Security automation service account"@en ;
	.

ex:txn-wire
	a stonework:FinancialTransaction ;
	skos:prefLabel "Wire to the actor's mule account"@en ;
	stonework:attributedTo ex:org ;
	stonework:beneficiaryAccount ex:acct-mule ;
	stonework:categorizedBy stonework:transactionTypePayment ;
	stonework:hasMonetaryValue ex:amt-wire ;
	stonework:originatorAccount ex:acct-operating ;
	stonework:startedAtTime "2026-09-16T16:31:00Z"^^xsd:dateTime ;
	stonework:usesInstrument stonework:paymentInstrumentWireTransfer ;
	.

ex:var-bank-details-changed
	a stonework:Variable ;
	skos:definition "Whether the payee's bank details in this request differ from those on file."@en ;
	stonework:variableName "bankDetailsChanged" ;
	.

ex:var-callback-verified
	a stonework:Variable ;
	skos:definition "Whether the callback confirmed the new bank details."@en ;
	stonework:variableName "callbackVerified" ;
	.

ex:var-mailbox
	a stonework:Variable ;
	skos:definition "The mailbox account to search."@en ;
	stonework:variableName "mailbox" ;
	.

ex:var-payee-bank-details
	a stonework:Variable ;
	skos:definition "The payee's bank account as given in the payment request: an output of entering the invoice, and the input the callback checks."@en ;
	stonework:variableName "payeeBankDetails" ;
	.

ex:var-rule-found
	a stonework:Variable ;
	skos:definition "What the search found: a Sighting of T1114.003, or false."@en ;
	stonework:variableName "forwardingRuleFound" ;
	.

ex:wstep-approve
	a stonework:Step ;
	skos:definition "The controller approves the payment."@en ;
	skos:prefLabel "Approve the payment"@en ;
	stonework:isStepOf ex:bp-supplier-wire ;
	stonework:performerRole ex:role-controller ;
	stonework:stepOrder "3"^^xsd:integer ;
	.

ex:wstep-enter
	a stonework:Step ;
	skos:definition "The accounts-payable clerk enters the invoice and the payment request, noting whether the payee's bank details differ from those on file."@en ;
	skos:prefLabel "Enter the invoice and payment request"@en ;
	stonework:hasOutputVariable
		ex:var-bank-details-changed ,
		ex:var-payee-bank-details
		;
	stonework:isStepOf ex:bp-supplier-wire ;
	stonework:performerRole ex:role-ap-clerk ;
	stonework:separatedFrom ex:wstep-approve ;
	stonework:stepOrder "1"^^xsd:integer ;
	.

ex:wstep-release
	a stonework:Step ;
	skos:definition "The controller releases the wire in the bank's portal."@en ;
	skos:prefLabel "Release the wire"@en ;
	stonework:isStepOf ex:bp-supplier-wire ;
	stonework:performerRole ex:role-controller ;
	stonework:stepOrder "4"^^xsd:integer ;
	.

ex:wstep-verify
	a stonework:Step ;
	skos:definition "The accounts-payable clerk calls the supplier at the number on file and confirms the new bank details."@en ;
	skos:prefLabel "Verify changed bank details by callback"@en ;
	stonework:hasInputVariable ex:var-payee-bank-details ;
	stonework:hasOutputVariable ex:var-callback-verified ;
	stonework:implements ex:control-callback ;
	stonework:isStepOf ex:bp-supplier-wire ;
	stonework:performerRole ex:role-ap-clerk ;
	stonework:stepOrder "2"^^xsd:integer ;
	.

ex:wt-changed-to-verify
	a stonework:Transition ;
	stonework:fromStep ex:wstep-enter ;
	stonework:guardLiteralValue "true"^^xsd:boolean ;
	stonework:guardVariable ex:var-bank-details-changed ;
	stonework:toStep ex:wstep-verify ;
	.

ex:wt-unchanged-to-approve
	a stonework:Transition ;
	stonework:fromStep ex:wstep-enter ;
	stonework:guardLiteralValue "false"^^xsd:boolean ;
	stonework:guardVariable ex:var-bank-details-changed ;
	stonework:toStep ex:wstep-approve ;
	.

ex:wt-verified-to-approve
	a stonework:Transition ;
	stonework:fromStep ex:wstep-verify ;
	stonework:guardLiteralValue "true"^^xsd:boolean ;
	stonework:guardVariable ex:var-callback-verified ;
	stonework:toStep ex:wstep-approve ;
	.
