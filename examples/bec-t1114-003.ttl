ex:b-account-contain
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-account ;
	stonework:boundIn ex:exe-contain ;
	stonework:boundTo ex:acct-controller-mailbox ;
	.

ex:b-mailbox-clerk
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-mailbox ;
	stonework:boundIn ex:inv-bec ;
	stonework:boundTo ex:acct-ap-clerk-mailbox ;
	.

ex:b-mailbox-controller
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-mailbox ;
	stonework:boundIn ex:inv-bec ;
	stonework:boundTo ex:acct-controller-mailbox ;
	.

ex:b-outcome-clerk
	a stonework:VariableBinding ;
	skos:definition "The search of the clerk's mailbox ran to completion. It found nothing, but it worked."@en ;
	stonework:bindingOf ex:var-search-outcome ;
	stonework:boundIn ex:inv-search-clerk ;
	stonework:boundTo stonework:executionOutcomeSucceeded ;
	.

ex:b-outcome-controller
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-search-outcome ;
	stonework:boundIn ex:inv-search-controller ;
	stonework:boundTo stonework:executionOutcomeSucceeded ;
	.

ex:b-payment-request-0916
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-payment-request ;
	stonework:boundIn ex:act-send-request ;
	stonework:boundTo ex:email-bank-change ;
	.

ex:b-rule-clerk
	a stonework:VariableBinding ;
	skos:definition "The search of the clerk's mailbox found no forwarding rule."@en ;
	stonework:bindingOf ex:var-rule-found ;
	stonework:boundIn ex:inv-search-clerk ;
	stonework:boundToLiteral "false"^^xsd:boolean ;
	.

ex:b-rule-controller
	a stonework:VariableBinding ;
	skos:definition "The search of the controller's mailbox found the rule, recorded as a Sighting of T1114.003."@en ;
	stonework:bindingOf ex:var-rule-found ;
	stonework:boundIn ex:inv-search-controller ;
	stonework:boundTo ex:sighting-controller-rule ;
	.

ex:b0909-changed
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-bank-details-changed ;
	stonework:boundIn ex:exe0909-enter ;
	stonework:boundToLiteral "false"^^xsd:boolean ;
	.

ex:b0909-details
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-payee-bank-details ;
	stonework:boundIn ex:exe0909-enter ;
	stonework:boundTo ex:acct-supplier ;
	.

ex:b0916-changed
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-bank-details-changed ;
	stonework:boundIn ex:exe0916-enter ;
	stonework:boundToLiteral "true"^^xsd:boolean ;
	.

ex:b0916-details
	a stonework:VariableBinding ;
	skos:definition "The bank details the clerk entered from the actor's email: the mule account. The callback Step should have received this value; no execution in this run used it."@en ;
	stonework:bindingOf ex:var-payee-bank-details ;
	stonework:boundIn ex:exe0916-enter ;
	stonework:boundTo ex:acct-mule ;
	.

ex:b0930-changed
	a stonework:VariableBinding ;
	stonework:bindingOf ex:var-bank-details-changed ;
	stonework:boundIn ex:exe0930-enter ;
	stonework:boundToLiteral "true"^^xsd:boolean ;
	.

ex:b0930-details
	a stonework:VariableBinding ;
	skos:definition "The bank details in the actor's second request, for another invoice: the mule account again."@en ;
	stonework:bindingOf ex:var-payee-bank-details ;
	stonework:boundIn ex:exe0930-enter ;
	stonework:boundTo ex:acct-mule ;
	.

ex:b0930-verified
	a stonework:VariableBinding ;
	skos:definition "The callback, to the number on file, reached the real supplier, who had not changed banks."@en ;
	stonework:bindingOf ex:var-callback-verified ;
	stonework:boundIn ex:exe0930-verify ;
	stonework:boundToLiteral "false"^^xsd:boolean ;
	.

ex:bank-mule
	a stonework:FinancialInstitution ;
	skos:prefLabel "Mule's bank"@en ;
	stonework:categorizedBy stonework:financialInstitutionTypeCommercialBank ;
	.

ex:bank-org
	a stonework:FinancialInstitution ;
	skos:prefLabel "Manufacturer's bank"@en ;
	stonework:categorizedBy stonework:financialInstitutionTypeCommercialBank ;
	.

ex:bp-supplier-wire
	a stonework:BusinessProcess ;
	skos:definition "The organization's process for paying a supplier invoice by wire."@en ;
	skos:prefLabel "Supplier payment by wire"@en ;
	stonework:hasStep
		ex:wstep-approve ,
		ex:wstep-enter ,
		ex:wstep-release ,
		ex:wstep-verify
		;
	stonework:performedBy ex:org ;
	stonework:planVersion "3.2" ;
	.

ex:control-callback
	a stonework:Control ;
	skos:definition "Before any payment, a change to a payee's bank details is verified by telephone, at a number already on file and not one given in the request."@en ;
	skos:prefLabel "Out-of-band verification of payee bank-detail changes"@en ;
	stonework:controlId "FIN-07" ;
	.

ex:controller
	a stonework:Person ;
	skos:prefLabel "Example controller"@en ;
	stonework:hasRoleAssignment ex:ra-controller ;
	.

ex:cstep-block-external
	a stonework:Step ;
	skos:prefLabel "Block automatic forwarding to external domains at the transport layer"@en ;
	stonework:implements cti-enc:course-of-action--eb88d97c-32f1-40be-80f0-d61a4b0b4b31 ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:stepTarget ex:mail-tenant ;
	.

ex:cstep-remove-rule
	a stonework:Step ;
	skos:prefLabel "Disable and remove the forwarding rule, keeping a copy as evidence"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:splitKind stonework:flowKindParallel ;
	.

ex:cstep-reset
	a stonework:Step ;
	skos:prefLabel "Revoke the account's sessions and reset its credentials"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:stepTarget ex:var-account ;
	.

ex:cstep-review
	a stonework:Step ;
	skos:prefLabel "Review what was forwarded, and warn the suppliers and customers it exposed"@en ;
	stonework:isStepOf ex:ctlplan-forwarding ;
	stonework:joinKind stonework:flowKindParallel ;
	.

ex:ct-block-to-review
	a stonework:Transition ;
	stonework:fromStep ex:cstep-block-external ;
	stonework:toStep ex:cstep-review ;
	.

ex:ct-remove-to-block
	a stonework:Transition ;
	stonework:fromStep ex:cstep-remove-rule ;
	stonework:toStep ex:cstep-block-external ;
	.

ex:ct-remove-to-reset
	a stonework:Transition ;
	stonework:fromStep ex:cstep-remove-rule ;
	stonework:toStep ex:cstep-reset ;
	.

ex:ct-reset-to-review
	a stonework:Transition ;
	stonework:fromStep ex:cstep-reset ;
	stonework:toStep ex:cstep-review ;
	.

ex:ctl-actor-mailbox
	a stonework:IdentityControl ;
	skos:definition "The actor controlled the controller's mailbox account from the rule's creation, the earliest evidence, until the containment plan revoked its sessions and reset its credentials. The controller kept using it throughout."@en ;
	skos:prefLabel "The actor controlled the controller's mailbox account, 2 to 30 September"@en ;
	stonework:confidence "80"^^xsd:integer ;
	stonework:controlledIdentity ex:acct-controller-mailbox ;
	stonework:controllingAgent ex:actor ;
	stonework:evidencedBy
		ex:log-new-inboxrule ,
		ex:log-signins-controller
		;
	stonework:validFrom "2026-09-02T03:14:07Z"^^xsd:dateTime ;
	stonework:validUntil "2026-09-30T16:05:00Z"^^xsd:dateTime ;
	.

ex:ctlplan-forwarding
	a stonework:ControlPlan ;
	skos:definition "The organization's containment plan for a malicious email forwarding rule. It implements NIST SP 800-53 AC-4 (information flow enforcement), which the CTI Encyclopedia links to T1114.003. The rule is removed first, keeping a copy as evidence; the credential reset and the transport block are independent and run in parallel; the review waits for both."@en ;
	skos:prefLabel "Contain a malicious forwarding rule"@en ;
	stonework:hasInputVariable ex:var-account ;
	stonework:hasPlaybookType stonework:playbookTypeMitigation ;
	stonework:hasStep
		ex:cstep-block-external ,
		ex:cstep-remove-rule ,
		ex:cstep-reset ,
		ex:cstep-review
		;
	stonework:implements cti-enc:_Control_nist-ac-4 ;
	.

ex:detplan-forwarding
	a stonework:DetectionPlan ;
	skos:definition "Looks for email forwarding rules on the finance team's mailboxes, following ATT&CK's detection strategy DET0576, and hands a confirmed rule to the containment plan."@en ;
	skos:prefLabel "Detect forwarding rules on finance mailboxes"@en ;
	stonework:hasPlaybookType stonework:playbookTypeDetection ;
	stonework:hasStep
		ex:dstep-contain ,
		ex:dstep-escalate ,
		ex:dstep-record ,
		ex:dstep-search
		;
	stonework:implements cti-enc:x-mitre-detection-strategy--f66a9e86-49fb-4de6-963d-0e357a77f679 ;
	.

ex:dev-0916-callback
	a stonework:Deviation ;
	skos:definition "In the 16 September run, the callback the plan required was not made. The run has no execution of the Step; the clerk's statement and the call records establish that it wasn't done, not merely that it wasn't recorded."@en ;
	skos:prefLabel "Deviation: the callback was skipped (16 September)"@en ;
	stonework:deviationKind stonework:deviationKindSkipped ;
	stonework:deviationRun ex:run-wire-0916 ;
	stonework:deviationStep ex:wstep-verify ;
	stonework:evidencedBy
		ex:file-clerk-statement ,
		ex:log-calls-0916
		;
	.

ex:dom-lookalike
	a stonework:Domain ;
	skos:definition "A lookalike of the supplier's domain, with a digit 1 in place of the letter l, registered by the actor two weeks before the bank-change email. It passes SPF, DKIM and DMARC for itself."@en ;
	skos:prefLabel "Lookalike supplier domain"@en ;
	stonework:domainName "supp1ier.example" ;
	stonework:registrationDate "2026-09-01T09:12:00Z"^^xsd:dateTime ;
	.

ex:dstep-contain
	a stonework:Step ;
	skos:definition "Run the containment plan for the mailbox where a rule was found."@en ;
	skos:prefLabel "Contain the mailbox"@en ;
	stonework:implements ex:ctlplan-forwarding ;
	stonework:isStepOf ex:detplan-forwarding ;
	.

ex:dstep-escalate
	a stonework:Step ;
	skos:definition "If the audit log can't be searched (the search failed or timed out), ask the mail administrator to export the mailbox's rules directly."@en ;
	skos:prefLabel "Escalate to the mail administrator"@en ;
	stonework:isStepOf ex:detplan-forwarding ;
	.

ex:dstep-record
	a stonework:Step ;
	skos:definition "Record that the search found no forwarding rule on the mailbox, keeping the saved query and its empty result."@en ;
	skos:prefLabel "Record a negative result"@en ;
	stonework:isStepOf ex:detplan-forwarding ;
	.

ex:dstep-search
	a stonework:Step ;
	skos:definition "Search the audit log for New-InboxRule and Set-InboxRule operations on the given mailbox that set ForwardTo, ForwardAsAttachmentTo or RedirectTo, over the last 90 days (ATT&CK analytic AN1591). Run once for each mailbox in question."@en ;
	skos:prefLabel "Search the audit log for forwarding rules on a mailbox"@en ;
	stonework:defaultTransition ex:dt-default-to-record ;
	stonework:hasInputVariable ex:var-mailbox ;
	stonework:hasOutputVariable ex:var-rule-found ;
	stonework:implements cti-enc:x-mitre-analytic--710aa303-3e9f-4170-95a4-b2caf5f827fd ;
	stonework:isStepOf ex:detplan-forwarding ;
	stonework:outcomeVariable ex:var-search-outcome ;
	.

ex:dt-default-to-record
	a stonework:Transition ;
	skos:definition "Taken when neither of the search Step's guarded Transitions is: the search worked and found no rule."@en ;
	stonework:fromStep ex:dstep-search ;
	stonework:toStep ex:dstep-record ;
	.

ex:dt-failed-to-escalate
	a stonework:Transition ;
	stonework:fromStep ex:dstep-search ;
	stonework:guardValue stonework:executionOutcomeFailed ;
	stonework:guardVariable ex:var-search-outcome ;
	stonework:toStep ex:dstep-escalate ;
	.

ex:dt-found-to-contain
	a stonework:Transition ;
	stonework:fromStep ex:dstep-search ;
	stonework:guardType stonework:Sighting ;
	stonework:guardVariable ex:var-rule-found ;
	stonework:toStep ex:dstep-contain ;
	.

ex:email-bank-change
	a stonework:EmailMessage ;
	skos:definition "Sent from the lookalike supplier address in reply to a genuine invoice thread the actor had read through the forwarding rule. It says the supplier has changed banks and gives new account details for the outstanding invoice."@en ;
	skos:prefLabel 'Email: "Updated remittance details"'@en ;
	stonework:emailSubject "RE: Invoice 44871 - updated remittance details" ;
	stonework:fromDisplayName "Supplier Accounts" ;
	stonework:hasAuthenticationResult
		ex:auth-dkim-bank-change ,
		ex:auth-dmarc-bank-change ,
		ex:auth-spf-bank-change
		;
	stonework:hasFromAddress ex:addr-lookalike ;
	stonework:hasReplyToAddress ex:addr-lookalike ;
	stonework:hasReturnPathAddress ex:addr-lookalike ;
	stonework:hasToAddress ex:addr-ap-clerk ;
	stonework:inReplyTo ex:email-invoice-44871 ;
	stonework:messageId "<CAF4x9qQ7r.20260915220700@mail.supp1ier.example>" ;
	stonework:referencesMessage ex:email-invoice-44871 ;
	stonework:sentAtTime "2026-09-15T22:07:00Z"^^xsd:dateTime ;
	.

ex:email-invoice-44871
	a stonework:EmailMessage ;
	skos:definition "The supplier's genuine invoice for the September delivery, sent to accounts payable with the controller copied. The forwarding rule on the controller's mailbox sent a copy to the actor."@en ;
	skos:prefLabel 'Email: "Invoice 44871"'@en ;
	stonework:emailSubject "Invoice 44871" ;
	stonework:fromDisplayName "Supplier Accounts" ;
	stonework:hasCcAddress ex:addr-controller ;
	stonework:hasFromAddress ex:addr-supplier ;
	stonework:hasToAddress ex:addr-ap-clerk ;
	stonework:messageId "<20260910151204.44871@mail.supplier.example>" ;
	stonework:sentAtTime "2026-09-10T15:12:04Z"^^xsd:dateTime ;
	.

