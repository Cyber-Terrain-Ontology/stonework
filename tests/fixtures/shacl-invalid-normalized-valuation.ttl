@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:amount
	a stonework:MonetaryAmount ;
	stonework:amount "1.0"^^xsd:decimal ;
	stonework:currency stonework:currencyUSD ;
	.

example:valuation
	a stonework:MetricObservation ;
	stonework:metricFor example:amount ;
	stonework:metricType stonework:metricNormalizedValue ;
	stonework:metricValue "65000.00"^^xsd:decimal ;
	stonework:observedAt "2026-05-04T09:41:00Z"^^xsd:dateTime ;
	.
