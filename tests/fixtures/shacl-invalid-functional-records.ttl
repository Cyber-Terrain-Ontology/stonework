@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:componentContext
	a stonework:ProductInstallation ;
	stonework:installationOf
		example:firstProduct ,
		example:secondProduct
		;
	stonework:installedOn
		example:firstInfrastructure ,
		example:secondInfrastructure
		;
	.

example:deviation
	a stonework:Deviation ;
	stonework:deviationKind
		stonework:deviationKindSameAgent ,
		stonework:deviationKindSkipped
		;
	stonework:deviationRun
		example:firstInvestigation ,
		example:secondInvestigation
		;
	stonework:deviationStep example:firstStep ;
	.

example:doubledAuthResult
	a stonework:EmailAuthenticationResult ;
	stonework:authenticatedBy
		example:firstServer ,
		example:secondServer
		;
	stonework:authenticatedDomain
		example:firstDomain ,
		example:secondDomain
		;
	stonework:hasAuthenticationMethod
		stonework:authenticationMethodDKIM ,
		stonework:authenticationMethodSPF
		;
	stonework:hasAuthenticationVerdict
		stonework:authenticationVerdictFail ,
		stonework:authenticationVerdictPass
		;
	.

example:doubledIdentityControl
	a stonework:IdentityControl ;
	stonework:controlledIdentity
		example:firstAccount ,
		example:secondAccount
		;
	stonework:controllingAgent
		example:firstAgent ,
		example:secondAgent
		;
	.

example:doubledMailboxRule
	a stonework:MailboxRule ;
	stonework:deletesMessage
		"false"^^xsd:boolean ,
		"true"^^xsd:boolean
		;
	stonework:hiddenFromUser
		"false"^^xsd:boolean ,
		"true"^^xsd:boolean
		;
	stonework:marksAsRead
		"false"^^xsd:boolean ,
		"true"^^xsd:boolean
		;
	stonework:movesToFolder
		"Archive" ,
		"RSS Feeds"
		;
	stonework:ruleEnabled
		"false"^^xsd:boolean ,
		"true"^^xsd:boolean
		;
	stonework:ruleOfMailbox
		example:firstAccount ,
		example:secondAccount
		;
	.

example:doubledMessage
	a stonework:EmailMessage ;
	stonework:emailSubject
		"First subject" ,
		"Second subject"
		;
	stonework:fromDisplayName
		"First name" ,
		"Second name"
		;
	stonework:hasFromAddress
		example:firstEmailAddress ,
		example:secondEmailAddress
		;
	stonework:hasReturnPathAddress
		example:firstEmailAddress ,
		example:secondEmailAddress
		;
	stonework:hasSenderAddress
		example:firstEmailAddress ,
		example:secondEmailAddress
		;
	stonework:messageId
		"<first@example.org>" ,
		"<second@example.org>"
		;
	stonework:sentAtTime
		"2026-09-15T22:07:00Z"^^xsd:dateTime ,
		"2026-09-15T22:08:00Z"^^xsd:dateTime
		;
	.

example:firstAccount
	a stonework:UserAccount ;
	.

example:firstAgent
	a stonework:ThreatActor ;
	.

example:firstAnalyst
	a stonework:Person ;
	.

example:firstDomain
	a stonework:Domain ;
	.

example:firstEmailAddress
	a stonework:EmailAddress ;
	.

example:firstInfrastructure
	a stonework:Infrastructure ;
	.

example:firstInvestigation
	a stonework:Investigation ;
	.

example:firstProduct
	a stonework:VersionedProduct ;
	stonework:versionOf
		example:firstProductFamily ,
		example:secondProductFamily
		;
	.

example:firstProductFamily
	a stonework:Product ;
	.

example:firstServer
	a stonework:Host ;
	.

example:firstStep
	a stonework:Step ;
	stonework:defaultTransition
		example:otherTransition ,
		example:transition
		;
	stonework:joinKind
		stonework:flowKindExclusive ,
		stonework:flowKindParallel
		;
	stonework:outcomeVariable
		example:firstVariable ,
		example:secondVariable
		;
	stonework:splitKind
		stonework:flowKindExclusive ,
		stonework:flowKindParallel
		;
	.

example:firstVariable
	a stonework:Variable ;
	.

example:hypothesis
	a stonework:Hypothesis ;
	stonework:predictedLiteral
		"first" ,
		"second"
		;
	stonework:predictedType
		stonework:Impact ,
		stonework:Risk
		;
	stonework:predictedValue
		example:firstSubject ,
		example:secondSubject
		;
	stonework:predictsVariable
		example:firstVariable ,
		example:secondVariable
		;
	.

example:investigation
	a stonework:Investigation ;
	stonework:hasInvestigationOutcome
		stonework:investigationOutcomeBenign ,
		stonework:investigationOutcomeConfirmed
		;
	stonework:hasInvestigationStatus
		stonework:investigationStatusActive ,
		stonework:investigationStatusClosed
		;
	stonework:hasPriority
		stonework:priorityHigh ,
		stonework:priorityLow
		;
	stonework:leadInvestigator
		example:firstAnalyst ,
		example:secondAnalyst
		;
	stonework:mergedInto
		example:firstInvestigation ,
		example:secondInvestigation
		;
	.

example:otherTransition
	a stonework:Transition ;
	stonework:fromStep example:firstStep ;
	stonework:guardValue
		stonework:executionOutcomeFailed ,
		stonework:executionOutcomeSucceeded
		;
	stonework:toStep example:secondStep ;
	.

example:relationship
	a stonework:QualifiedAssertion ;
	stonework:assertionObject
		example:firstSubject ,
		example:secondSubject
		;
	stonework:assertionRelationType
		"first" ,
		"second"
		;
	stonework:assertionSubject
		example:firstSubject ,
		example:secondSubject
		;
	.

example:secondAccount
	a stonework:UserAccount ;
	.

example:secondAgent
	a stonework:ThreatActor ;
	.

example:secondAnalyst
	a stonework:Person ;
	.

example:secondDomain
	a stonework:Domain ;
	.

example:secondEmailAddress
	a stonework:EmailAddress ;
	.

example:secondInfrastructure
	a stonework:Infrastructure ;
	.

example:secondInvestigation
	a stonework:Investigation ;
	.

example:secondProduct
	a stonework:VersionedProduct ;
	.

example:secondProductFamily
	a stonework:Product ;
	.

example:secondServer
	a stonework:Host ;
	.

example:secondStep
	a stonework:Step ;
	.

example:secondVariable
	a stonework:Variable ;
	.

example:sighting
	a stonework:Sighting ;
	stonework:sightedObject
		example:firstSubject ,
		example:secondSubject
		;
	.

example:stepExecution
	a stonework:Process ;
	stonework:partOfExecution
		example:firstInvestigation ,
		example:secondInvestigation
		;
	.

example:transition
	a stonework:Transition ;
	stonework:fromStep
		example:firstStep ,
		example:secondStep
		;
	stonework:guardLiteralValue
		"first" ,
		"second"
		;
	stonework:guardOperator
		stonework:Equals ,
		stonework:NotEquals
		;
	stonework:guardType
		stonework:Impact ,
		stonework:Risk
		;
	stonework:guardVariable
		example:firstVariable ,
		example:secondVariable
		;
	stonework:toStep
		example:firstStep ,
		example:secondStep
		;
	.

example:twoMaturities
	a stonework:Vulnerability ;
	stonework:hasExploitMaturity
		stonework:exploitMaturityPoc ,
		stonework:exploitMaturityWeaponized
		;
	.

example:twoReportKinds
	a stonework:MetricObservation ;
	stonework:hasExploitationReportKind
		stonework:exploitationReportBotnet ,
		stonework:exploitationReportRansomware
		;
	stonework:metricValue "true"^^xsd:boolean ;
	stonework:observedAt "2026-08-20T12:00:00Z"^^xsd:dateTime ;
	.

example:variableBinding
	a stonework:VariableBinding ;
	stonework:bindingOf
		example:firstVariable ,
		example:secondVariable
		;
	stonework:boundIn
		example:firstInvestigation ,
		example:secondInvestigation
		;
	stonework:boundTo
		example:firstSubject ,
		example:secondSubject
		;
	stonework:boundToLiteral
		"first" ,
		"second"
		;
	.
