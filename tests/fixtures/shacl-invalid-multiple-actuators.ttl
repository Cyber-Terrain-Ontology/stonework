@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .

example:actuationWithMultipleActuators
	a stonework:SecurityActuation ;
	stonework:actsOn example:protectedHost ;
	stonework:madeByActuator
		example:firstActuator ,
		example:secondActuator
		;
	.

example:firstActuator
	a stonework:SecurityActuator ;
	.

example:protectedHost
	a stonework:Host ;
	.

example:secondActuator
	a stonework:SecurityActuator ;
	.
