@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:analyst
	a stonework:Person ;
	.

example:review
	a stonework:Review ;
	stonework:endedAtTime "2026-08-21T15:20:00Z"^^xsd:dateTime ;
	stonework:hasReviewFinding example:analyst ;
	stonework:performedBy example:analyst ;
	.
