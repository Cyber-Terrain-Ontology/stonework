@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:boundsReversed
	a stonework:Process ;
	stonework:startedNotAfter "2026-09-30T09:05:00Z"^^xsd:dateTime ;
	stonework:startedNotBefore "2026-09-30T09:52:00Z"^^xsd:dateTime ;
	.

example:startOutsideBounds
	a stonework:Process ;
	stonework:startedAtTime "2026-09-30T10:00:00Z"^^xsd:dateTime ;
	stonework:startedNotAfter "2026-09-30T09:52:00Z"^^xsd:dateTime ;
	stonework:startedNotBefore "2026-09-30T09:05:00Z"^^xsd:dateTime ;
	.
