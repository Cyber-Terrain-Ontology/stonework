@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:account
	a stonework:UserAccount ;
	.

example:activity
	a stonework:CyberActivity ;
	stonework:endedAtTime "2026-08-20T10:05:00Z"^^xsd:dateTime ;
	stonework:startedAtTime "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	.

example:activityHypothesis
	a stonework:Hypothesis ;
	stonework:hypothesisAbout example:indicator ;
	.

example:actor
	a stonework:ThreatActor ;
	stonework:hasRoleAssignment example:sponsorAssignment ;
	.

example:actorControl
	a stonework:IdentityControl ;
	stonework:controlledIdentity example:account ;
	stonework:controllingAgent example:actor ;
	stonework:hasProvenance example:roleSource ;
	stonework:validFrom "2026-09-02T03:14:07Z"^^xsd:dateTime ;
	stonework:validUntil "2026-09-30T16:05:00Z"^^xsd:dateTime ;
	.

example:address
	a stonework:IPAddress ;
	stonework:ipVersion "4"^^xsd:integer ;
	.

example:analyst
	a stonework:Person ;
	.

example:analystOpinion
	a stonework:Opinion ;
	stonework:opinionOf example:proposedLink ;
	.

example:boundEntity
	a stonework:CyberEntity ;
	.

example:bulletinTechnique
	a stonework:AttackPattern ;
	stonework:refersTo example:canonicalTechnique ;
	.

example:campaign
	a stonework:Campaign ;
	.

example:canonicalTechnique
	a stonework:AttackTechnique ;
	.

example:certificate
	a stonework:Certificate ;
	stonework:certValidNotAfter "2027-01-01T00:00:00Z"^^xsd:dateTime ;
	stonework:certValidNotBefore "2026-01-01T00:00:00Z"^^xsd:dateTime ;
	.

example:componentContext
	a stonework:ComponentContext ;
	stonework:installationOf
		example:secondVersionedProduct ,
		example:versionedProduct
		;
	.

example:compoundHypothesis
	a stonework:Hypothesis ;
	stonework:hypothesisAbout example:actor ;
	stonework:hypothesisPart example:activityHypothesis ;
	.

example:deviation
	a stonework:Deviation ;
	stonework:deviationExecution example:stepExecution ;
	stonework:deviationKind stonework:deviationKindWrongRole ;
	stonework:deviationRun example:investigation ;
	stonework:deviationStep example:targetStep ;
	stonework:evidencedBy example:statement ;
	stonework:hasProvenance example:roleSource ;
	.

example:domain
	a stonework:Domain ;
	stonework:registrationDate "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	.

example:edrActuator
	a stonework:SecurityActuator ;
	stonework:implementsCountermeasure example:isolationControl ;
	.

example:epssFeed
	a stonework:Feed ;
	.

example:epssObservation
	a stonework:MetricObservation ;
	stonework:hasProvenance example:epssFeed ;
	stonework:metricFor example:vulnerability ;
	stonework:metricType stonework:metricEpssScore ;
	stonework:metricValue "0.42"^^xsd:decimal ;
	stonework:modelVersion "2026.1" ;
	stonework:observedAt "2026-08-20T12:00:00Z"^^xsd:dateTime ;
	.

example:guardedTransition
	a stonework:Transition ;
	stonework:fromStep example:sourceStep ;
	stonework:guardValue stonework:executionOutcomeFailed ;
	stonework:guardVariable example:variable ;
	stonework:toStep example:targetStep ;
	.

example:hash
	a stonework:Hash ;
	stonework:hashAlgorithm "SHA-256" ;
	stonework:hashValue "dffd6021bb2bd33e0f47df5fcfe00d61010a3f9a8a70d1fc8ad2e72f15f5f65f" ;
	.

example:hypothesis
	a stonework:Hypothesis ;
	stonework:predictedType stonework:SecurityCondition ;
	stonework:predictsVariable example:variable ;
	.

example:indicator
	a stonework:Indicator ;
	stonework:confidence "85"^^xsd:integer ;
	.

example:investigation
	a stonework:Investigation ;
	stonework:endedAtTime "2026-08-22T17:00:00Z"^^xsd:dateTime ;
	stonework:examines example:threatBulletin ;
	stonework:hasInvestigationOutcome stonework:investigationOutcomeConfirmed ;
	stonework:hasInvestigationStatus stonework:investigationStatusClosed ;
	stonework:hasPriority stonework:priorityHigh ;
	stonework:investigates example:campaign ;
	stonework:leadInvestigator example:analyst ;
	stonework:performedBy
		example:analyst ,
		example:secondAnalyst
		;
	stonework:startedAtTime "2026-08-20T09:00:00Z"^^xsd:dateTime ;
	stonework:testsHypothesis
		example:hypothesis ,
		example:openHypothesis
		;
	.

example:isolationActuation
	a stonework:SecurityActuation ;
	stonework:actsOn example:protectedHost ;
	stonework:appliesCountermeasure example:isolationControl ;
	stonework:madeByActuator example:edrActuator ;
	.

example:isolationControl
	a stonework:DetectionRule ;
	.

example:laterStepExecution
	a stonework:Process ;
	stonework:partOfExecution example:investigation ;
	stonework:usedBinding example:variableBinding ;
	.

example:likelihood
	a stonework:Likelihood ;
	stonework:likelihoodScore "0.6"^^xsd:decimal ;
	.

example:linkingRun
	a stonework:Provenance ;
	stonework:description "Matched by the technique ID in the bulletin object's name."@en ;
	.

example:location
	a stonework:Location ;
	stonework:latitude "40.7128"^^xsd:decimal ;
	stonework:longitude "-74.0060"^^xsd:decimal ;
	.

example:mergedInvestigation
	a stonework:Investigation ;
	stonework:hasInvestigationStatus stonework:investigationStatusClosed ;
	stonework:mergedInto example:investigation ;
	.

example:observation
	a stonework:SecurityObservation ;
	stonework:firstSeen "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	stonework:lastSeen "2026-08-20T11:00:00Z"^^xsd:dateTime ;
	.

example:openHypothesis
	a stonework:Hypothesis ;
	stonework:confidence "60"^^xsd:integer ;
	stonework:description "The intrusion set behind the campaign is APT28."@en ;
	stonework:hasHypothesisStatus stonework:hypothesisStatusPending ;
	.

example:playbook
	a stonework:Playbook ;
	stonework:hasPlaybookType stonework:playbookTypeDetection ;
	.

example:product
	a stonework:Product ;
	.

example:productInstallation
	a stonework:ProductInstallation ;
	stonework:installationOf example:versionedProduct ;
	stonework:installedOn example:protectedHost ;
	.

example:proposedLink
	a stonework:QualifiedAssertion ;
	stonework:assertionObject example:canonicalTechnique ;
	stonework:assertionRelationType "refers-to" ;
	stonework:assertionSubject example:bulletinTechnique ;
	stonework:confidence "60"^^xsd:integer ;
	stonework:hasProvenance example:linkingRun ;
	.

example:protectedHost
	a stonework:Host ;
	.

example:ransomwareFamily
	a stonework:MalwareFamily ;
	.

example:ransomwareReportObservation
	a stonework:MetricObservation ;
	stonework:assertionObject example:ransomwareFamily ;
	stonework:hasExploitationReportKind stonework:exploitationReportRansomware ;
	stonework:hasProvenance example:epssFeed ;
	stonework:metricFor example:vulnerability ;
	stonework:metricType stonework:metricReportedExploited ;
	stonework:metricValue "true"^^xsd:boolean ;
	stonework:observedAt "2026-08-20T12:00:00Z"^^xsd:dateTime ;
	.

example:roleSource
	a stonework:Publication ;
	.

example:secondAnalyst
	a stonework:Person ;
	.

example:secondVersionedProduct
	a stonework:VersionedProduct ;
	stonework:versionOf example:product ;
	.

example:service
	a stonework:NetworkService ;
	stonework:port "443"^^xsd:unsignedShort ;
	.

example:sighting
	a stonework:Sighting ;
	stonework:sightedObject example:indicator ;
	.

example:sourceStep
	a stonework:Step ;
	stonework:defaultTransition example:transition ;
	stonework:outcomeVariable example:variable ;
	stonework:separatedFrom example:targetStep ;
	stonework:splitKind stonework:flowKindParallel ;
	.

example:sponsorAssignment
	a stonework:RoleAssignment ;
	stonework:assignedRole stonework:threatActorRoleSponsor ;
	stonework:hasProvenance example:roleSource ;
	stonework:roleContext example:campaign ;
	stonework:rolePlayer example:actor ;
	stonework:validFrom "2026-01-01T00:00:00Z"^^xsd:dateTime ;
	stonework:validUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
	.

example:statement
	a stonework:File ;
	.

example:stepExecution
	a stonework:Process ;
	stonework:partOfExecution example:investigation ;
	.

example:stepRole
	a stonework:Role ;
	.

example:targetStep
	a stonework:Step ;
	stonework:joinKind stonework:flowKindParallel ;
	stonework:performerRole example:stepRole ;
	stonework:stepTarget example:variable ;
	.

example:threatBulletin
	a stonework:Report ;
	.

example:transition
	a stonework:Transition ;
	stonework:fromStep example:sourceStep ;
	stonework:toStep example:targetStep ;
	.

example:variable
	a stonework:Variable ;
	stonework:suppliedBy example:stepRole ;
	.

example:variableBinding
	a stonework:VariableBinding ;
	stonework:bindingOf example:variable ;
	stonework:boundIn example:stepExecution ;
	stonework:boundTo example:boundEntity ;
	.

example:versionedProduct
	a stonework:VersionedProduct ;
	stonework:versionOf example:product ;
	.

example:vulnerability
	a stonework:Vulnerability ;
	stonework:cvssBaseScore "9.8"^^xsd:decimal ;
	stonework:epssPercentile "0.97"^^xsd:decimal ;
	stonework:epssScore "0.42"^^xsd:decimal ;
	stonework:hasExploitMaturity stonework:exploitMaturityWeaponized ;
	stonework:isKnownExploited "true"^^xsd:boolean ;
	.
