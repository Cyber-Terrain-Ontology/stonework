@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:activity
	a stonework:CyberActivity ;
	stonework:endedAtTime "2026-08-20T10:05:00Z"^^xsd:dateTime ;
	stonework:startedAtTime "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	.

example:actor
	a stonework:ThreatActor ;
	stonework:hasRoleAssignment example:sponsorAssignment ;
	.

example:address
	a stonework:IPAddress ;
	stonework:ipVersion "4"^^xsd:integer ;
	.

example:boundEntity
	a stonework:CyberEntity ;
	.

example:campaign
	a stonework:Campaign ;
	.

example:certificate
	a stonework:Certificate ;
	stonework:certValidNotAfter "2027-01-01T00:00:00Z"^^xsd:dateTime ;
	stonework:certValidNotBefore "2026-01-01T00:00:00Z"^^xsd:dateTime ;
	.

example:componentContext
	a stonework:ComponentContext ;
	stonework:installationOf
		example:secondVersionedProduct ,
		example:versionedProduct
		;
	.

example:domain
	a stonework:Domain ;
	stonework:registrationDate "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	.

example:edrActuator
	a stonework:SecurityActuator ;
	stonework:implementsCountermeasure example:isolationControl ;
	.

example:epssFeed
	a stonework:Feed ;
	.

example:epssObservation
	a stonework:MetricObservation ;
	stonework:hasProvenance example:epssFeed ;
	stonework:metricFor example:vulnerability ;
	stonework:metricType stonework:metricEpssScore ;
	stonework:metricValue "0.42"^^xsd:decimal ;
	stonework:modelVersion "2026.1" ;
	stonework:observedAt "2026-08-20T12:00:00Z"^^xsd:dateTime ;
	.

example:hash
	a stonework:Hash ;
	stonework:hashAlgorithm "SHA-256" ;
	stonework:hashValue "dffd6021bb2bd33e0f47df5fcfe00d61010a3f9a8a70d1fc8ad2e72f15f5f65f" ;
	.

example:hypothesis
	a stonework:Hypothesis ;
	stonework:predictedType stonework:SecurityCondition ;
	stonework:predictsVariable example:variable ;
	.

example:indicator
	a stonework:Indicator ;
	stonework:confidence "85"^^xsd:integer ;
	.

example:isolationActuation
	a stonework:SecurityActuation ;
	stonework:actsOn example:protectedHost ;
	stonework:appliesCountermeasure example:isolationControl ;
	stonework:madeByActuator example:edrActuator ;
	.

example:isolationControl
	a stonework:DetectionRule ;
	.

example:likelihood
	a stonework:Likelihood ;
	stonework:likelihoodScore "0.6"^^xsd:decimal ;
	.

example:location
	a stonework:Location ;
	stonework:latitude "40.7128"^^xsd:decimal ;
	stonework:longitude "-74.0060"^^xsd:decimal ;
	.

example:observation
	a stonework:SecurityObservation ;
	stonework:firstSeen "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	stonework:lastSeen "2026-08-20T11:00:00Z"^^xsd:dateTime ;
	.

example:product
	a stonework:Product ;
	.

example:productInstallation
	a stonework:ProductInstallation ;
	stonework:installationOf example:versionedProduct ;
	stonework:installedOn example:protectedHost ;
	.

example:protectedHost
	a stonework:Host ;
	.

example:roleSource
	a stonework:Publication ;
	.

example:secondVersionedProduct
	a stonework:VersionedProduct ;
	stonework:versionOf example:product ;
	.

example:service
	a stonework:NetworkService ;
	stonework:port "443"^^xsd:unsignedShort ;
	.

example:sighting
	a stonework:Sighting ;
	stonework:sightedObject example:indicator ;
	.

example:sourceStep
	a stonework:Step ;
	.

example:sponsorAssignment
	a stonework:RoleAssignment ;
	stonework:assignedRole stonework:threatActorRoleSponsor ;
	stonework:hasProvenance example:roleSource ;
	stonework:roleContext example:campaign ;
	stonework:rolePlayer example:actor ;
	stonework:validFrom "2026-01-01T00:00:00Z"^^xsd:dateTime ;
	stonework:validUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
	.

example:targetStep
	a stonework:Step ;
	.

example:transition
	a stonework:Transition ;
	stonework:fromStep example:sourceStep ;
	stonework:toStep example:targetStep ;
	.

example:variable
	a stonework:Variable ;
	stonework:boundTo example:boundEntity ;
	.

example:versionedProduct
	a stonework:VersionedProduct ;
	stonework:versionOf example:product ;
	.

example:vulnerability
	a stonework:Vulnerability ;
	stonework:cvssBaseScore "9.8"^^xsd:decimal ;
	stonework:epssScore "0.42"^^xsd:decimal ;
	stonework:isKnownExploited "true"^^xsd:boolean ;
	.
