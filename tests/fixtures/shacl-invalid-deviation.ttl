@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:clerk
	a stonework:Person ;
	.

example:deviation
	a stonework:Deviation ;
	stonework:evidencedBy example:clerk ;
	.

example:enterStep
	a stonework:Step ;
	stonework:joinKind example:variable ;
	stonework:performerRole example:clerk ;
	stonework:separatedFrom example:variable ;
	stonework:splitKind example:clerk ;
	.

example:variable
	a stonework:Variable ;
	stonework:suppliedBy example:clerk ;
	.
