@prefix example: <https://example.org/> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:indicator
	a stonework:Indicator ;
	stonework:confidence 101 ;
	.

example:vulnerability
	a stonework:Vulnerability ;
	stonework:cvssBaseScore -1.0 ;
	stonework:epssScore 1.2 ;
	.

example:location
	a stonework:Location ;
	stonework:latitude 91.0 ;
	stonework:longitude -181.0 ;
	.

example:observation
	a stonework:SecurityObservation ;
	stonework:firstSeen "2026-08-20T12:00:00Z"^^xsd:dateTime ;
	stonework:lastSeen "2026-08-20T11:00:00Z"^^xsd:dateTime ;
	.

example:certificate
	a stonework:Certificate ;
	stonework:certValidNotBefore "2027-01-01T00:00:00Z"^^xsd:dateTime ;
	stonework:certValidNotAfter "2026-01-01T00:00:00Z"^^xsd:dateTime ;
	.

example:activity
	a stonework:CyberActivity ;
	stonework:startedAtTime "2026-08-20T11:00:00Z"^^xsd:dateTime ;
	stonework:endedAtTime "2026-08-20T10:00:00Z"^^xsd:dateTime ;
	.

example:service
	a stonework:NetworkService ;
	stonework:port 70000 ;
	.

example:address
	a stonework:IPAddress ;
	stonework:ipVersion 5 ;
	.

example:hash
	a stonework:Hash ;
	stonework:hashAlgorithm "SHA-256" ;
	.

example:domain
	a stonework:Domain ;
	stonework:registrationDate "2026-08-20"^^xsd:date ;
	.

example:incompleteMetric
	a stonework:MetricObservation ;
	stonework:metricValue 0.5 ;
	.

example:incompleteRoleAssignment
	a stonework:RoleAssignment ;
	stonework:assignedRole stonework:threatActorRoleSponsor ;
	.
