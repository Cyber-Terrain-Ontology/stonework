@prefix example: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stonework: <https://cyberterrain.org/ns/stonework#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

example:ExternalRelationship
	a owl:Class ;
	rdfs:subClassOf stonework:QualifiedAssertion ;
	.

example:relationship
	a example:ExternalRelationship ;
	stonework:validFrom "2026-08-24T00:00:00Z"^^xsd:dateTime ;
	.
